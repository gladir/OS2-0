REM CONFIG.SYS de OS/2-0 (CD-ROM amorcable)
PROTSHELL=C:\PMSHELL.EXE
LIBPATH=C:\;
IFS=C:\HPFS.IFS /CACHE:32 /AUTOCHECK:D /RAMDISK:4096
SET COMSPEC=C:\CMD.EXE
SET PATH=C:\;
SET LANGUAGE=FR
SET HELP=D:\AIDE;
SET OS2_SHELL=C:\CMD.EXE
SET RUNWORKPLACE=C:\PMSHELL.EXE
REM Son : SET AUDIODRIVER=SBAUDIO, ICHAUDIO, ESAUDIO ou NONE (sans elle : detection)
REM SET BLASTER=A220 I5 D1 H5 T6
