Procedure MenuInit(M : LongInt);
Begin
 If M = 901 Then MnAttr(100 + CMD_PLAY, MIA_CHECKED, Running);
 If M = 902 Then Begin
  MnAttr(100 + CMD_ORBIT, MIA_CHECKED, ShowOrbite);
  MnAttr(100 + CMD_NAME, MIA_CHECKED, ShowName);
  MnAttr(100 + CMD_BELT, MIA_CHECKED, ShowBelt);
  MnAttr(100 + CMD_STARS, MIA_CHECKED, ShowStars);
  MnAttr(100 + CMD_INNER, MIA_CHECKED, Abs(Zoom - 1.0) < 0.01);
  MnAttr(100 + CMD_FULL, MIA_CHECKED, Abs(Zoom - 0.42) < 0.01);
 End;
End;

Procedure ShowBodies;
Var S : String;
Begin
 S := 'Plan'#138'tes (distance au Soleil, vitesse relative) : Mercure, V'#130'nus, Terre (et la Lune), '+
      'Mars (Phobos, Deimos), Jupiter, Saturne et Uranus (anneaux), Neptune. '+
      'Ast'#130'ro'#139'des : C'#130'r'#138's et Pallas (ceinture entre Mars et Jupiter). '+
      'Com'#138'te : Encke (orbite elliptique). Cliquez sur un astre pour le choisir.';
 Dummy := PmBox('Simulateur de plan'#138'te', S, MB_OK Or MB_INFORMATION);
End;

Procedure DoCmd(C : Integer);
Begin
 Case C Of
  CMD_PLAY : Running := Not Running;
  CMD_RESTART : Tm := 0;
  CMD_FASTER : If Speed < 64 Then Speed := Speed * 2;
  CMD_SLOWER : If Speed > 1 Then Speed := Speed Div 2;
  CMD_QUIT : QuitReq := True;
  CMD_ORBIT : ShowOrbite := Not ShowOrbite;
  CMD_NAME : ShowName := Not ShowName;
  CMD_BELT : ShowBelt := Not ShowBelt;
  CMD_STARS : ShowStars := Not ShowStars;
  CMD_INNER : Zoom := 1.0;
  CMD_FULL : Zoom := 0.42;
  CMD_ZIN : If Zoom < 4 Then Zoom := Zoom * 1.25;
  CMD_ZOUT : If Zoom > 0.2 Then Zoom := Zoom / 1.25;
  CMD_BODIES : ShowBodies;
  CMD_ABOUT : Dummy := PmBox('Simulateur de plan'#138'te',
   'Simulateur de plan'#138'te (SIMUPLAN) : mouvements des astres du syst'#138'me solaire. '+
   'Porte du d'#130'p'#244't Axtro pour OS/2-0. https://www.gladir.com/axtro', MB_OK Or MB_INFORMATION);
 End;
End;

Procedure Click(X, Y : LongInt);
Var J, Best : Integer; D, BD : LongInt;
Begin
 Best := 0; BD := 400;
 If Y >= VIEW_H Then Exit;
 For J := 1 To NbTotal Do Begin
  D := Sqr(LongInt(Astres[J].X) - X) + Sqr(LongInt(Astres[J].Y) - Y);
  If D < BD Then Begin BD := D; Best := J; End;
 End;
 Sel := Best;
End;

Procedure HandleKey(Ch : Char);
Begin
 Case UpCase(Ch) Of
  ' ' : DoCmd(CMD_PLAY);
  '+', '=' : DoCmd(CMD_FASTER);
  '-' : DoCmd(CMD_SLOWER);
  'O' : DoCmd(CMD_ORBIT);
  'N' : DoCmd(CMD_NAME);
  'C' : DoCmd(CMD_BELT);
  'E' : DoCmd(CMD_STARS);
  'I' : DoCmd(CMD_INNER);
  'S' : DoCmd(CMD_FULL);
  #27 : Sel := 0;
 End;
End;

Var
 Ch : Char;
 C, Mx, My, Mb, PrevB, T0, T1 : LongInt;

BEGIN
 If (ParamStr(1) = '/?') Or (ParamStr(1) = '--help') Or (ParamStr(1) = '-h') Or
    (ParamStr(1) = '/h') Or (ParamStr(1) = '/H') Then Begin
  WriteLn('SIMUPLAN : Simulation des mouvements des astres du syst'#138'me solaire.');
  WriteLn;
  WriteLn('Syntaxe : SIMUPLAN [/NAME] [/ORBIT]');
  WriteLn;
  WriteLn(' /NAME    Affiche les noms des astres');
  WriteLn(' /ORBIT   Affiche l''orbite des astres');
  Halt;
 End;
 ShowOrbite := False; ShowName := False;
 For I := 1 To ParamCount Do Begin
  If StrToUpper(ParamStr(I)) = '/ORBIT' Then ShowOrbite := True Else
  If StrToUpper(ParamStr(I)) = '/NAME' Then ShowName := True;
 End;
 ShowBelt := True; ShowStars := True; Running := True; QuitReq := False;
 Tm := 0; Speed := 1; Zoom := 1.0; Sel := 0;
 Cx := 320; Cy := VIEW_H Div 2;
 InitBmi;
 OsFrame := 0; OsClient := 0;
 OpenWindow('SIMUPLAN', 'Simulateur de plan'#138'te');
 PrevB := 0;
 T0 := KTicks;
 Repeat
  DrawFrame;
  { une image toutes les 50 ms, comme Delay(50) de la version DOS }
  Repeat
   While KeyPressed Do Begin
    Ch := ReadKey;
    If Ch = #0 Then Begin
     Ch := ReadKey;
     Case Ord(Ch) Of
      45 : QuitReq := True;
      59 : DoCmd(CMD_BODIES);
      71 : DoCmd(CMD_RESTART);
      73 : DoCmd(CMD_ZIN);
      81 : DoCmd(CMD_ZOUT);
     End;
    End Else HandleKey(Ch);
    DrawFrame;
   End;
   While PollCmd(C) Do Begin
    If C = CMD_CLOSE Then QuitReq := True
    Else If (C > 100) And (C < 200) Then DoCmd(C - 100);
    DrawFrame;
   End;
   GetMouseState(Mx, My, Mb);
   If ((Mb And 1) <> 0) And ((PrevB And 1) = 0) Then Begin
    Click(Mx, My);
    DrawFrame;
   End;
   PrevB := Mb;
   T1 := KTicks;
  Until QuitReq Or (T1 - T0 >= 50) Or (T1 < T0);
  T0 := T1;
  If Running Then Tm := Tm + Speed;
 Until QuitReq;
 Dummy := WinDestroyWindow(OsFrame);
END.
