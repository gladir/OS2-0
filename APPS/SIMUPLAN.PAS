{ Simulation (calculs d'origine : positions a l'instant I, en degres) }
{ ================================================================== }

Const
 STAT_H = 18;
 VIEW_H = 431 - STAT_H;               { hauteur de la vue }
 CMD_PLAY = 1; CMD_RESTART = 2; CMD_FASTER = 3; CMD_SLOWER = 4; CMD_QUIT = 5;
 CMD_ORBIT = 10; CMD_NAME = 11; CMD_BELT = 12; CMD_STARS = 13;
 CMD_INNER = 20; CMD_FULL = 21; CMD_ZIN = 22; CMD_ZOUT = 23;
 CMD_BODIES = 30; CMD_ABOUT = 31;

Var
 ShowBelt, ShowStars, Running, QuitReq : Boolean;
 Tm : Double;                          { instant (pas de la version DOS) }
 Speed : Integer;                      { pas par image : 1, 2, 4, 8... }
 Zoom : Double;
 Cx, Cy : Integer;
 Sel : Integer;
 Base : Array[1..NbTotal] Of TAstre;

Function SX(V : Double) : Integer;
Begin
 SX := Cx + Round(V * Zoom);
End;

Function SY(V : Double) : Integer;
Begin
 SY := Cy + Round(V * Zoom);
End;

Function Sz(R : Integer) : Integer;
Var V : Integer;
Begin
 V := Round(R * Sqrt(Zoom));
 If V < 1 Then V := 1;
 Sz := V;
End;

{ positions de tous les astres a l'instant T (formules d'origine, par
  rapport au Soleil place a l'origine) }
Procedure Positions(T : Double; Var PX, PY : Array Of Double);
Var J : Integer;
Begin
 PX[0] := 0; PY[0] := 0;
 For J := 2 To NbTotal Do Begin
  PX[J - 1] := PX[Astres[J].Centre - 1] + Astres[J].Distance * Cos(T * Astres[J].Vitesse * Pi / 180);
  PY[J - 1] := PY[Astres[J].Centre - 1] - Astres[J].Distance * Sin(T * Astres[J].Vitesse * Pi / 180);
  If Astres[J].Nom = 'Encke' Then Begin
   PX[J - 1] := (100 + 100 * Cos(T * Pi / 180)) * Cos(T * Astres[J].Vitesse * Pi / 180);
   PY[J - 1] := -(50 + 50 * Sin(T * Pi / 180)) * Sin(T * Astres[J].Vitesse * Pi / 180);
  End;
 End;
End;

Procedure DrawStatus;
Var S : String; D : String[12];
Begin
 SetFillStyle(SolidFill, LightGray);
 Bar(0, VIEW_H, 639, 430);
 Bevel(2, VIEW_H + 2, 459, 429, True);
 Bevel(462, VIEW_H + 2, 637, 429, True);
 Str(Round(Tm) Div 1, D);
 If Sel > 0 Then S := Astres[Sel].Nom + ' - ' Else S := '';
 If Running Then S := S + 'Simulation en cours' Else S := S + 'Simulation en pause';
 SetColor(Black);
 OutTextXY(8, VIEW_H + 6, S);
 Str(Speed, S);
 S := 'Pas ' + D + '  Vitesse x' + S;
 OutTextXY(468, VIEW_H + 6, S);
End;

Procedure DrawFrame;
Var
 J, Angle, X, Y, R : Integer;
 PX, PY : Array[0..NbTotal - 1] Of Double;
 Sd : LongInt;
Begin
 SetViewPort(0, 0, 639, VIEW_H - 1, True);
 SetFillStyle(SolidFill, Black);
 Bar(0, 0, 639, VIEW_H - 1);
 { etoiles du fond (toujours au meme endroit) }
 If ShowStars Then Begin
  Sd := 1957;
  For J := 1 To 160 Do Begin
   Sd := (Sd * 1103515245 + 12345) And $7FFFFFFF;
   X := (Sd Shr 8) Mod 640;
   Sd := (Sd * 1103515245 + 12345) And $7FFFFFFF;
   Y := (Sd Shr 8) Mod VIEW_H;
   If J Mod 5 = 0 Then PutPixel(X, Y, LightGray) Else PutPixel(X, Y, DarkGray);
  End;
 End;
 Positions(Tm, PX, PY);
 { ceinture d'asteroides en pointilles }
 If ShowBelt Then Begin
  Angle := 0;
  While Angle <= 360 Do Begin
   PutPixel(SX(220 * Cos(Angle * Pi / 180)), SY(-220 * Sin(Angle * Pi / 180)), DarkGray);
   Angle := Angle + 5;
  End;
 End;
 { orbites }
 If ShowOrbite Then
  For J := 2 To NbTotal Do
   If Astres[J].Nom = 'Encke' Then Begin
    Angle := 0;
    While Angle <= 720 Do Begin
     PutPixel(SX((100 + 100 * Cos(Angle * Pi / 180)) * Cos(Angle * Astres[J].Vitesse * Pi / 180)),
              SY(-(50 + 50 * Sin(Angle * Pi / 180)) * Sin(Angle * Astres[J].Vitesse * Pi / 180)), LightGray);
     Angle := Angle + 10;
    End;
   End Else Begin
    SetColor(DarkGray);
    SetLineStyle(DottedLn, 0, 1);
    Circle(SX(PX[Astres[J].Centre - 1]), SY(PY[Astres[J].Centre - 1]), Round(Astres[J].Distance * Zoom));
    SetLineStyle(SolidLn, 0, 1);
   End;
 { astres }
 For J := 1 To NbTotal Do Begin
  X := SX(PX[J - 1]); Y := SY(PY[J - 1]);
  Astres[J].X := X; Astres[J].Y := Y;
  R := Sz(Astres[J].Rayon);
  If J = 1 Then R := Round(Astres[J].Rayon * Zoom);
  If R < 2 Then R := 2;
  SetColor(Astres[J].Couleur);
  SetFillStyle(SolidFill, Astres[J].Couleur);
  FillEllipse(X, Y, R, R);
  If Astres[J].Anneau Then Begin
   SetColor(White);
   Ellipse(X, Y, 0, 360, R + 3, R + 1);
  End;
  If J = Sel Then Begin
   SetColor(Yellow);
   Rectangle(X - R - 3, Y - R - 3, X + R + 3, Y + R + 3);
  End;
  If ShowName Or (J = Sel) Then Begin
   SetColor(White);
   OutTextXY(X + R + 3, Y - 4, Astres[J].Nom);
  End;
 End;
 SetViewPort(0, 0, 639, 430, False);
 DrawStatus;
End;

