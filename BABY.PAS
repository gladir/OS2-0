  BigText(PnX + (PW - 4 * 16) Div 2, 6, 'BABY', CLR_DARKRED, CLR_PALEGRAY);
  OutTxt(PnX, 40, 'Pointage', CLR_BLACK, CLR_PALEGRAY);
