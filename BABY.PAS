Procedure SetMark(Id : LongInt; On : Boolean);
Var M : LongInt;
Begin
  M := WinWindowFromID(Frame, $8005);
  If M = 0 Then Exit;
  If On Then Dummy := WinSendMsg(M, MM_SETITEMATTR, Id Or $10000, MIA_CHECKED Or (MIA_CHECKED Shl 16))
  Else Dummy := WinSendMsg(M, MM_SETITEMATTR, Id Or $10000, MIA_CHECKED);
End;

Function TickMs : LongInt;
Var T : LongInt;
Begin
  T := 150 - (Wave - 1) * 8;
  If T < 80 Then T := 80;
  TickMs := T;
End;

Function SpawnRange : LongInt;
Var T : LongInt;
Begin
  T := 1200 - (Wave - 1) * 100;
  If T < 250 Then T := 250;
  SpawnRange := T;
End;

Procedure ClearBabies;
Var K : LongInt;
Begin
  For K := 0 To NSlot - 1 Do BabyI[K] := 0;
  Wait := 0;
End;

Procedure ShowBanner(St : LongInt; S1, S2 : String);
Begin
  State := St; Banner1 := S1; Banner2 := S2;
  Redraw;
End;

Procedure NewGame;
Begin
  Score := 0; Wave := 1; WaveLeft := NSlot; Lives := 3; Saved := 0; FirePlace := 0; MissPos := 0; Acc := 0;
  ClearBabies;
  Msg := 'Placez la toile des pompiers sous chaque b' + Chr(130) + 'b' + Chr(130) + ' : ' + Chr(27) + ' ' + Chr(26) +
         ', 1 2 3 ou la souris.';
  ShowBanner(1, 'Vague 1', 'Espace ou clic : commencer');
End;

Procedure Resume;
Begin
  If State = 2 Then
  Begin
    NewGame;
    Exit;
  End;
  If State = 0 Then Exit;
  State := 0; MissPos := 0; Acc := 0;
  Msg := 'Vague ' + IStr(Wave) + ' : sauvez les b' + Chr(130) + 'b' + Chr(130) + 's !';
  Redraw;
End;

Procedure TogglePause;
Begin
  If State = 0 Then
  Begin
    Msg := 'Pause.';
    ShowBanner(1, 'Pause', 'Espace, P ou clic : reprendre');
  End
  Else If State = 1 Then Resume;
End;

Procedure MoveFire(P : LongInt);
Begin
  If (P < 0) Or (P > 2) Or (P = FirePlace) Then Exit;
  DirtySpr(30, FireX(FirePlace), 260);
  FirePlace := P;
  DirtySpr(30, FireX(FirePlace), 260);
  If State = 0 Then FlushScr(False);
End;

Procedure LoseBaby(P : LongInt);
Begin
  Dummy := WinAlarm(HWND_DESKTOP, 1);
  Dec(Lives);
  ClearBabies;
  MissPos := P;
  If Lives <= 0 Then
  Begin
    Lives := 0;
    If Score > Best Then Best := Score;
    Msg := 'Partie termin' + Chr(130) + 'e : ' + IStr(Score) + ' points, ' + IStr(Saved) + ' b' + Chr(130) + 'b' +
           Chr(130) + 's sauv' + Chr(130) + 's (vague ' + IStr(Wave) + ').';
    ShowBanner(2, 'Vous avez perdu !', 'Espace ou F2 : nouvelle partie');
  End
  Else
  Begin
    Msg := 'Vous avez perdu un b' + Chr(130) + 'b' + Chr(130) + ' ! Il reste ' + IStr(Lives) + ' vie(s).';
    ShowBanner(1, 'B' + Chr(130) + 'b' + Chr(130) + ' perdu !', 'Espace ou clic : continuer');
  End;
End;

{ pompiers automatiques : sous le bebe le plus proche de son rebond }
Procedure AutoPlay;
Var K, P, Need, Dist, BestD : LongInt;
Begin
  BestD := 99; Need := FirePlace;
  For K := 0 To NSlot - 1 Do
  Begin
    P := BabyI[K];
    If (P >= 1) And (P <= 22) Then
    Begin
      If P <= 8 Then
      Begin
        Dist := 8 - P;
        If Dist < BestD Then Begin BestD := Dist; Need := 0; End;
      End
      Else If P <= 16 Then
      Begin
        Dist := 16 - P;
        If Dist < BestD Then Begin BestD := Dist; Need := 1; End;
      End
      Else
      Begin
        Dist := 22 - P;
        If Dist < BestD Then Begin BestD := Dist; Need := 2; End;
      End;
    End;
  End;
  MoveFire(Need);
End;

{ un pas du prototype : chaque bebe avance d'une position }
Procedure GameStep;
Var J, I, P : LongInt; Already : Boolean;
Begin
  If Auto <> 0 Then AutoPlay;
  For J := NSlot - 1 DownTo 0 Do
  Begin
    If BabyI[J] = 0 Then
    Begin
      If Wait <= 0 Then
      Begin
        Already := False;
        For I := 0 To NSlot - 1 Do If BabyI[I] = 1 Then Already := True;
        If Not Already Then
        Begin
          BabyI[J] := 1;
          DirtyBaby(1);
        End;
        Wait := Rnd(SpawnRange);
      End
      Else Dec(Wait);
    End
    Else If BabyI[J] <> B_SAVED Then
    Begin
      P := BabyI[J];
      If ((P = 8) And (FirePlace <> 0)) Or ((P = 16) And (FirePlace <> 1)) Or ((P = 22) And (FirePlace <> 2)) Then
      Begin
        LoseBaby(P);
        Exit;
      End;
      DirtyBaby(P);
      Inc(BabyI[J]);
      DirtyBaby(BabyI[J]);
      If BabyI[J] > 26 Then
      Begin
        BabyI[J] := B_SAVED;
        Score := Score + 25; Inc(Saved);
        Dec(WaveLeft);
        If WaveLeft = 0 Then
        Begin
          Inc(Wave); WaveLeft := NSlot;
          ClearBabies;
          Msg := 'Vague r' + Chr(130) + 'ussie ! ' + IStr(Score) + ' points.';
          ShowBanner(1, 'Vague r' + Chr(130) + 'ussie !', 'Espace ou clic : vague ' + IStr(Wave));
          Exit;
        End;
      End;
    End;
  End;
End;

Procedure TimerTick;
Var Chg : Boolean; S0 : LongInt;
Begin
  If State <> 0 Then Exit;
  Inc(Ticks);
  If Ticks Mod 6 = 0 Then
  Begin
    Flip := 1 - Flip;
    DirtySpr(0, 0, 0);
  End;
  Acc := Acc + 50;
  Chg := False;
  S0 := Score;
  While (Acc >= TickMs) And (State = 0) Do
  Begin
    Acc := Acc - TickMs;
    GameStep;
    Chg := True;
  End;
  If State <> 0 Then Exit;
  FlushScr(Chg And (Score <> S0));
End;

Procedure Command(Id : LongInt);
Begin
  Case Id Of
    CM_NEW : NewGame;
    CM_PAUSE : TogglePause;
    CM_AUTO :
      Begin
        Auto := 1 - Auto;
        SetMark(CM_AUTO, Auto <> 0);
      End;
    CM_QUIT : Dummy := WinPostMsg(Client, WM_CLOSE, 0, 0);
    CM_RULES :
      Begin
        If State = 0 Then TogglePause;
        LClr;
        LAdd('L''immeuble br' + Chr(150) + 'le et des b' + Chr(130) + 'b' + Chr(130) + 's sautent par la fen' +
             Chr(136) + 'tre ! Les deux pompiers tiennent une toile : placez-la sous chaque b' + Chr(130) + 'b' +
             Chr(130) + ' pour le faire rebondir, trois fois, jusqu''' + Chr(133) + ' l''ambulance. ');
        LAdd('Un b' + Chr(130) + 'b' + Chr(130) + ' sauv' + Chr(130) + ' rapporte 25 points. Apr' + Chr(138) +
             's 26 b' + Chr(130) + 'b' + Chr(130) + 's, la vague suivante arrive, plus vite. Un b' + Chr(130) +
             'b' + Chr(130) + ' manqu' + Chr(130) + ' co' + Chr(150) + 'te une vie : la partie se termine ' +
             Chr(133) + ' la troisi' + Chr(138) + 'me.' + Chr(10) + Chr(10));
        LAdd('Clavier : fl' + Chr(138) + 'ches gauche et droite (d' + Chr(130) + 'placer les pompiers), A B C ou ' +
             '1 2 3 (position 1, 2 ou 3), P (pause), Espace (reprendre), F2 (nouvelle partie). Souris : cliquez ' +
             'au-dessus d''une position.');
        Dummy := LMsgBox('Baby - R' + Chr(138) + 'gles', MB_OK Or MB_INFORMATION);
      End;
    CM_ABOUT :
      Begin
        If State = 0 Then TogglePause;
        Dummy := Ask('Baby pour OS/2-0 (Presentation Manager), port' + Chr(130) + ' du prototype BABY.PAS de 7iles ' +
                     '(2024, Turbo Pascal et BGI) avec ses images.' + Chr(10) +
                     'Programme ' + Chr(130) + 'crit en Pascal et compil' + Chr(130) + ' par OS2PC.',
                     'A propos de Baby', MB_OK Or MB_INFORMATION);
      End;
  End;
End;

