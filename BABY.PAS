{ Image en memoire (indices de palette, lignes de bas en haut)          }
{ ==================================================================== }

Procedure SetPal(I, R, G, B : LongInt);
Var A : LongInt;
Begin
  A := LongInt(@Bmi) + 16 + I * 4;
  WrB(A, B); WrB(A + 1, G); WrB(A + 2, R);
End;

{ 0 a 15 : les 16 couleurs du prototype (le magenta devient rouge brique) ;
  16 a 31 : les memes pour les flammes (orange et jaune) ; 32 a 39 : ciel ;
  40 a 45 : chaussee et etoiles }
Procedure InitBmi;
Const
  Ega : Array[0..15] Of LongInt = (
    $000000, $0000AA, $00AA00, $00AAAA, $AA0000, $961E14, $AA5500, $AAAAAA,
    $555555, $5555FF, $55FF55, $55FFFF, $FF5555, $EB3C28, $FFFF55, $FFFFFF);
Var I, C : LongInt;
Begin
  FillChar(Bmi, SizeOf(Bmi), 0);
  WrL(LongInt(@Bmi), 16);
  WrL(LongInt(@Bmi) + 4, BW);
  WrL(LongInt(@Bmi) + 8, BH);
  WrW(LongInt(@Bmi) + 12, 1);
  WrW(LongInt(@Bmi) + 14, 8);
  For I := 0 To 15 Do
  Begin
    C := Ega[I];
    SetPal(I, (C Shr 16) And 255, (C Shr 8) And 255, C And 255);
    SetPal(16 + I, (C Shr 16) And 255, (C Shr 8) And 255, C And 255);
  End;
  SetPal(16 + 13, 255, 170, 0); SetPal(16 + 5, 230, 70, 0); SetPal(16 + 8, 190, 40, 0);
  SetPal(16 + 7, 255, 225, 80); SetPal(16 + 15, 255, 250, 200);
  For I := 0 To 7 Do SetPal(32 + I, 8 + I * 5, 12 + I * 2, 40 + I * 4);
  SetPal(40, 64, 64, 72); SetPal(41, 210, 210, 200); SetPal(42, 120, 120, 128); SetPal(43, 90, 90, 100);
  SetPal(44, 235, 235, 255); SetPal(45, 120, 120, 170);
End;

Procedure Pix(X, Y, C : LongInt);
Begin
  If (X >= 0) And (X < BW) And (Y >= 0) And (Y < BH) Then Fb[(BH - 1 - Y) * BW + X] := C;
End;

{ image K du prototype en (X, Y) ; Add : decalage de palette ; Mirror : retournee }
Procedure DrawSpr(K, X, Y, Add : LongInt; Mirror : Boolean);
Var I, J, P, B, W, C, Xp : LongInt;
Begin
  P := SprOff[K]; W := SprW[K];
  For J := 0 To SprH[K] - 1 Do
    For I := 0 To W Div 2 - 1 Do
    Begin
      B := SprD[P];
      Inc(P);
      If B <> 0 Then
      Begin
        C := B Shr 4;
        If Mirror Then Xp := X + W - 1 - I * 2 Else Xp := X + I * 2;
        If C <> 0 Then Pix(Xp, Y + J, C + Add);
        C := B And 15;
        If Mirror Then Xp := X + W - 2 - I * 2 Else Xp := X + I * 2 + 1;
        If C <> 0 Then Pix(Xp, Y + J, C + Add);
      End;
    End;
End;

{ fond : ciel etoile, chaussee, immeuble, ambulance }
Procedure MakeBg;
Var X, Y, K, S : LongInt;
Begin
  For Y := 0 To 295 Do
  Begin
    K := 32 + (Y * 8) Div 296;
    For X := 0 To BW - 1 Do Fb[(BH - 1 - Y) * BW + X] := K;
  End;
  S := 12345;
  For K := 0 To 69 Do
  Begin
    S := (S * 1103515245 + 12345) And $7FFFFFFF;
    X := 50 + (S Shr 8) Mod 420;
    S := (S * 1103515245 + 12345) And $7FFFFFFF;
    Y := 30 + (S Shr 8) Mod 150;
    If K Mod 3 = 0 Then Pix(X, Y, 44) Else Pix(X, Y, 45);
  End;
  For X := 0 To BW - 1 Do
  Begin
    Pix(X, 295, 7);
    Pix(X, 296, 42); Pix(X, 297, 42);
    For Y := 298 To BH - 1 Do Pix(X, Y, 40);
    Pix(X, BH - 1, 43);
    If (X Mod 32) < 18 Then
    Begin
      Pix(X, 304, 41); Pix(X, 305, 41);
    End;
  End;
  DrawSpr(1, SprX[1], SprY[1], 0, False);
  DrawSpr(28, SprX[28], SprY[28], 0, False);
  Move(Fb, Bg, SizeOf(Fb));
End;

Function FireX(P : LongInt) : LongInt;
Begin
  Case P Of
    0 : FireX := 45;
    1 : FireX := 180;
  Else
    FireX := 313;
  End;
End;

Function LifeX(I : LongInt) : LongInt;
Begin
  Case I Of
    0 : LifeX := 127;
    1 : LifeX := 152;
  Else
    LifeX := 179;
  End;
End;

Var
  MissPos : LongInt;

Procedure Render;
Var K : LongInt;
Begin
  Move(Bg, Fb, SizeOf(Fb));
  DrawSpr(0, 0, 0, 16, Flip <> 0);
  For K := 0 To Lives - 1 Do DrawSpr(29, LifeX(K), 0, 0, False);
  For K := 0 To NSlot - 1 Do
    If (BabyI[K] >= 1) And (BabyI[K] <= 26) Then DrawSpr(BabyI[K] + 1, SprX[BabyI[K] + 1], SprY[BabyI[K] + 1], 0, False);
  If MissPos > 0 Then DrawSpr(MissPos + 1, SprX[MissPos + 1], SprY[MissPos + 1], 0, False);
  DrawSpr(30, FireX(FirePlace), 260, 0, False);
End;

{ --- rectangles a recopier a l'ecran --- }
Procedure AddDirty(X1, Y1, X2, Y2 : LongInt);
Begin
  If X1 < 0 Then X1 := 0;
  If Y1 < 0 Then Y1 := 0;
  If X2 > BW - 1 Then X2 := BW - 1;
  If Y2 > BH - 1 Then Y2 := BH - 1;
  If NDirty >= MaxDirty Then
  Begin
    NDirty := 1;
    DX1[0] := 0; DY1[0] := 0; DX2[0] := BW - 1; DY2[0] := BH - 1;
    Exit;
  End;
  DX1[NDirty] := X1; DY1[NDirty] := Y1; DX2[NDirty] := X2; DY2[NDirty] := Y2;
  Inc(NDirty);
End;

Procedure DirtySpr(K, X, Y : LongInt);
Begin
  AddDirty(X, Y, X + SprW[K] - 1, Y + SprH[K] - 1);
End;

Procedure DirtyBaby(P : LongInt);
Begin
  If (P >= 1) And (P <= 26) Then DirtySpr(P + 1, SprX[P + 1], SprY[P + 1]);
End;

Procedure DirtyAll;
Begin
  NDirty := 0;
  AddDirty(0, 0, BW - 1, BH - 1);
End;

Procedure BlitRect(H, X1, Y1, X2, Y2 : LongInt);
Var P : Array[0..7] Of LongInt;
Begin
  P[0] := OX + X1; P[1] := CH - OY - 1 - Y2; P[2] := OX + X2 + 1; P[3] := CH - OY - Y1;
  P[4] := X1; P[5] := BH - 1 - Y2; P[6] := X2 + 1; P[7] := BH - Y1;
  Dummy := GpiDrawBits(H, LongInt(@Fb), LongInt(@Bmi), 4, LongInt(@P), $CC, 0);
End;

