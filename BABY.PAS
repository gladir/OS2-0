Procedure Button(X, Y, W, H : LongInt; S : String);
Begin
  FBar(X, Y, X + W - 1, Y + H - 1, CLR_PALEGRAY);
  Edge(X, Y, X + W - 1, Y + H - 1, CLR_WHITE, CLR_BLACK);
  Edge(X + 1, Y + 1, X + W - 2, Y + H - 2, CLR_PALEGRAY, CLR_DARKGRAY);
  OutTxt(X + (W - Length(S) * 8) Div 2, Y + (H - 16) Div 2, S, CLR_BLACK, CLR_PALEGRAY);
End;

Procedure DrawCounters;
Var S : String;
Begin
  FBar(PnX + 2, 62, PnX + PW - 3, 96, CLR_WHITE);
  S := IStr(Score);
  BigText(PnX + PW - 8 - Length(S) * 16, 63, S, CLR_DARKRED, CLR_WHITE);
  FBar(PnX, 104, PnX + PW - 1, 176, CLR_PALEGRAY);
  OutTxt(PnX, 104, 'Vague : ' + IStr(Wave), CLR_DARKBLUE, CLR_PALEGRAY);
  OutTxt(PnX, 122, 'B' + Chr(130) + 'b' + Chr(130) + 's : ' + IStr(NSlot - WaveLeft) + ' / ' + IStr(NSlot),
