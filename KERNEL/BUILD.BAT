@ECHO OFF
REM BUILD.BAT - Construit OS/2-0 et le CD-ROM amorcable IMAGE\OS2CD.ISO
REM (a lancer depuis le dossier KERNEL, Free Pascal dans le PATH)
IF NOT EXIST ..\BUILD\CD\NUL MD ..\BUILD
IF NOT EXIST ..\BUILD\CD\NUL MD ..\BUILD\CD
ECHO == Outils (Free Pascal)
fpc -O1 -FE..\BUILD ..\TOOLS\OS2PC.PAS
IF ERRORLEVEL 1 GOTO ERREUR
fpc -FE..\BUILD ..\TOOLS\MAKEISO.PAS
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Noyau (OS2PC)
..\BUILD\OS2PC -COS2BOOT OS2BOOT.PAS ..\BUILD\CD\OS2BOOT
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -COS2LDR OS2LDR.PAS ..\BUILD\CD\OS2LDR
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -COS2KRNL OS2KRNL.PAS ..\BUILD\CD\OS2KRNL
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Commandes (OS2PC -COS2)
FOR %%F IN (..\*.PAS) DO ..\BUILD\OS2PC -Q %%F ..\BUILD\CD\%%~nF.EXE
ECHO == Bibliotheques DOSCALLS.DLL, FKA.DLL et HPFS.IFS
..\BUILD\OS2PC -Q ..\DLL\DOSCALLS.PAS ..\BUILD\CD\DOSCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTDOS.PAS ..\BUILD\CD\TESTDOS.EXE
..\BUILD\OS2PC -Q ..\DLL\FKA.PAS ..\BUILD\CD\FKA.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTFKA.PAS ..\BUILD\CD\TESTFKA.EXE
..\BUILD\OS2PC -Q ..\DLL\HPFS.PAS ..\BUILD\CD\HPFS.IFS
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTHPFS.PAS ..\BUILD\CD\TESTHPFS.EXE
COPY ..\IMAGE\SYSTEM\CONFIG.SYS ..\BUILD\CD\CONFIG.SYS > NUL
ECHO == CD-ROM amorcable
..\BUILD\MAKEISO ..\IMAGE\OS2CD.ISO /BOOT:..\BUILD\CD\OS2BOOT /LABEL:OS2_0 ..\BUILD\CD\*.*
IF ERRORLEVEL 1 GOTO ERREUR
FOR %%F IN (OS2BOOT OS2LDR OS2KRNL CMD.EXE DOSCALLS.DLL FKA.DLL HPFS.IFS) DO COPY ..\BUILD\CD\%%F ..\IMAGE\SYSTEM > NUL
ECHO Termine : ..\IMAGE\OS2CD.ISO
GOTO FIN
:ERREUR
ECHO Echec de la construction.
:FIN
