@ECHO OFF
REM BUILD.BAT - Construit OS/2-0 et le CD-ROM amorcable IMAGE\OS2CD.ISO
REM (a lancer depuis le dossier KERNEL, Free Pascal dans le PATH)
IF NOT EXIST ..\BUILD\CD\NUL MD ..\BUILD
IF NOT EXIST ..\BUILD\CD\NUL MD ..\BUILD\CD
ECHO == Outils (Free Pascal)
fpc -O1 -FE..\BUILD ..\TOOLS\OS2PC.PAS
IF ERRORLEVEL 1 GOTO ERREUR
fpc -FE..\BUILD ..\TOOLS\MAKEISO.PAS
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Noyau (OS2PC)
..\BUILD\OS2PC -COS2BOOT OS2BOOT.PAS ..\BUILD\CD\OS2BOOT
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -COS2LDR OS2LDR.PAS ..\BUILD\CD\OS2LDR
IF ERRORLEVEL 1 GOTO ERREUR
REM (OS2KRNL.PAS inclut LOGO.INC : logo de l'ecran de demarrage, TOOLS\MKLOGO.PY)
..\BUILD\OS2PC -COS2KRNL OS2KRNL.PAS ..\BUILD\CD\OS2KRNL
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Commandes (OS2PC -COS2)
REM (dont les jeux KLONDIKE.PAS, ECHECS.PAS, MAHJONGG.PAS, SUDOKU.PAS, OTHELLO.PAS, TILEMAN.PAS,
REM HEX2048.PAS, BACKGAM.PAS, POKER.PAS, BILLARD.PAS, CHECKERS.PAS, YATHZEE.PAS, BATTLE.PAS, POWER4.PAS, SOKOBAN.PAS,
REM BACCARAT.PAS, HANOIS.PAS, BABY.PAS, 421.PAS, CENTIPED.PAS, ASTEROID.PAS, BADUGI.PAS, TTT.PAS
REM BASEBALL.PAS, EXCAVAT.PAS, PINBALL.PAS, BARBU.PAS, BREAKOUT.PAS, BATAILLE.PAS et INVADERS.PAS
REM du dossier Jeux,
REM DIGAUDIO.PAS, Audio numerique, et NOTATOR.PAS, Notator for OS2-Zero (porte
REM d'OFFICE-0, exemples .SON et .MID de IMAGE\NOTATOR), du dossier Multimedia, TASKMGR.PAS,
REM Gestionnaire des taches, du dossier Systeme OS/2, BROWSER.PAS,
REM Navigateur Web, du bureau et du dossier Systeme OS/2, PASDEV.PAS,
REM Pascal Developer, du dossier Developer Kit, CALC.PAS, Calculatrice, et
REM EXPLORER.PAS, Explorateur OS2-0, et OUTLINK.PAS, Outlink (client de messagerie
REM porte d'OFFICE-0 : IMAP, POP3, SMTP par TCPIP32.DLL et TLS32.DLL), du dossier Productivite)
REM WORDIUM.PAS, WorDium (traitement de texte porte de WORD.PAS d'OFFICE-0 : DOCX, DOC, PDF,
REM GAT du MonsterBook, correcteur d'orthographe), est aussi dans le dossier Productivite,
REM comme EXCELSIO.PAS, Excelsior (tableur porte d'EXCEL.PAS d'OFFICE-0 : XLC, XLS, XLSX)
REM (APPS\PAINT.PAS, Paint porte de Pasdows 95, utilise les AnsiString, Int64, PByte,
REM tableaux dynamiques et Try/Except de Free Pascal, qu'OS2PC accepte)
FOR %%F IN (..\*.PAS) DO ..\BUILD\OS2PC -Q %%F ..\BUILD\CD\%%~nF.EXE
ECHO == Paint (OS2PC : APPS\PAINT.PAS, porte de Pasdows 95)
..\BUILD\OS2PC -Q ..\APPS\PAINT.PAS ..\BUILD\CD\PAINT.EXE
IF ERRORLEVEL 1 GOTO ERREUR
REM nom 8.3 sur le CD-ROM (ISO 9660 niveau 1)
IF EXIST ..\BUILD\CD\LAUNCHPAD.EXE MOVE /Y ..\BUILD\CD\LAUNCHPAD.EXE ..\BUILD\CD\LAUNCHPD.EXE > NUL
ECHO == OS2PC.EXE (compilateur natif : OS2PC.PAS compile par OS2PC) et exemples de Pascal Developer
..\BUILD\OS2PC -Q ..\TOOLS\OS2PC.PAS ..\BUILD\CD\OS2PC.EXE
IF ERRORLEVEL 1 GOTO ERREUR
COPY ..\IMAGE\EXEMPLES\*.PAS ..\BUILD\CD > NUL
COPY ..\IMAGE\EXEMPLES\*.BMP ..\BUILD\CD > NUL
COPY ..\IMAGE\EXEMPLES\*.GAT ..\BUILD\CD > NUL
COPY ..\IMAGE\EXEMPLES\*.PDF ..\BUILD\CD > NUL
COPY ..\IMAGE\EXEMPLES\*.XLC ..\BUILD\CD > NUL
ECHO == Bibliotheques DOSCALLS.DLL, FKA.DLL, HPFS.IFS, NTFS.IFS, VIOCALLS.DLL, MOUCALLS.DLL, NLS.DLL, KBDCALLS.DLL, MONCALLS.DLL, MSG.DLL, NAMPIPES.DLL, SESMGR.DLL, QUECALLS.DLL, SPOOLCP.DLL, RMINFO.DLL, OS2SM.DLL, HELPMGR.DLL, LIBUNI.DLL, PMDRAG.DLL, PMWIN.DLL, PMGPI.DLL, PMMERGE.DLL, PMPIC.DLL, PMSHAPI.DLL, PMSPL.DLL, PMVIOP.DLL, API16.DLL, PMWP.DLL et PMCTLS.DLL
..\BUILD\OS2PC -Q ..\DLL\DOSCALLS.PAS ..\BUILD\CD\DOSCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTDOS.PAS ..\BUILD\CD\TESTDOS.EXE
..\BUILD\OS2PC -Q ..\DLL\FKA.PAS ..\BUILD\CD\FKA.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTFKA.PAS ..\BUILD\CD\TESTFKA.EXE
..\BUILD\OS2PC -Q ..\DLL\HPFS.PAS ..\BUILD\CD\HPFS.IFS
..\BUILD\OS2PC -Q ..\DLL\NTFS.PAS ..\BUILD\CD\NTFS.IFS
..\BUILD\OS2PC -Q ..\DLL\TESTNTFS.PAS ..\BUILD\CD\TESTNTFS.EXE
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTHPFS.PAS ..\BUILD\CD\TESTHPFS.EXE
..\BUILD\OS2PC -Q ..\DLL\VIOCALLS.PAS ..\BUILD\CD\VIOCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTVIOR.PAS ..\BUILD\CD\TESTVIOR.DLL
..\BUILD\OS2PC -Q ..\DLL\TESTVIO.PAS ..\BUILD\CD\TESTVIO.EXE
..\BUILD\OS2PC -Q ..\DLL\MOUCALLS.PAS ..\BUILD\CD\MOUCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTMOU.PAS ..\BUILD\CD\TESTMOU.EXE
..\BUILD\OS2PC -Q ..\DLL\NLS.PAS ..\BUILD\CD\NLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTNLS.PAS ..\BUILD\CD\TESTNLS.EXE
..\BUILD\OS2PC -Q ..\DLL\KBDCALLS.PAS ..\BUILD\CD\KBDCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTKBD.PAS ..\BUILD\CD\TESTKBD.EXE
..\BUILD\OS2PC -Q ..\DLL\MONCALLS.PAS ..\BUILD\CD\MONCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTMON.PAS ..\BUILD\CD\TESTMON.EXE
..\BUILD\OS2PC -Q ..\DLL\MSG.PAS ..\BUILD\CD\MSG.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTMSG.PAS ..\BUILD\CD\TESTMSG.EXE
..\BUILD\OS2PC -Q ..\DLL\NAMPIPES.PAS ..\BUILD\CD\NAMPIPES.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTNMP.PAS ..\BUILD\CD\TESTNMP.EXE
..\BUILD\OS2PC -Q ..\DLL\SESMGR.PAS ..\BUILD\CD\SESMGR.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTSES.PAS ..\BUILD\CD\TESTSES.EXE
..\BUILD\OS2PC -Q ..\DLL\QUECALLS.PAS ..\BUILD\CD\QUECALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTQUE.PAS ..\BUILD\CD\TESTQUE.EXE
..\BUILD\OS2PC -Q ..\DLL\SPOOLCP.PAS ..\BUILD\CD\SPOOLCP.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTPFS.PAS ..\BUILD\CD\TESTPFS.EXE
..\BUILD\OS2PC -Q ..\DLL\RMINFO.PAS ..\BUILD\CD\RMINFO.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTRM.PAS ..\BUILD\CD\TESTRM.EXE
..\BUILD\OS2PC -Q ..\DLL\OS2SM.PAS ..\BUILD\CD\OS2SM.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTSM.PAS ..\BUILD\CD\TESTSM.EXE
..\BUILD\OS2PC -Q ..\DLL\HELPMGR.PAS ..\BUILD\CD\HELPMGR.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTHLP.PAS ..\BUILD\CD\TESTHLP.EXE
..\BUILD\OS2PC -Q ..\DLL\LIBUNI.PAS ..\BUILD\CD\LIBUNI.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTUNI.PAS ..\BUILD\CD\TESTUNI.EXE
..\BUILD\OS2PC -Q ..\DLL\PMDRAG.PAS ..\BUILD\CD\PMDRAG.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTDRG.PAS ..\BUILD\CD\TESTDRG.EXE
..\BUILD\OS2PC -Q ..\DLL\PMWIN.PAS ..\BUILD\CD\PMWIN.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTWIN.PAS ..\BUILD\CD\TESTWIN.EXE
..\BUILD\OS2PC -Q ..\DLL\PMGPI.PAS ..\BUILD\CD\PMGPI.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTGPI.PAS ..\BUILD\CD\TESTGPI.EXE
..\BUILD\OS2PC -Q ..\DLL\PMMERGE.PAS ..\BUILD\CD\PMMERGE.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTMRG.PAS ..\BUILD\CD\TESTMRG.EXE
..\BUILD\OS2PC -Q ..\DLL\PMPIC.PAS ..\BUILD\CD\PMPIC.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTPIC.PAS ..\BUILD\CD\TESTPIC.EXE
..\BUILD\OS2PC -Q ..\DLL\PMSHAPI.PAS ..\BUILD\CD\PMSHAPI.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTSHA.PAS ..\BUILD\CD\TESTSHA.EXE
..\BUILD\OS2PC -Q ..\DLL\PMSPL.PAS ..\BUILD\CD\PMSPL.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTSPL.PAS ..\BUILD\CD\TESTSPL.EXE
..\BUILD\OS2PC -Q ..\DLL\PMVIOP.PAS ..\BUILD\CD\PMVIOP.DLL
..\BUILD\OS2PC -Q ..\DLL\API16.PAS ..\BUILD\CD\API16.DLL
..\BUILD\OS2PC -Q ..\DLL\PMWP.PAS ..\BUILD\CD\PMWP.DLL
..\BUILD\OS2PC -Q ..\DLL\PMCTLS.PAS ..\BUILD\CD\PMCTLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTVIOP.PAS ..\BUILD\CD\TESTVIOP.EXE
ECHO == VirtualBox (VBOXGST.DLL), VMware (VMWTOOLS.DLL) et reseau : TCPIP32.DLL, TLS32.DLL, E1000.DLL, PCNET.DLL
FOR %%B IN (VBOXGST VMWTOOLS TCPIP32 TLS32 E1000 PCNET) DO ..\BUILD\OS2PC -Q ..\DLL\%%B.PAS ..\BUILD\CD\%%B.DLL
ECHO == Multimedia : MDM.DLL et pilotes SBAUDIO.DLL, ICHAUDIO.DLL, ESAUDIO.DLL
FOR %%B IN (MDM SBAUDIO ICHAUDIO ESAUDIO) DO ..\BUILD\OS2PC -Q ..\DLL\%%B.PAS ..\BUILD\CD\%%B.DLL
..\BUILD\OS2PC -Q ..\DLL\TESTMDM.PAS ..\BUILD\CD\TESTMDM.EXE
ECHO == Session DOS : TESTVDM.EXE (programme MS-DOS 16 bits, OS2PC -CD)
..\BUILD\OS2PC -Q -CD ..\DLL\TESTVDM.PAS ..\BUILD\CD\TESTVDM.EXE
COPY ..\IMAGE\SONS\*.WAV ..\BUILD\CD > NUL
COPY ..\IMAGE\NOTATOR\*.SON ..\BUILD\CD > NUL
COPY ..\IMAGE\NOTATOR\*.MID ..\BUILD\CD > NUL
COPY ..\IMAGE\NOTATOR\NOTATOR.TXT ..\BUILD\CD > NUL
COPY ..\IMAGE\SYSTEM\CONFIG.SYS ..\BUILD\CD\CONFIG.SYS > NUL
ECHO == CD-ROM amorcable
..\BUILD\MAKEISO ..\IMAGE\OS2CD.ISO /BOOT:..\BUILD\CD\OS2BOOT /LABEL:OS2_0 ..\BUILD\CD\*.*
IF ERRORLEVEL 1 GOTO ERREUR
FOR %%F IN (OS2BOOT OS2LDR OS2KRNL CMD.EXE PMSHELL.EXE LAUNCHPD.EXE DOSCALLS.DLL FKA.DLL HPFS.IFS NTFS.IFS VIOCALLS.DLL MOUCALLS.DLL NLS.DLL KBDCALLS.DLL MONCALLS.DLL MSG.DLL NAMPIPES.DLL SESMGR.DLL QUECALLS.DLL SPOOLCP.DLL RMINFO.DLL OS2SM.DLL HELPMGR.DLL LIBUNI.DLL PMDRAG.DLL PMWIN.DLL PMGPI.DLL PMMERGE.DLL PMPIC.DLL PMSHAPI.DLL PMSPL.DLL PMVIOP.DLL API16.DLL PMWP.DLL PMCTLS.DLL MDM.DLL SBAUDIO.DLL ICHAUDIO.DLL ESAUDIO.DLL VBOXGST.DLL VMWTOOLS.DLL TCPIP32.DLL TLS32.DLL E1000.DLL PCNET.DLL) DO COPY ..\BUILD\CD\%%F ..\IMAGE\SYSTEM > NUL
ECHO == CD-ROM d'installation (PROTSHELL=C:\INSTALL.EXE)
IF NOT EXIST ..\BUILD\CDINST MD ..\BUILD\CDINST
COPY ..\BUILD\CD\*.* ..\BUILD\CDINST > NUL
COPY ..\IMAGE\INSTALL\CONFIG.SYS ..\BUILD\CDINST\CONFIG.SYS > NUL
..\BUILD\MAKEISO ..\IMAGE\OS2INST.ISO /BOOT:..\BUILD\CDINST\OS2BOOT /LABEL:OS2_0_INSTALL ..\BUILD\CDINST\*.*
IF ERRORLEVEL 1 GOTO ERREUR
ECHO Termine : ..\IMAGE\OS2CD.ISO et ..\IMAGE\OS2INST.ISO
GOTO FIN
:ERREUR
ECHO Echec de la construction.
:FIN
