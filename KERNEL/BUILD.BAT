@ECHO OFF
REM BUILD.BAT - Construit OS/2-0 et le CD-ROM amorcable IMAGE\OS2CD.ISO
REM (a lancer depuis le dossier KERNEL, Free Pascal dans le PATH)
IF NOT EXIST ..\BUILD\CD\NUL MD ..\BUILD
IF NOT EXIST ..\BUILD\CD\NUL MD ..\BUILD\CD
ECHO == Outils (Free Pascal)
fpc -O1 -FE..\BUILD ..\TOOLS\OS2PC.PAS
IF ERRORLEVEL 1 GOTO ERREUR
fpc -FE..\BUILD ..\TOOLS\MAKEISO.PAS
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Noyau (OS2PC)
..\BUILD\OS2PC -COS2BOOT OS2BOOT.PAS ..\BUILD\CD\OS2BOOT
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -COS2LDR OS2LDR.PAS ..\BUILD\CD\OS2LDR
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -COS2KRNL OS2KRNL.PAS ..\BUILD\CD\OS2KRNL
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Commandes (OS2PC -COS2)
FOR %%F IN (..\*.PAS) DO ..\BUILD\OS2PC -Q %%F ..\BUILD\CD\%%~nF.EXE
ECHO == Bibliotheques DOSCALLS.DLL, FKA.DLL, HPFS.IFS, VIOCALLS.DLL, MOUCALLS.DLL, NLS.DLL, KBDCALLS.DLL, MONCALLS.DLL, MSG.DLL, NAMPIPES.DLL, SESMGR.DLL, QUECALLS.DLL, SPOOLCP.DLL et RMINFO.DLL
..\BUILD\OS2PC -Q ..\DLL\DOSCALLS.PAS ..\BUILD\CD\DOSCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTDOS.PAS ..\BUILD\CD\TESTDOS.EXE
..\BUILD\OS2PC -Q ..\DLL\FKA.PAS ..\BUILD\CD\FKA.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTFKA.PAS ..\BUILD\CD\TESTFKA.EXE
..\BUILD\OS2PC -Q ..\DLL\HPFS.PAS ..\BUILD\CD\HPFS.IFS
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTHPFS.PAS ..\BUILD\CD\TESTHPFS.EXE
..\BUILD\OS2PC -Q ..\DLL\VIOCALLS.PAS ..\BUILD\CD\VIOCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTVIOR.PAS ..\BUILD\CD\TESTVIOR.DLL
..\BUILD\OS2PC -Q ..\DLL\TESTVIO.PAS ..\BUILD\CD\TESTVIO.EXE
..\BUILD\OS2PC -Q ..\DLL\MOUCALLS.PAS ..\BUILD\CD\MOUCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTMOU.PAS ..\BUILD\CD\TESTMOU.EXE
..\BUILD\OS2PC -Q ..\DLL\NLS.PAS ..\BUILD\CD\NLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTNLS.PAS ..\BUILD\CD\TESTNLS.EXE
..\BUILD\OS2PC -Q ..\DLL\KBDCALLS.PAS ..\BUILD\CD\KBDCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTKBD.PAS ..\BUILD\CD\TESTKBD.EXE
..\BUILD\OS2PC -Q ..\DLL\MONCALLS.PAS ..\BUILD\CD\MONCALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTMON.PAS ..\BUILD\CD\TESTMON.EXE
..\BUILD\OS2PC -Q ..\DLL\MSG.PAS ..\BUILD\CD\MSG.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTMSG.PAS ..\BUILD\CD\TESTMSG.EXE
..\BUILD\OS2PC -Q ..\DLL\NAMPIPES.PAS ..\BUILD\CD\NAMPIPES.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTNMP.PAS ..\BUILD\CD\TESTNMP.EXE
..\BUILD\OS2PC -Q ..\DLL\SESMGR.PAS ..\BUILD\CD\SESMGR.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTSES.PAS ..\BUILD\CD\TESTSES.EXE
..\BUILD\OS2PC -Q ..\DLL\QUECALLS.PAS ..\BUILD\CD\QUECALLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTQUE.PAS ..\BUILD\CD\TESTQUE.EXE
..\BUILD\OS2PC -Q ..\DLL\SPOOLCP.PAS ..\BUILD\CD\SPOOLCP.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTPFS.PAS ..\BUILD\CD\TESTPFS.EXE
..\BUILD\OS2PC -Q ..\DLL\RMINFO.PAS ..\BUILD\CD\RMINFO.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTRM.PAS ..\BUILD\CD\TESTRM.EXE
COPY ..\IMAGE\SYSTEM\CONFIG.SYS ..\BUILD\CD\CONFIG.SYS > NUL
ECHO == CD-ROM amorcable
..\BUILD\MAKEISO ..\IMAGE\OS2CD.ISO /BOOT:..\BUILD\CD\OS2BOOT /LABEL:OS2_0 ..\BUILD\CD\*.*
IF ERRORLEVEL 1 GOTO ERREUR
FOR %%F IN (OS2BOOT OS2LDR OS2KRNL CMD.EXE DOSCALLS.DLL FKA.DLL HPFS.IFS VIOCALLS.DLL MOUCALLS.DLL NLS.DLL KBDCALLS.DLL MONCALLS.DLL MSG.DLL NAMPIPES.DLL SESMGR.DLL QUECALLS.DLL SPOOLCP.DLL RMINFO.DLL) DO COPY ..\BUILD\CD\%%F ..\IMAGE\SYSTEM > NUL
ECHO Termine : ..\IMAGE\OS2CD.ISO
GOTO FIN
:ERREUR
ECHO Echec de la construction.
:FIN
