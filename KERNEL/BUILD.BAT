..\BUILD\OS2PC -Q ..\DLL\PMCTLS.PAS ..\BUILD\CD\PMCTLS.DLL
IF ERRORLEVEL 1 GOTO ERREUR
..\BUILD\OS2PC -Q ..\DLL\TESTVIOP.PAS ..\BUILD\CD\TESTVIOP.EXE
ECHO == VirtualBox (VBOXGST.DLL), VMware (VMWTOOLS.DLL) et reseau : TCPIP32.DLL, TLS32.DLL, E1000.DLL, PCNET.DLL
FOR %%B IN (VBOXGST VMWTOOLS TCPIP32 TLS32 E1000 PCNET) DO ..\BUILD\OS2PC -Q ..\DLL\%%B.PAS ..\BUILD\CD\%%B.DLL
ECHO == Lecteurs reseau : SMB.IFS (client SMB2 des partages Windows et Samba)
..\BUILD\OS2PC -Q ..\DLL\SMB.PAS ..\BUILD\CD\SMB.IFS
ECHO == Multimedia : MDM.DLL et pilotes SBAUDIO.DLL, ICHAUDIO.DLL, ESAUDIO.DLL
FOR %%B IN (MDM SBAUDIO ICHAUDIO ESAUDIO) DO ..\BUILD\OS2PC -Q ..\DLL\%%B.PAS ..\BUILD\CD\%%B.DLL
..\BUILD\OS2PC -Q ..\DLL\TESTMDM.PAS ..\BUILD\CD\TESTMDM.EXE
ECHO == OpenGL : OPENGL.DLL (OpenGL 1.1, interface PGL) et GLTEST.EXE (Essai OpenGL)
..\BUILD\OS2PC -Q ..\DLL\OPENGL.PAS ..\BUILD\CD\OPENGL.DLL
..\BUILD\OS2PC -Q ..\APPS\GLTEST.PAS ..\BUILD\CD\GLTEST.EXE
ECHO == Outils reseau (OS2PC : APPS\FTPCLI.PAS, APPS\SSHCLI.PAS, APPS\MSTSC.PAS, APPS\GITCLI.PAS, APPS\SVNCLI.PAS)
..\BUILD\OS2PC -Q ..\APPS\FTPCLI.PAS ..\BUILD\CD\FTPCLI.EXE
IF NOT EXIST ..\BUILD\CD\FTPCLI.EXE GOTO ERREUR
..\BUILD\OS2PC -Q ..\APPS\SSHCLI.PAS ..\BUILD\CD\SSHCLI.EXE
IF NOT EXIST ..\BUILD\CD\SSHCLI.EXE GOTO ERREUR
..\BUILD\OS2PC -Q ..\APPS\MSTSC.PAS ..\BUILD\CD\MSTSC.EXE
IF NOT EXIST ..\BUILD\CD\MSTSC.EXE GOTO ERREUR
..\BUILD\OS2PC -Q ..\APPS\GITCLI.PAS ..\BUILD\CD\GITCLI.EXE
IF NOT EXIST ..\BUILD\CD\GITCLI.EXE GOTO ERREUR
..\BUILD\OS2PC -Q ..\APPS\SVNCLI.PAS ..\BUILD\CD\SVNCLI.EXE
IF NOT EXIST ..\BUILD\CD\SVNCLI.EXE GOTO ERREUR
ECHO == Serveur Web (OS2PC : APPS\WEBSRV.PAS, HTTP/HTTPS, PSP, ASP, PHP, console dans le style d'IIS)
..\BUILD\OS2PC -Q ..\APPS\WEBSRV.PAS ..\BUILD\CD\WEBSRV.EXE
IF NOT EXIST ..\BUILD\CD\WEBSRV.EXE GOTO ERREUR
ECHO == Web Developer (OS2PC : APPS\WEBDEV.PAS, editeur de pages Web dans le genre de HomeSite)
..\BUILD\OS2PC -Q ..\APPS\WEBDEV.PAS ..\BUILD\CD\WEBDEV.EXE
IF NOT EXIST ..\BUILD\CD\WEBDEV.EXE GOTO ERREUR
ECHO == SQL Developer (OS2PC : APPS\SQLDEV.PAS, PostgreSQL, MariaDB/MySQL, .MDF par SQLCMD, dBASE, CSV, Clarion, Btrieve, MyISAM)
..\BUILD\OS2PC -Q ..\APPS\SQLDEV.PAS ..\BUILD\CD\SQLDEV.EXE
IF NOT EXIST ..\BUILD\CD\SQLDEV.EXE GOTO ERREUR
ECHO == Virtualisation (OS2PC : APPS\VIRTUAL.PAS, AMD-V, Intel VT-x ou mode V86)
..\BUILD\OS2PC -Q ..\APPS\VIRTUAL.PAS ..\BUILD\CD\VIRTUAL.EXE
IF NOT EXIST ..\BUILD\CD\VIRTUAL.EXE GOTO ERREUR
ECHO == Session DOS : TESTVDM.EXE (programme MS-DOS 16 bits, OS2PC -CD)
..\BUILD\OS2PC -Q -CD ..\DLL\TESTVDM.PAS ..\BUILD\CD\TESTVDM.EXE
COPY ..\IMAGE\SONS\*.WAV ..\BUILD\CD > NUL
COPY ..\IMAGE\MUSIQUE\*.MP3 ..\BUILD\CD > NUL
COPY ..\IMAGE\NOTATOR\*.SON ..\BUILD\CD > NUL
COPY ..\IMAGE\NOTATOR\*.MID ..\BUILD\CD > NUL
COPY ..\IMAGE\NOTATOR\NOTATOR.TXT ..\BUILD\CD > NUL
COPY ..\IMAGE\SYSTEM\CONFIG.SYS ..\BUILD\CD\CONFIG.SYS > NUL
ECHO == CD-ROM amorcable
..\BUILD\MAKEISO ..\IMAGE\OS2CD.ISO /BOOT:..\BUILD\CD\OS2BOOT /LABEL:OS2_0 ..\BUILD\CD\*.*
IF ERRORLEVEL 1 GOTO ERREUR
FOR %%F IN (OS2BOOT OS2LDR OS2KRNL CMD.EXE PMSHELL.EXE LAUNCHPD.EXE DOSCALLS.DLL FKA.DLL HPFS.IFS NTFS.IFS SMB.IFS OPENGL.DLL VIOCALLS.DLL MOUCALLS.DLL NLS.DLL KBDCALLS.DLL MONCALLS.DLL MSG.DLL NAMPIPES.DLL SESMGR.DLL QUECALLS.DLL SPOOLCP.DLL RMINFO.DLL OS2SM.DLL HELPMGR.DLL LIBUNI.DLL PMDRAG.DLL PMWIN.DLL PMGPI.DLL PMMERGE.DLL PMPIC.DLL PMSHAPI.DLL PMSPL.DLL PMVIOP.DLL API16.DLL PMWP.DLL PMCTLS.DLL MDM.DLL SBAUDIO.DLL ICHAUDIO.DLL ESAUDIO.DLL VBOXGST.DLL VMWTOOLS.DLL TCPIP32.DLL TLS32.DLL E1000.DLL PCNET.DLL) DO COPY ..\BUILD\CD\%%F ..\IMAGE\SYSTEM > NUL
ECHO == CD-ROM d'installation (PROTSHELL=C:\INSTALL.EXE)
IF NOT EXIST ..\BUILD\CDINST MD ..\BUILD\CDINST
COPY ..\BUILD\CD\*.* ..\BUILD\CDINST > NUL
COPY ..\IMAGE\INSTALL\CONFIG.SYS ..\BUILD\CDINST\CONFIG.SYS > NUL
..\BUILD\MAKEISO ..\IMAGE\OS2INST.ISO /BOOT:..\BUILD\CDINST\OS2BOOT /LABEL:OS2_0_INSTALL ..\BUILD\CDINST\*.*
IF ERRORLEVEL 1 GOTO ERREUR
ECHO Termine : ..\IMAGE\OS2CD.ISO et ..\IMAGE\OS2INST.ISO
GOTO FIN
:ERREUR
ECHO Echec de la construction.
:FIN
