Type
  PByte = ^Byte;

Procedure WrB(A, V : LongInt);
Var Q : PByte;
Begin
  Q := Pointer(A);
  Q^ := V;
End;

Function RdB(A : LongInt) : LongInt;
Var Q : PByte;
Begin
  Q := Pointer(A);
  RdB := Q^;
End;

Procedure WrW(A, V : LongInt);
Begin
  WrB(A, V And 255);
  WrB(A + 1, (V Shr 8) And 255);
End;

Function RdL(A : LongInt) : LongInt;
Begin
  RdL := RdB(A) Or (RdB(A + 1) Shl 8) Or (RdB(A + 2) Shl 16) Or (RdB(A + 3) Shl 24);
End;

Procedure PutZ(A : LongInt; S : String);
Var K : LongInt;
Begin
  For K := 1 To Length(S) Do WrB(A + K - 1, Ord(S[K]));
  WrB(A + Length(S), 0);
End;

Function Z(S : String) : LongInt;
Begin
  PutZ(LongInt(@NameZ), S);
  Z := LongInt(@NameZ);
End;

Function Z2(S : String) : LongInt;
Begin
  PutZ(LongInt(@NameZ2), S);
  Z2 := LongInt(@NameZ2);
End;

Function IStr(V : LongInt) : String;
Var S : String;
Begin
  Str(V, S);
  IStr := S;
End;

Function Lo16(V : LongInt) : LongInt;
Begin
  Lo16 := V And $FFFF;
End;

Function Hi16(V : LongInt) : LongInt;
Begin
  Hi16 := (V Shr 16) And $FFFF;
End;

Function S16(V : LongInt) : LongInt;
Begin
  V := V And $FFFF;
  If V >= $8000 Then V := V - $10000;
  S16 := V;
End;

Function Rnd(N : LongInt) : LongInt;
Begin
  Seed := (Seed * 1103515245 + 12345) And $7FFFFFFF;
  Rnd := (Seed Shr 8) Mod N;
End;

Function WinGetPS(H : LongInt) : LongInt; External 'PMWIN';
Function WinReleasePS(Hps : LongInt) : LongInt; External 'PMWIN';

Function Ask(Text, Cap : String; Fl : LongInt) : LongInt;
Begin
  Ask := WinMessageBox(HWND_DESKTOP, FrameW, Z(Text), Z2(Cap), 0, Fl Or MB_MOVEABLE);
End;



Function MinI(A, B : LongInt) : LongInt;
Begin
  If A < B Then MinI := A Else MinI := B;
End;

Function MaxI(A, B : LongInt) : LongInt;
Begin
  If A > B Then MaxI := A Else MaxI := B;
End;

Function UpS(S : String) : String;
Var K : LongInt;
Begin
  For K := 1 To Length(S) Do S[K] := UpCase(S[K]);
  UpS := S;
End;

Function TrimS(S : String) : String;
Begin
  While (S <> '') And (S[1] <= ' ') Do Delete(S, 1, 1);
  While (S <> '') And (S[Length(S)] <= ' ') Do Delete(S, Length(S), 1);
  TrimS := S;
End;

Function GetZ(A : LongInt) : String;
Var S : String; C : LongInt;
Begin
  S := '';
  C := RdB(A);
  While (C <> 0) And (Length(S) < 255) Do
  Begin
    S := S + Chr(C);
    Inc(A);
    C := RdB(A);
  End;
  GetZ := S;
End;

{ nom du fichier (sans le dossier) ; dossier (avec le \ final) }
Function BaseName(S : String) : String;
Var K : LongInt;
Begin
  K := Length(S);
  While (K > 0) And (S[K] <> '\') And (S[K] <> ':') And (S[K] <> '/') Do Dec(K);
  BaseName := Copy(S, K + 1, 255);
End;

Function DirName(S : String) : String;
Var K : LongInt;
Begin
  K := Length(S);
  While (K > 0) And (S[K] <> '\') And (S[K] <> ':') And (S[K] <> '/') Do Dec(K);
  DirName := Copy(S, 1, K);
End;

Function ExtOf(S : String) : String;
Var K : LongInt;
Begin
  S := BaseName(S);
  K := Length(S);
  While (K > 0) And (S[K] <> '.') Do Dec(K);
  If K = 0 Then ExtOf := '' Else ExtOf := UpS(Copy(S, K, 10));
End;

{ temps m:ss (ou h:mm:ss) }
Function TimeStr(Ms : LongInt) : String;
Var S, M, H : LongInt; R : String;
Begin
  If Ms < 0 Then
  Begin
    TimeStr := '--:--';
    Exit;
  End;
  S := Ms Div 1000;
  H := S Div 3600; M := (S Div 60) Mod 60; S := S Mod 60;
  If H > 0 Then R := IStr(H) + ':' + Chr(48 + M Div 10) + Chr(48 + M Mod 10)
  Else R := IStr(M);
  R := R + ':' + Chr(48 + S Div 10) + Chr(48 + S Mod 10);
  TimeStr := R;
End;

{ caracteres accentues : Latin-1 (ID3, M3U) -> page de codes 850 de PM }
Const
  Lat2Cp : Array[160..255] Of Byte = (
    255,173,189,156,207,190,221,245,249,184,166,174,170,240,169,238,
    248,241,253,252,239,230,244,250,247,251,167,175,172,171,243,168,
    183,181,182,199,142,143,146,128,212,144,210,211,222,214,215,216,
    209,165,227,224,226,229,153,158,157,235,233,234,154,237,232,225,
    133,160,131,198,132,134,145,135,138,130,136,137,141,161,140,139,
    208,164,149,162,147,228,148,246,155,151,163,150,129,236,231,152);

Function Cp850(C : LongInt) : Char;
Begin
  If C < 128 Then Cp850 := Chr(C)
  Else If C < 160 Then Cp850 := '?'
  Else Cp850 := Chr(Lat2Cp[C]);
End;
{ texte Latin-1 (etiquettes ID3, listes M3U) -> page de codes de PM }
Function L1(S : String) : String;
Var K : LongInt;
Begin
  For K := 1 To Length(S) Do
    If Ord(S[K]) >= 160 Then S[K] := Cp850(Ord(S[K]));
  L1 := S;
End;

{ textes du programme : ^e e aigu, ^E E aigu, ^g e grave, ^x e circonflexe,
  ^a a grave, ^A A grave, ^o o circonflexe, ^c c cedille, ^0 degre }
Function Acc(S : String) : String;
Var K : LongInt; R : String;
Begin
  R := '';
  K := 1;
  While K <= Length(S) Do
  Begin
    If (S[K] = '^') And (K < Length(S)) Then
    Begin
      Inc(K);
      Case S[K] Of
        'e' : R := R + Chr(130);
        'E' : R := R + Chr(144);
        'g' : R := R + Chr(138);
        'x' : R := R + Chr(136);
        'a' : R := R + Chr(133);
        'A' : R := R + Chr(183);
        'o' : R := R + Chr(147);
        'c' : R := R + Chr(135);
        '0' : R := R + Chr(248);
      Else R := R + S[K];
      End;
    End
    Else R := R + S[K];
    Inc(K);
  End;
  Acc := R;
End;

Function OpenRead(P : String) : LongInt;
Var H, Act : LongInt;
Begin
  H := 0;
  If DosOpen(Z(P), LongInt(@H), LongInt(@Act), 0, 0, 1, $40, 0) <> 0 Then H := 0;
  OpenRead := H;
End;

Function FileLen(H : LongInt) : LongInt;
Var L : LongInt;
Begin
  L := 0;
  If DosSetFilePtr(H, 0, 2, LongInt(@L)) <> 0 Then L := 0;
  FileLen := L;
End;

Function ReadBuf(H, Ofs, Buf, N : LongInt) : LongInt;
Var A, P : LongInt;
Begin
  A := 0;
  If DosSetFilePtr(H, Ofs, 0, LongInt(@P)) = 0 Then
    If DosRead(H, Buf, N, LongInt(@A)) <> 0 Then A := 0;
  ReadBuf := A;
End;

{ ==================================================================== }
{ Informations d'un fichier MP3 : etiquettes ID3, duree                 }
{ ==================================================================== }

Var
  InfoBuf : Array[0..16383] Of Byte;
  InfTitle, InfArtist, InfAlbum : String;

{ texte d'une trame ID3v2 (codage : 0 Latin-1, 1 UTF-16 avec BOM, 2 UTF-16BE,
  3 UTF-8) }
Function Id3Text(P, N : LongInt) : String;
Var S : String; Enc, K, C, C2, BE : LongInt;
Begin
  S := '';
  If N < 1 Then
  Begin
    Id3Text := '';
    Exit;
  End;
  Enc := InfoBuf[P];
  K := P + 1;
  If (Enc = 1) Or (Enc = 2) Then
  Begin
    BE := Ord(Enc = 2);
    If (K + 1 < P + N) And (InfoBuf[K] = $FE) And (InfoBuf[K + 1] = $FF) Then Begin BE := 1; K := K + 2; End
    Else If (K + 1 < P + N) And (InfoBuf[K] = $FF) And (InfoBuf[K + 1] = $FE) Then Begin BE := 0; K := K + 2; End;
    While (K + 1 < P + N) And (Length(S) < 95) Do
    Begin
      If BE = 1 Then C := InfoBuf[K] * 256 + InfoBuf[K + 1] Else C := InfoBuf[K] + InfoBuf[K + 1] * 256;
      If C = 0 Then Break;
      If C < 256 Then S := S + Cp850(C) Else S := S + '?';
      K := K + 2;
    End;
  End
  Else
    While (K < P + N) And (Length(S) < 95) Do
    Begin
      C := InfoBuf[K];
      If C = 0 Then Break;
      If (Enc = 3) And (C >= $C0) And (K + 1 < P + N) Then
      Begin
        C2 := InfoBuf[K + 1];
        If (C And $E0) = $C0 Then
        Begin
          C := ((C And $1F) Shl 6) Or (C2 And $3F);
          Inc(K);
        End
        Else
        Begin
          C := 63;
          While (K + 1 < P + N) And ((InfoBuf[K + 1] And $C0) = $80) Do Inc(K);
        End;
      End;
      If C < 256 Then S := S + Cp850(C) Else S := S + '?';
      Inc(K);
    End;
  Id3Text := TrimS(S);
End;

Function Id3v1Field(P, N : LongInt) : String;
Var S : String; K : LongInt;
Begin
  S := '';
  For K := P To P + N - 1 Do
  Begin
    If InfoBuf[K] = 0 Then Break;
    S := S + Cp850(InfoBuf[K]);
  End;
  Id3v1Field := TrimS(S);
End;

{ en-tete d'une trame MP3 aux octets B0..B3 : taille, frequence, echantillons
  par trame (0 : pas un en-tete valide) }
Function HdrSize(B0, B1, B2, B3 : LongInt; Var Rate, Spf, Kbps, Ch : LongInt) : LongInt;
Const
  Rates : Array[0..2] Of LongInt = (44100, 48000, 32000);
  BR1 : Array[0..14] Of LongInt = (0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320);
  BR2 : Array[0..14] Of LongInt = (0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160);
Var Ver, Bi, Fi : LongInt;
Begin
  HdrSize := 0;
  If (B0 <> 255) Or ((B1 And $E0) <> $E0) Then Exit;
  Ver := (B1 Shr 3) And 3;
  If Ver = 1 Then Exit;
  If ((B1 Shr 1) And 3) <> 1 Then Exit;
  Bi := B2 Shr 4; Fi := (B2 Shr 2) And 3;
  If (Bi = 0) Or (Bi = 15) Or (Fi = 3) Then Exit;
  Rate := Rates[Fi];
  If Ver = 3 Then
  Begin
    Kbps := BR1[Bi]; Spf := 1152;
  End
  Else
  Begin
    Kbps := BR2[Bi]; Spf := 576;
    If Ver = 2 Then Rate := Rate Div 2 Else Rate := Rate Div 4;
  End;
  If (B3 Shr 6) = 3 Then Ch := 1 Else Ch := 2;
  HdrSize := (Spf Div 8) * Kbps * 1000 Div Rate + ((B2 Shr 1) And 1);
End;

{ titre, artiste, album, duree (ms) d'un fichier MP3, sans le decoder }
Function MP3Info(P : String; Var Dur : LongInt) : Boolean;
Var H, Len, N, Ps, Tag, Sz, Id, Fsz, K, Rate, Spf, Kbps, Ch, Fs, Xo, Frm, V2, AudEnd : LongInt;
  FId : String[4];
Begin
  MP3Info := False;
  InfTitle := ''; InfArtist := ''; InfAlbum := ''; Dur := -1;
  H := OpenRead(P);
  If H = 0 Then Exit;
  Len := FileLen(H);
  AudEnd := Len;
  { ID3v1 a la fin }
  If Len >= 128 Then
    If ReadBuf(H, Len - 128, LongInt(@InfoBuf), 128) = 128 Then
      If (InfoBuf[0] = Ord('T')) And (InfoBuf[1] = Ord('A')) And (InfoBuf[2] = Ord('G')) Then
      Begin
        InfTitle := Id3v1Field(3, 30); InfArtist := Id3v1Field(33, 30); InfAlbum := Id3v1Field(63, 30);
        AudEnd := Len - 128;
      End;
  N := ReadBuf(H, 0, LongInt(@InfoBuf), SizeOf(InfoBuf));
  Ps := 0;
  { ID3v2 au debut (prioritaire) }
  If (N >= 10) And (InfoBuf[0] = Ord('I')) And (InfoBuf[1] = Ord('D')) And (InfoBuf[2] = Ord('3')) Then
  Begin
    V2 := InfoBuf[3];
    Tag := ((InfoBuf[6] And 127) Shl 21) Or ((InfoBuf[7] And 127) Shl 14) Or ((InfoBuf[8] And 127) Shl 7) Or
           (InfoBuf[9] And 127);
    K := 10;
    While (K + 10 <= MinI(N, Tag + 10)) Do
    Begin
      If V2 = 2 Then
      Begin
        FId := Chr(InfoBuf[K]) + Chr(InfoBuf[K + 1]) + Chr(InfoBuf[K + 2]);
        Fsz := (InfoBuf[K + 3] Shl 16) Or (InfoBuf[K + 4] Shl 8) Or InfoBuf[K + 5];
        Id := 6;
      End
      Else
      Begin
        FId := Chr(InfoBuf[K]) + Chr(InfoBuf[K + 1]) + Chr(InfoBuf[K + 2]) + Chr(InfoBuf[K + 3]);
        If V2 = 4 Then
          Fsz := ((InfoBuf[K + 4] And 127) Shl 21) Or ((InfoBuf[K + 5] And 127) Shl 14) Or
                 ((InfoBuf[K + 6] And 127) Shl 7) Or (InfoBuf[K + 7] And 127)
        Else
          Fsz := (InfoBuf[K + 4] Shl 24) Or (InfoBuf[K + 5] Shl 16) Or (InfoBuf[K + 6] Shl 8) Or InfoBuf[K + 7];
        Id := 10;
      End;
      If (InfoBuf[K] = 0) Or (Fsz <= 0) Then Break;
      If K + Id + Fsz <= N Then
      Begin
        If (FId = 'TIT2') Or (FId = 'TT2') Then InfTitle := Id3Text(K + Id, Fsz)
        Else If (FId = 'TPE1') Or (FId = 'TP1') Then InfArtist := Id3Text(K + Id, Fsz)
        Else If (FId = 'TALB') Or (FId = 'TAL') Then InfAlbum := Id3Text(K + Id, Fsz);
      End;
      K := K + Id + Fsz;
    End;
    Ps := Tag + 10;
    If (V2 = 4) And ((InfoBuf[5] And $10) <> 0) Then Ps := Ps + 10;
    N := ReadBuf(H, Ps, LongInt(@InfoBuf), SizeOf(InfoBuf));
  End
  Else Ps := 0;
  { premiere trame (recherche de la synchronisation) }
  K := 0; Fs := 0;
  While K + 4 <= N Do
  Begin
    Fs := HdrSize(InfoBuf[K], InfoBuf[K + 1], InfoBuf[K + 2], InfoBuf[K + 3], Rate, Spf, Kbps, Ch);
    If (Fs > 0) And (K + Fs + 4 <= N) Then
      If HdrSize(InfoBuf[K + Fs], InfoBuf[K + Fs + 1], InfoBuf[K + Fs + 2], InfoBuf[K + Fs + 3], Rate, Spf, Kbps,
                 Ch) > 0 Then Break;
    If (Fs > 0) And (K + Fs + 4 > N) Then Break;
    Fs := 0;
    Inc(K);
  End;
  If Fs > 0 Then
  Begin
    Fs := HdrSize(InfoBuf[K], InfoBuf[K + 1], InfoBuf[K + 2], InfoBuf[K + 3], Rate, Spf, Kbps, Ch);
    { en-tete Xing / Info (debit variable) : nombre de trames }
    If Spf = 1152 Then
    Begin
      If Ch = 2 Then Xo := 36 Else Xo := 21;
    End
    Else If Ch = 2 Then Xo := 21 Else Xo := 13;
    Frm := 0;
    If K + Xo + 12 <= N Then
      If ((InfoBuf[K + Xo] = Ord('X')) And (InfoBuf[K + Xo + 1] = Ord('i')) And (InfoBuf[K + Xo + 2] = Ord('n'))) Or
         ((InfoBuf[K + Xo] = Ord('I')) And (InfoBuf[K + Xo + 1] = Ord('n')) And (InfoBuf[K + Xo + 2] = Ord('f'))) Then
        If (InfoBuf[K + Xo + 7] And 1) <> 0 Then
          Frm := (InfoBuf[K + Xo + 8] Shl 24) Or (InfoBuf[K + Xo + 9] Shl 16) Or (InfoBuf[K + Xo + 10] Shl 8) Or
                 InfoBuf[K + Xo + 11];
    If Frm > 0 Then Dur := Round(Frm * 1.0 * Spf * 1000 / Rate)
    Else If Kbps > 0 Then Dur := Round((AudEnd - Ps - K) * 8.0 / Kbps);
    MP3Info := True;
  End;
  Dummy := DosClose(H);
End;

{ titre affiche : "Artiste - Titre", sinon le nom du fichier sans .MP3 }
Function MakeTitle(P : String) : String;
Var S : String;
Begin
  S := InfTitle;
  If (S <> '') And (InfArtist <> '') Then S := InfArtist + ' - ' + S;
  If S = '' Then
  Begin
    S := BaseName(P);
    If UpS(Copy(S, Length(S) - 3, 4)) = '.MP3' Then S := Copy(S, 1, Length(S) - 4);
  End;
  If Length(S) > 95 Then S := Copy(S, 1, 95);
  MakeTitle := S;
End;

{ ==================================================================== }
{ Liste de lecture                                                      }
{ ==================================================================== }

Procedure PlGrow;
Var NP : PPlArr; NC, K : LongInt;
Begin
  { la liste n'a pas de taille maximale : le tableau des pointeurs double
    quand il est plein, tant qu'il reste de la memoire }
  If PlN < PlCap Then Exit;
  NC := PlCap * 2;
  If NC < 256 Then NC := 256;
  GetMem(NP, NC * 4);
  For K := 0 To PlN - 1 Do NP^[K] := Pl^[K];
  If PlCap > 0 Then FreeMem(Pl, PlCap * 4);
  Pl := NP; PlCap := NC;
End;

Procedure PlAdd(P, T : String; Dur : LongInt);
Var E : PPlEntry;
Begin
  PlGrow;
  New(E);
  E^.Path := P;
  If T = '' Then
  Begin
    If MP3Info(P, Dur) Then ;
    T := MakeTitle(P);
  End;
  E^.Title := T; E^.Dur := Dur; E^.Played := False;
  Pl^[PlN] := E;
  Inc(PlN);
End;

Procedure PlDelete(I : LongInt);
Var K : LongInt;
Begin
  If (I < 0) Or (I >= PlN) Then Exit;
  Dispose(Pl^[I]);
  For K := I To PlN - 2 Do Pl^[K] := Pl^[K + 1];
  Dec(PlN);
  If PlCur = I Then PlCur := -1 Else If PlCur > I Then Dec(PlCur);
  If PlSel >= PlN Then PlSel := PlN - 1;
End;

Procedure PlClear;
Begin
  While PlN > 0 Do
  Begin
    Dispose(Pl^[PlN - 1]);
    Dec(PlN);
  End;
  PlCur := -1; PlSel := -1; PlTop := 0;
End;

Procedure PlSwap(A, B : LongInt);
Var E : PPlEntry;
Begin
  E := Pl^[A]; Pl^[A] := Pl^[B]; Pl^[B] := E;
  If PlCur = A Then PlCur := B Else If PlCur = B Then PlCur := A;
End;

Function PlTotal : LongInt;
Var K, T : LongInt;
Begin
  T := 0;
  For K := 0 To PlN - 1 Do If Pl^[K]^.Dur > 0 Then T := T + Pl^[K]^.Dur Div 1000;
  PlTotal := T;
End;

{ fichier MP3 ou liste M3U ajoute(e) a la liste }
Procedure AddPath(P : String); Forward;

{ lignes d'un fichier texte (M3U) : Proc appelee pour chaque ligne }
Var
  M3uDur : LongInt;
  M3uTitle : String;

Procedure LoadM3U(P : String);
Var H, N, K, Ps, Base, D : LongInt; Line, Dir, F : String; B : Array[0..4095] Of Byte; C : Char;
Begin
  H := OpenRead(P);
  If H = 0 Then Exit;
  Dir := DirName(P);
  M3uDur := -1; M3uTitle := '';
  Line := ''; Base := 0;
  Repeat
    N := ReadBuf(H, Base, LongInt(@B), SizeOf(B));
    For K := 0 To N - 1 Do
    Begin
      C := Chr(B[K]);
      If (C = #10) Or (C = #13) Then
      Begin
        Line := TrimS(Line);
        If Copy(Line, 1, 8) = '#EXTINF:' Then
        Begin
          Ps := 9; D := 0;
          While (Ps <= Length(Line)) And (Line[Ps] In ['0'..'9']) Do
          Begin
            D := D * 10 + Ord(Line[Ps]) - 48;
            Inc(Ps);
          End;
          M3uDur := D * 1000;
          While (Ps <= Length(Line)) And (Line[Ps] <> ',') Do Inc(Ps);
          M3uTitle := L1(TrimS(Copy(Line, Ps + 1, 255)));
        End
        Else If (Line <> '') And (Line[1] <> '#') Then
        Begin
          F := Line;
          If (Pos(':', F) = 0) And (Copy(F, 1, 1) <> '\') Then F := Dir + F;
          If UpS(ExtOf(F)) = '.MP3' Then
          Begin
            If M3uTitle <> '' Then PlAdd(F, Copy(M3uTitle, 1, 95), M3uDur) Else PlAdd(F, '', -1);
          End;
          M3uDur := -1; M3uTitle := '';
        End;
        Line := '';
      End
      Else If Length(Line) < 255 Then Line := Line + C;
    End;
    Base := Base + N;
  Until N < SizeOf(B);
  Dummy := DosClose(H);
End;

{ Latin-1 pour les fichiers M3U (lisibles ailleurs) }
Function ToLat1(S : String) : String;
Var K, C : LongInt;
Begin
  For K := 1 To Length(S) Do
    If Ord(S[K]) >= 128 Then
      For C := 160 To 255 Do
        If Lat2Cp[C] = Ord(S[K]) Then
        Begin
          S[K] := Chr(C);
          Break;
        End;
  ToLat1 := S;
End;

Procedure WLine(H : LongInt; S : String);
Var W : LongInt;
Begin
  S := S + #13#10;
  Dummy := DosWrite(H, LongInt(@S[1]), Length(S), LongInt(@W));
End;

Function SaveM3U(P : String) : Boolean;
Var H, Act, K : LongInt;
Begin
  SaveM3U := False;
  H := 0;
  If DosOpen(Z(P), LongInt(@H), LongInt(@Act), 0, 0, $12, $41, 0) <> 0 Then Exit;
  WLine(H, '#EXTM3U');
  For K := 0 To PlN - 1 Do
  Begin
    WLine(H, '#EXTINF:' + IStr(Pl^[K]^.Dur Div 1000) + ',' + ToLat1(Pl^[K]^.Title));
    WLine(H, Pl^[K]^.Path);
  End;
  Dummy := DosClose(H);
  SaveM3U := True;
End;

Procedure AddPath(P : String);
Begin
  If ExtOf(P) = '.M3U' Then LoadM3U(P) Else PlAdd(P, '', -1);
End;

{ tous les MP3 d'un dossier (ordre alphabetique) }
Procedure AddDir(Dir : String);
Var H, N, K, J, A, First : LongInt; S : String; Fb : Array[0..299] Of Byte;
Begin
  { tous les .MP3 du dossier (sans limite), puis tri par nom de ces
    nouveaux morceaux seulement }
  First := PlN;
  H := -1; N := 1;
  If DosFindFirst(Z(Dir + '*.*'), LongInt(@H), $27, LongInt(@Fb), 300, LongInt(@N), 1) = 0 Then
  Begin
    Repeat
      A := RdL(LongInt(@Fb) + 24);
      S := '';
      For K := 0 To Fb[28] - 1 Do S := S + Chr(Fb[29 + K]);
      If ((A And $10) = 0) And (ExtOf(S) = '.MP3') Then PlAdd(Dir + S, '', -1);
      N := 1;
    Until DosFindNext(H, LongInt(@Fb), 300, LongInt(@N)) <> 0;
    Dummy := DosFindClose(H);
  End;
  For K := First + 1 To PlN - 1 Do
    For J := K DownTo First + 1 Do
      If UpS(Pl^[J]^.Path) < UpS(Pl^[J - 1]^.Path) Then PlSwap(J - 1, J)
      Else Break;
End;

