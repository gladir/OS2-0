{ Clavier                                                               }
{ ==================================================================== }

Function KeyChar(Mp1, Mp2 : LongInt) : Boolean;
Var Fl, Vk, C : LongInt;
Begin
  KeyChar := True;
  Fl := Lo16(Mp1);
  If (Fl And KC_KEYUP) <> 0 Then Exit;
  Vk := Hi16(Mp2); C := Lo16(Mp2);
  If (Fl And KC_VIRTUALKEY) <> 0 Then
  Begin
    Case Vk Of
      VK_SPACE : Begin Command(CM_PLAY); Exit; End;
      VK_LEFT : Begin Command(CM_BACK); Exit; End;
      VK_RIGHT : Begin Command(CM_FWD); Exit; End;
      VK_PAGEUP : Begin Command(CM_PREV); Exit; End;
      VK_PAGEDOWN : Begin Command(CM_NEXT); Exit; End;
      VK_UP : Begin If PlSel > 0 Then Dec(PlSel) Else If (PlSel < 0) And (PlN > 0) Then PlSel := 0;
                EnsureVisible; RedrawList; Exit; End;
      VK_DOWN : Begin If PlSel < PlN - 1 Then Inc(PlSel); EnsureVisible; RedrawList; Exit; End;
      VK_HOME : Begin If PlN > 0 Then PlSel := 0; EnsureVisible; RedrawList; Exit; End;
      VK_END : Begin PlSel := PlN - 1; EnsureVisible; RedrawList; Exit; End;
      VK_NEWLINE, VK_ENTER : Begin Command(CM_PLAYSEL); Exit; End;
      VK_DELETE : Begin Command(CM_REMOVE); Exit; End;
      VK_F1 : Begin Command(CM_HELP); Exit; End;
    End;
  End;
  If (Fl And KC_CHAR) <> 0 Then
  Begin
    If (Fl And KC_CTRL) <> 0 Then
    Begin
      C := C And $1F;
      If C = 15 Then Begin Command(CM_OPEN); Exit; End;    { Ctrl+O }
      If C = 1 Then Begin Command(CM_ADDFILES); Exit; End;  { Ctrl+A }
    End;
    Case UpCase(Chr(C And 255)) Of
      'S' : Begin Command(CM_STOP); Exit; End;
      'P' : Begin Command(CM_PLAY); Exit; End;
      '+', '=' : Begin VolumeV := MinI(100, VolumeV + 5); Dummy := MdmVolume(VolumeV);
                   BeginDraw; DrawVolume; EndDraw; Exit; End;
      '-' : Begin VolumeV := MaxI(0, VolumeV - 5); Dummy := MdmVolume(VolumeV);
              BeginDraw; DrawVolume; EndDraw; Exit; End;
      'E' : Begin Command(CM_EQON); Exit; End;
    End;
  End;
  KeyChar := False;
End;

Function MainProc(H, Msg0, Mp1, Mp2 : LongInt) : LongInt;
Var Rc : Array[0..3] Of LongInt;
Begin
  MainProc := 0;
  Case Msg0 Of
    WM_SIZE :
      Begin
        Dummy := WinQueryWindowRect(H, LongInt(@Rc));
        CW := Rc[2]; CH := Rc[3];
      End;
    WM_PAINT : PaintAll(H);
    WM_TIMER : If Lo16(Mp1) = 1 Then TimerTick;
    WM_BUTTON1DOWN :
      Begin
        Dummy := WinSetFocus(HWND_DESKTOP, H);
        Click(S16(Mp1), S16(Mp1 Shr 16), False);
        MainProc := 1;
      End;
    WM_BUTTON1DBLCLK :
      Begin
        Click(S16(Mp1), S16(Mp1 Shr 16), True);
        MainProc := 1;
      End;
    WM_BUTTON1UP :
      Begin
        Release(S16(Mp1), S16(Mp1 Shr 16));
        MainProc := 1;
      End;
    WM_MOUSEMOVE :
      Begin
        If Drag <> 0 Then DragTo(S16(Mp1), CH - 1 - S16(Mp1 Shr 16));
        MainProc := WinDefWindowProc(H, Msg0, Mp1, Mp2);
      End;
    WM_COMMAND : Command(Lo16(Mp1));
    WM_INITMENU : MenuUp := 1;
    WM_MENUEND : MenuUp := 0;
    WM_FILEDONE : FileDone(Mp1);
    WM_CHAR :
      If Not KeyChar(Mp1, Mp2) Then MainProc := WinDefWindowProc(H, Msg0, Mp1, Mp2) Else MainProc := 1;
    WM_CLOSE : Dummy := WinPostMsg(H, WM_QUIT, 0, 0);
  Else
    MainProc := WinDefWindowProc(H, Msg0, Mp1, Mp2);
  End;
End;

