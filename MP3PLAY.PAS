Function PosFromX(X : LongInt) : LongInt;
Begin
  If TrackDur <= 0 Then PosFromX := 0
  Else PosFromX := Round(MaxI(0, MinI(DX1 - DX0 - 16, X - DX0 - 8)) * 1.0 * TrackDur / (DX1 - DX0 - 16));
End;

Procedure DragTo(X, Y : LongInt);
Var V, K : LongInt;
Begin
  Case Drag Of
    1 :
      Begin
        DragV := PosFromX(X);
        BeginDraw; DrawPosition; DrawTime; EndDraw;
      End;
    2 :
      Begin
        VolumeV := MaxI(0, MinI(100, Round((X - DX0 - 70) * 100.0 / 160)));
        Dummy := MdmVolume(VolumeV);
        BeginDraw; DrawVolume; EndDraw;
      End;
    3 :
      Begin
        V := MaxI(0, MinI(100, Round((X - DX0 - 384) * 100.0 / 120)));
        If Abs(V - 50) <= 3 Then V := 50;
        Balance := V - 50;
        BeginDraw; DrawVolume; EndDraw;
      End;
    4 :
      If PlN > NRows Then
      Begin
        K := Round((Y - LY0 - 19 - DragV) * 1.0 * MaxI(PlN, NRows) / (LY1 - LY0 - 38));
        PlTop := MaxI(0, MinI(PlN - NRows, K));
        RedrawList;
      End;
  Else
    If (Drag >= 10) And (Drag <= 20) Then
    Begin
      V := 12 - Round((Y - SY0) * 24.0 / (SY1 - SY0));
      V := MaxI(-12, MinI(12, V));
      If Drag = 10 Then EqPre := V Else EqBand[Drag - 11] := V;
      EqDirty := 1;
      BeginDraw; DrawEqSlider(Drag - 10); EndDraw;
    End;
  End;
End;

Function InR(X, Y, X1, Y1, X2, Y2 : LongInt) : Boolean;
Begin
  InR := (X >= X1) And (X <= X2) And (Y >= Y1) And (Y <= Y2);
End;

Procedure Click(Px, Py : LongInt; Dbl : Boolean);
Var X, Y, I, X1, X2, R : LongInt;
Begin
  X := Px; Y := CH - 1 - Py;
  Drag := 0; BtnDown := -1;
  { afficheur : temps ecoule / restant }
  If InR(X, Y, DX0, DY0, 170, DY1) Then
  Begin
    ShowRemain := 1 - ShowRemain;
    SetMarks;
    BeginDraw; DrawTime; EndDraw;
    Exit;
  End;
  If InR(X, Y, DX0, PY0, DX1, PY1) Then
  Begin
    If (PState <> 0) And (TrackDur > 0) Then
    Begin
      Drag := 1;
      Dummy := WinSetCapture(HWND_DESKTOP, Client);
      DragTo(X, Y);
    End;
    Exit;
  End;
  If (Y >= BY0) And (Y <= BY1) Then
    For I := 0 To 9 Do
    Begin
      BtnRect(I, X1, X2);
      If (X >= X1) And (X <= X2) Then
      Begin
        BtnDown := I;
        Dummy := WinSetCapture(HWND_DESKTOP, Client);
        BeginDraw; DrawButton(I); EndDraw;
        Exit;
      End;
    End;
  If InR(X, Y, DX0 + 62, VY0, DX0 + 238, VY1) Then
  Begin
    Drag := 2;
    Dummy := WinSetCapture(HWND_DESKTOP, Client);
    DragTo(X, Y);
    Exit;
  End;
  If InR(X, Y, DX0 + 376, VY0, DX0 + 512, VY1) Then
  Begin
    Drag := 3;
    Dummy := WinSetCapture(HWND_DESKTOP, Client);
    DragTo(X, Y);
    Exit;
  End;
  If InR(X, Y, DX0, TY0, DX0 + 150, TY1) Then Begin Command(CM_SHOWLIST); Exit; End;
  If InR(X, Y, DX0 + 152, TY0, DX0 + 262, TY1) Then Begin Command(CM_SHOWEQ); Exit; End;
  If Tab = 0 Then
  Begin
    { lignes de la liste }
    If InR(X, Y, LX0, LY0 + 19, LX1, LY1) Then
    Begin
      I := PlTop + (Y - LY0 - 20) Div RowH;
      If (I >= 0) And (I < PlN) Then
      Begin
        PlSel := I;
        If Dbl Then StartTrack(I, 0);
        RedrawList;
      End;
      Exit;
    End;
    { barre de defilement }
    If InR(X, Y, SbX0, LY0, SbX1, LY1) Then
    Begin
      If Y < LY0 + 18 Then PlTop := MaxI(0, PlTop - 1)
      Else If Y > LY1 - 18 Then PlTop := MaxI(0, MinI(PlN - NRows, PlTop + 1))
      Else If PlN > NRows Then
      Begin
        R := LY0 + 19 + Round((LY1 - LY0 - 38) * 1.0 * PlTop / MaxI(PlN, NRows));
        If (Y >= R) And (Y <= R + MaxI(10, Round((LY1 - LY0 - 38) * 1.0 * NRows / PlN))) Then
        Begin
          Drag := 4; DragV := Y - R;
          Dummy := WinSetCapture(HWND_DESKTOP, Client);
        End
        Else If Y < R Then PlTop := MaxI(0, PlTop - NRows)
        Else PlTop := MaxI(0, MinI(PlN - NRows, PlTop + NRows));
      End;
      RedrawList;
      Exit;
    End;
    If (Y >= CH - 38) And (Y <= CH - 14) Then
      For I := 20 To 24 Do
      Begin
        ListBtnRect(I, X1, X2);
        If (X >= X1) And (X <= X2) Then
        Begin
          BtnDown := I;
          Dummy := WinSetCapture(HWND_DESKTOP, Client);
          RedrawList;
          Exit;
        End;
      End;
  End
  Else
  Begin
    If InR(X, Y, LX0, LY0, LX0 + 150, LY0 + 22) Then
    Begin
      Command(CM_EQON);
      Exit;
    End;
    If InR(X, Y, DX1 - 170, LY0, DX1 - 16, LY0 + 24) Then
    Begin
      PresetMenu;
      Exit;
    End;
    For I := 0 To 10 Do
      If InR(X, Y, EqX(I) - 16, SY0 - 8, EqX(I) + 16, SY1 + 8) Then
      Begin
        Drag := 10 + I;
        Dummy := WinSetCapture(HWND_DESKTOP, Client);
        DragTo(X, Y);
        Exit;
      End;
  End;
End;

Procedure Release(Px, Py : LongInt);
Var X, Y, B, X1, X2 : LongInt;
Begin
  X := Px; Y := CH - 1 - Py;
  Dummy := WinSetCapture(HWND_DESKTOP, 0);
  If Drag = 1 Then
  Begin
    Drag := 0;
    SeekTo(PosFromX(X));
    Exit;
  End;
  If Drag <> 0 Then
  Begin
    Drag := 0;
    Exit;
  End;
  B := BtnDown;
  BtnDown := -1;
  If B < 0 Then Exit;
  If B < 10 Then
  Begin
    BtnRect(B, X1, X2);
    BeginDraw; DrawButton(B); EndDraw;
    If (X < X1) Or (X > X2) Or (Y < BY0) Or (Y > BY1) Then Exit;
    Case B Of
      0 : Command(CM_PREV);
      1 : Command(CM_BACK);
      2 : If PState = 2 Then PlayToggle Else If PState = 0 Then PlayToggle;
      3 : If PState <> 0 Then PlayToggle;
      4 : Command(CM_STOP);
      5 : Command(CM_FWD);
      6 : Command(CM_NEXT);
      7 : Command(CM_OPEN);
      8 : Command(CM_SHUFFLE);
      9 :
        Begin
          { Repeter : aucun -> liste -> morceau -> aucun }
          If RepOne <> 0 Then RepOne := 0
          Else If RepList <> 0 Then Begin RepList := 0; RepOne := 1; End
          Else RepList := 1;
          SetMarks;
          Redraw;
        End;
    End;
  End
  Else
  Begin
    ListBtnRect(B, X1, X2);
    RedrawList;
    If (X < X1) Or (X > X2) Or (Y < CH - 38) Or (Y > CH - 14) Then Exit;
    Case B Of
      20 : Command(CM_ADDFILES);
      21 : Command(CM_REMOVE);
      22 : Command(CM_CLEAR);
      23 : Command(CM_UP);
      24 : Command(CM_DOWN);
    End;
  End;
End;

