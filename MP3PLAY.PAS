Procedure FBar(X1, Y1, X2, Y2, C : LongInt);
Var Rc : Array[0..3] Of LongInt;
Begin
  If (X2 < X1) Or (Y2 < Y1) Then Exit;
  Rc[0] := X1; Rc[1] := CH - 1 - Y2; Rc[2] := X2 + 1; Rc[3] := CH - Y1;
  Dummy := WinFillRect(Hps, LongInt(@Rc), C);
End;

Procedure Edge(X1, Y1, X2, Y2, Lt, Dk : LongInt);
Begin
  FBar(X1, Y1, X2, Y1, Lt); FBar(X1, Y1, X1, Y2, Lt);
  FBar(X1, Y2, X2, Y2, Dk); FBar(X2, Y1, X2, Y2, Dk);
End;

Procedure OutTxt(X, Y : LongInt; S : String; Fg, Bg : LongInt);
Var Rc : Array[0..3] Of LongInt;
Begin
  If S = '' Then Exit;
  PutZ(LongInt(@TxtBuf), S);
  Rc[0] := X; Rc[1] := CH - Y - 16; Rc[2] := X + Length(S) * 8; Rc[3] := CH - Y;
  Dummy := WinDrawText(Hps, Length(S), LongInt(@TxtBuf), LongInt(@Rc), Fg, Bg, 0);
End;

{ texte agrandi deux fois (police du VGA) }
Procedure BigText(X, Y : LongInt; S : String; C, Bg : LongInt);
Var I, R, K, B, Run : LongInt;
Begin
  If FontH = 0 Then
  Begin
    OutTxt(X, Y + 8, S, C, Bg);
    Exit;
  End;
  For I := 1 To Length(S) Do
    For R := 0 To FontH - 1 Do
    Begin
      B := Font[Ord(S[I]) * FontH + R];
      K := 0;
      While K < 8 Do
        If (B And ($80 Shr K)) <> 0 Then
        Begin
          Run := K;
          While (K < 8) And ((B And ($80 Shr K)) <> 0) Do Inc(K);
          FBar(X + (I - 1) * 16 + Run * 2, Y + R * 2, X + (I - 1) * 16 + K * 2 - 1, Y + R * 2 + 1, C);
        End
        Else Inc(K);
    End;
End;

{ disque plein de rayon R centre en (X, Y) }
Procedure Disc(X, Y, R, C : LongInt);
Var Dy, W, Rr : LongInt;
Begin
  Rr := R * R + R;
  For Dy := -R To R Do
  Begin
    W := 0;
    While (W + 1) * (W + 1) + Dy * Dy <= Rr Do Inc(W);
    FBar(X - W, Y + Dy, X + W, Y + Dy, C);
  End;
End;



Procedure Bevel(X1, Y1, X2, Y2 : LongInt; Raised : Boolean; Fill : LongInt);
Begin
  If Fill >= -2 Then FBar(X1 + 1, Y1 + 1, X2 - 1, Y2 - 1, Fill);
  If Raised Then Edge(X1, Y1, X2, Y2, CLR_WHITE, CLR_DARKGRAY)
  Else Edge(X1, Y1, X2, Y2, CLR_DARKGRAY, CLR_WHITE);
End;

{ triangle plein, pointe a droite (Dir 1) ou a gauche (-1) ; X : base }
Procedure Tri(X, Y, H, Dir, C : LongInt);
Var Dy, W : LongInt;
Begin
  For Dy := -H To H Do
  Begin
    W := H - Abs(Dy);
    If Dir > 0 Then FBar(X, Y + Dy, X + W, Y + Dy, C) Else FBar(X - W, Y + Dy, X, Y + Dy, C);
  End;
End;

Procedure CText(X1, X2, Y : LongInt; S : String; Fg, Bg : LongInt);
Begin
  OutTxt(X1 + (X2 - X1 + 1 - Length(S) * 8) Div 2, Y, S, Fg, Bg);
End;

{ chiffre a sept segments (largeur 18, hauteur 32) }
Procedure Seg7(X, Y, N, C : LongInt);
Const Mask : Array[0..9] Of Byte = ($3F, $06, $5B, $4F, $66, $6D, $7D, $07, $7F, $6F);
Var M : LongInt;
Begin
  If (N < 0) Or (N > 9) Then Exit;
  M := Mask[N];
  If (M And 1) <> 0 Then FBar(X + 3, Y, X + 15, Y + 2, C);
  If (M And 2) <> 0 Then FBar(X + 16, Y + 3, X + 18, Y + 14, C);
  If (M And 4) <> 0 Then FBar(X + 16, Y + 17, X + 18, Y + 28, C);
  If (M And 8) <> 0 Then FBar(X + 3, Y + 29, X + 15, Y + 31, C);
  If (M And 16) <> 0 Then FBar(X, Y + 17, X + 2, Y + 28, C);
  If (M And 32) <> 0 Then FBar(X, Y + 3, X + 2, Y + 14, C);
  If (M And 64) <> 0 Then FBar(X + 3, Y + 14, X + 15, Y + 16, C);
End;

Const
  DX1 = CWant - 9;
  TxX = 178;                                      { textes de l'afficheur }
  SpX = 178; SpY1 = 88;                           { bas du spectre }
  BarW = 17; BarG = 3;

Function ShownMs : LongInt;
Var M : LongInt;
Begin
  M := CurMs;
  If (Drag = 1) And (TrackDur > 0) Then M := DragV;
  ShownMs := M;
End;

Procedure DrawTime;
Var M, Mi, Se, X : LongInt;
Begin
  FBar(16, 14, 170, 52, CLR_BLACK);
  { etat }
  If PState = 1 Then Tri(20, 31, 6, 1, CLR_GREEN)
  Else If PState = 2 Then
  Begin
    FBar(19, 25, 22, 37, CLR_GREEN); FBar(26, 25, 29, 37, CLR_GREEN);
  End
  Else FBar(19, 26, 29, 36, CLR_GREEN);
  If (PlCur < 0) And (PState = 0) Then Exit;
  M := ShownMs;
  If (ShowRemain <> 0) And (TrackDur > 0) Then M := MaxI(0, TrackDur - M);
  M := M Div 1000;
  Mi := M Div 60; Se := M Mod 60;
  If Mi > 99 Then Mi := 99;
  X := 46;
  If (ShowRemain <> 0) And (TrackDur > 0) Then FBar(36, 29, 42, 31, CLR_GREEN);
  Seg7(X, 16, Mi Div 10, CLR_GREEN); Seg7(X + 24, 16, Mi Mod 10, CLR_GREEN);
  FBar(X + 49, 23, X + 51, 25, CLR_GREEN); FBar(X + 49, 37, X + 51, 39, CLR_GREEN);
  Seg7(X + 58, 16, Se Div 10, CLR_GREEN); Seg7(X + 82, 16, Se Mod 10, CLR_GREEN);
End;

Procedure DrawLamps;
Procedure Lamp(X : LongInt; S : String; On : Boolean);
Begin
  If On Then OutTxt(X, 66, Acc(S), CLR_GREEN, CLR_BLACK) Else OutTxt(X, 66, Acc(S), CLR_DARKGREEN, CLR_BLACK);
End;
Begin
  FBar(16, 64, 170, 84, CLR_BLACK);
  Lamp(18, '^EGAL', EqOn <> 0);
  Lamp(66, 'AL^EA', Shuffle <> 0);
  If RepOne <> 0 Then Lamp(114, 'R^EP 1', True) Else Lamp(114, 'R^EP', RepList <> 0);
End;

Function TitleText : String;
Var S : String;
Begin
  If StatusT > 0 Then S := StatusMsg
  Else If PlCur >= 0 Then S := IStr(PlCur + 1) + '. ' + TrackTitle
  Else If PlN > 0 Then S := Acc('Lecteur MP3 - ') + IStr(PlN) + Acc(' morceau(x) dans la liste')
  Else S := Acc('Lecteur MP3 - liste de lecture vide');
  TitleText := S;
End;

Procedure DrawTitle;
Var S : String; W : LongInt;
Begin
  W := (DX1 - 8 - TxX) Div 8;
  S := TitleText;
  If (Length(S) > W) And (StatusT = 0) Then
  Begin
    S := S + '   ***   ' + S;
    S := Copy(S, (ScrollX Mod (Length(TitleText) + 9)) + 1, W);
  End
  Else S := Copy(S, 1, W);
  FBar(TxX, 12, DX1 - 6, 30, CLR_BLACK);
  If StatusT > 0 Then OutTxt(TxX, 13, S, CLR_YELLOW, CLR_BLACK) Else OutTxt(TxX, 13, S, CLR_GREEN, CLR_BLACK);
End;

Procedure DrawInfo;
Var S, R : String;
Begin
  FBar(TxX, 32, DX1 - 6, 50, CLR_BLACK);
  If (TrackOk = 0) Or (PState = 0) Then
  Begin
    If PlN > 0 Then OutTxt(TxX, 33, Acc('Dur^ee totale : ') + TimeStr(PlTotal * 1000), CLR_CYAN, CLR_BLACK);
    Exit;
  End;
  S := IStr(TrackKbps) + ' kbit/s   ';
  If TrackRate Mod 1000 = 0 Then S := S + IStr(TrackRate Div 1000) + ' kHz   '
  Else S := S + IStr(TrackRate Div 1000) + ',' + IStr((TrackRate Mod 1000) Div 100) + ' kHz   ';
  If TrackCh = 1 Then S := S + 'Mono'
  Else If TrackMode = 1 Then S := S + Acc('St^er^eo conjointe')
  Else S := S + Acc('St^er^eo');
  OutTxt(TxX, 33, S, CLR_CYAN, CLR_BLACK);
  R := IStr(PlCur + 1) + '/' + IStr(PlN);
  OutTxt(DX1 - 8 - Length(R) * 8, 33, R, CLR_CYAN, CLR_BLACK);
End;

{ une barre du spectre : de la hauteur Old a New (cases de 2 + 1 points) }
Procedure DrawBar(I, Old, New, Peak : LongInt);
Var X, L, Y, C : LongInt;
Begin
  X := SpX + I * (BarW + BarG);
  For L := 0 To 9 Do
  Begin
    Y := SpY1 - L * 3;
    If L < New Div 3 Then
    Begin
      If L >= 8 Then C := CLR_RED Else If L >= 6 Then C := CLR_YELLOW Else C := CLR_GREEN;
    End
    Else If (Peak >= 3) And (L = Peak Div 3) Then C := CLR_DARKCYAN
    Else C := CLR_BLACK;
    FBar(X, Y - 1, X + BarW - 1, Y, C);
  End;
End;

Procedure DrawSpectrum(All : Boolean);
Var I, K, Best, BestPos, V : LongInt;
Begin
  { instantane du son en train d'etre joue }
  Best := -1; BestPos := -1;
  If (PState = 1) And (ShowSpec <> 0) Then
    For K := 0 To NSNAP - 1 Do
      If (SnapPos[K] >= 0) And (SnapPos[K] <= Played) And (SnapPos[K] > BestPos) Then
      Begin
        Best := K; BestPos := SnapPos[K];
      End;
  For I := 0 To NSPEC - 1 Do
  Begin
    If Best >= 0 Then V := SnapVal[Best, I]
    Else If PState = 2 Then V := ShownV[I]
    Else V := MaxI(0, ShownV[I] - 3);
    If PState <> 2 Then
    Begin
      If V >= PeakV[I] Then
      Begin
        PeakV[I] := V; PeakT[I] := 8;
      End
      Else If PeakT[I] > 0 Then Dec(PeakT[I])
      Else PeakV[I] := MaxI(0, PeakV[I] - 2);
    End;
    If All Or (V <> ShownV[I]) Or (PeakT[I] <= 0) Then DrawBar(I, ShownV[I], V, PeakV[I]);
    ShownV[I] := V;
  End;
End;

Procedure DrawDisplay;
Var I : LongInt;
Begin
  Edge(DX0, DY0, DX1, DY1, CLR_DARKGRAY, CLR_WHITE);
  Edge(DX0 + 1, DY0 + 1, DX1 - 1, DY1 - 1, CLR_BLACK, CLR_PALEGRAY);
  FBar(DX0 + 2, DY0 + 2, DX1 - 2, DY1 - 2, CLR_BLACK);
  FBar(170, 14, 171, 84, CLR_DARKGREEN);
  DrawTime; DrawLamps; DrawTitle; DrawInfo;
  For I := 0 To NSPEC - 1 Do DrawBar(I, 0, ShownV[I], PeakV[I]);
End;

{ barre de position }
Procedure DrawPosition;
Var X, M, D : LongInt;
Begin
  FBar(DX0, PY0, DX1, PY1, CLR_PALEGRAY);
  Bevel(DX0 + 6, PY0 + 8, DX1 - 6, PY0 + 14, False, CLR_WHITE);
  M := ShownMs; D := TrackDur;
  X := DX0 + 8;
  If (D > 0) And (PState <> 0) Then X := DX0 + 8 + Round((DX1 - DX0 - 16) * 1.0 * MinI(M, D) / D);
  If X > DX0 + 8 Then FBar(DX0 + 8, PY0 + 10, X, PY0 + 12, CLR_DARKBLUE);
  Bevel(X - 5, PY0 + 1, X + 5, PY1 - 1, True, CLR_PALEGRAY);
  FBar(X, PY0 + 6, X, PY1 - 6, CLR_DARKGRAY);
End;

{ boutons : 0 precedent, 1 reculer, 2 lecture, 3 pause, 4 arret, 5 avancer,
  6 suivant, 7 ouvrir ; 8 aleatoire, 9 repeter }
Procedure BtnRect(I : LongInt; Var X1, X2 : LongInt);
Begin
  If I < 8 Then
  Begin
    X1 := DX0 + I * 44; X2 := X1 + 39;
  End
  Else If I = 8 Then
  Begin
    X1 := DX1 - 179; X2 := DX1 - 92;
  End
  Else
  Begin
    X1 := DX1 - 87; X2 := DX1;
  End;
End;

Procedure DrawButton(I : LongInt);
Var X1, X2, Cx, Cy, Dn, C : LongInt; On : Boolean;
Begin
  BtnRect(I, X1, X2);
  On := ((I = 8) And (Shuffle <> 0)) Or ((I = 9) And ((RepList <> 0) Or (RepOne <> 0))) Or
        ((I = 2) And (PState = 1)) Or ((I = 3) And (PState = 2));
  Dn := Ord(BtnDown = I) + Ord(On);
  If Dn > 0 Then Bevel(X1, BY0, X2, BY1, False, CLR_PALEGRAY) Else Bevel(X1, BY0, X2, BY1, True, CLR_PALEGRAY);
  Edge(X1 + 1, BY0 + 1, X2 - 1, BY1 - 1, CLR_PALEGRAY, CLR_PALEGRAY);
  If Dn > 0 Then Edge(X1 + 1, BY0 + 1, X2 - 1, BY1 - 1, CLR_DARKGRAY, CLR_PALEGRAY)
  Else Edge(X1 + 1, BY0 + 1, X2 - 1, BY1 - 1, CLR_PALEGRAY, CLR_DARKGRAY);
  Cx := (X1 + X2) Div 2 + Ord(Dn > 0); Cy := (BY0 + BY1) Div 2 + Ord(Dn > 0);
  C := CLR_BLACK;
  If (I = 2) And (PState = 1) Then C := CLR_DARKGREEN;
  Case I Of
    0 : Begin FBar(Cx - 9, Cy - 6, Cx - 8, Cy + 6, C); Tri(Cx - 1, Cy, 6, -1, C); Tri(Cx + 7, Cy, 6, -1, C); End;
    1 : Begin Tri(Cx - 1, Cy, 6, -1, C); Tri(Cx + 7, Cy, 6, -1, C); End;
    2 : Tri(Cx - 3, Cy, 7, 1, C);
    3 : Begin FBar(Cx - 5, Cy - 6, Cx - 2, Cy + 6, C); FBar(Cx + 2, Cy - 6, Cx + 5, Cy + 6, C); End;
    4 : FBar(Cx - 6, Cy - 6, Cx + 6, Cy + 6, C);
    5 : Begin Tri(Cx - 7, Cy, 6, 1, C); Tri(Cx + 1, Cy, 6, 1, C); End;
    6 : Begin Tri(Cx - 7, Cy, 6, 1, C); Tri(Cx + 1, Cy, 6, 1, C); FBar(Cx + 8, Cy - 6, Cx + 9, Cy + 6, C); End;
    7 : Begin
          { ejecter : triangle pointe en haut sur une barre }
          For Dn := 0 To 6 Do FBar(Cx - Dn, Cy - 7 + Dn, Cx + Dn, Cy - 7 + Dn, C);
          FBar(Cx - 7, Cy + 3, Cx + 7, Cy + 5, C);
        End;
    8 : CText(X1, X2, Cy - 8 , Acc('Al^eatoire'), C, CLR_PALEGRAY);
    9 : If RepOne <> 0 Then CText(X1, X2, Cy - 8, Acc('R^ep^eter 1'), C, CLR_PALEGRAY)
        Else CText(X1, X2, Cy - 8, Acc('R^ep^eter'), C, CLR_PALEGRAY);
  End;
End;

{ curseur horizontal : V entre 0 et Max }
Procedure HSlider(X1, X2, Y, V, Max : LongInt; Mid : Boolean);
Var X : LongInt;
Begin
  FBar(X1 - 6, Y, X2 + 6, Y + 20, CLR_PALEGRAY);
  Bevel(X1, Y + 8, X2, Y + 12, False, CLR_WHITE);
  If Mid Then FBar((X1 + X2) Div 2, Y + 15, (X1 + X2) Div 2, Y + 19, CLR_DARKGRAY);
  X := X1 + Round((X2 - X1) * 1.0 * V / Max);
  Bevel(X - 4, Y + 1, X + 4, Y + 19, True, CLR_PALEGRAY);
End;

Procedure DrawVolume;
Var S : String;
Begin
  FBar(DX0, VY0, DX1, VY1, CLR_PALEGRAY);
  OutTxt(DX0, VY0 + 2, 'Volume', CLR_BLACK, CLR_PALEGRAY);
  HSlider(DX0 + 70, DX0 + 230, VY0, VolumeV, 100, False);
  OutTxt(DX0 + 244, VY0 + 2, IStr(VolumeV) + ' %', CLR_BLACK, CLR_PALEGRAY);
  OutTxt(DX0 + 310, VY0 + 2, 'Balance', CLR_BLACK, CLR_PALEGRAY);
  HSlider(DX0 + 384, DX0 + 504, VY0, Balance + 50, 100, True);
  If Balance = 0 Then S := Acc('Centre')
  Else If Balance < 0 Then S := 'G ' + IStr(-Balance * 2) + ' %'
  Else S := 'D ' + IStr(Balance * 2) + ' %';
  OutTxt(DX0 + 516, VY0 + 2, S, CLR_BLACK, CLR_PALEGRAY);
End;

{ onglets et page }
Const
  PgX0 = DX0; PgY0 = TY1; PgX1 = DX1;
  LX0 = 18; LY0 = TY1 + 10; LX1 = CWant - 38;
  SbX0 = CWant - 37; SbX1 = CWant - 20;
  SY0 = TY1 + 54; SY1 = TY1 + 150;              { curseurs de l'egaliseur }

Function LY1 : LongInt;
Begin
  LY1 := CH - 46;
End;

Function NRows : LongInt;
Begin
  NRows := (LY1 - 2 - (LY0 + 19)) Div RowH;
End;

Procedure DrawTabs;
Procedure OneTab(I, X1, X2 : LongInt; S : String);
Begin
  If Tab = I Then
  Begin
    FBar(X1, TY0, X2, TY1 + 1, CLR_PALEGRAY);
    FBar(X1, TY0, X2, TY0, CLR_WHITE); FBar(X1, TY0, X1, TY1, CLR_WHITE);
    FBar(X2, TY0 + 1, X2, TY1, CLR_DARKGRAY);
    OutTxt(X1 + 10, TY0 + 2, Acc(S), CLR_BLACK, CLR_PALEGRAY);
  End
  Else
  Begin
    FBar(X1 + 2, TY0 + 3, X2 - 2, TY1 - 1, CLR_PALEGRAY);
    FBar(X1 + 2, TY0 + 3, X2 - 2, TY0 + 3, CLR_WHITE); FBar(X1 + 2, TY0 + 3, X1 + 2, TY1 - 1, CLR_WHITE);
    FBar(X2 - 2, TY0 + 4, X2 - 2, TY1 - 1, CLR_DARKGRAY);
    OutTxt(X1 + 10, TY0 + 4, Acc(S), CLR_DARKGRAY, CLR_PALEGRAY);
  End;
End;
Begin
  FBar(DX0, TY0, DX1, TY1 - 1, CLR_PALEGRAY);
  OneTab(0, DX0, DX0 + 150, 'Liste de lecture');
  OneTab(1, DX0 + 152, DX0 + 262, '^Egaliseur');
End;

Procedure DrawSmallBtn(X1, Y1, X2, Y2, Id : LongInt; S : String; Enabled : Boolean);
Var Dn : Boolean;
Begin
  Dn := BtnDown = Id;
  Bevel(X1, Y1, X2, Y2, Not Dn, CLR_PALEGRAY);
  If Dn Then Edge(X1 + 1, Y1 + 1, X2 - 1, Y2 - 1, CLR_DARKGRAY, CLR_PALEGRAY)
  Else Edge(X1 + 1, Y1 + 1, X2 - 1, Y2 - 1, CLR_PALEGRAY, CLR_DARKGRAY);
  If Enabled Then CText(X1 + Ord(Dn), X2 + Ord(Dn), (Y1 + Y2) Div 2 - 8 + Ord(Dn), Acc(S), CLR_BLACK, CLR_PALEGRAY)
  Else CText(X1, X2, (Y1 + Y2) Div 2 - 8, Acc(S), CLR_DARKGRAY, CLR_PALEGRAY);
End;

{ boutons du bas de la liste : 20 ajouter, 21 retirer, 22 effacer, 23 monter,
  24 descendre ; 30 preglages }
Procedure ListBtnRect(I : LongInt; Var X1, X2 : LongInt);
Begin
  Case I Of
    20 : Begin X1 := LX0; X2 := LX0 + 93; End;
    21 : Begin X1 := LX0 + 99; X2 := LX0 + 178; End;
    22 : Begin X1 := LX0 + 184; X2 := LX0 + 263; End;
    23 : Begin X1 := LX0 + 269; X2 := LX0 + 340; End;
  Else
    Begin X1 := LX0 + 346; X2 := LX0 + 433; End;
  End;
End;

Procedure DrawListRows;
Var R, I, Y, Fg, Bg, Tot : LongInt; S, T : String;
Begin
  For R := 0 To NRows - 1 Do
  Begin
    I := PlTop + R;
    Y := LY0 + 20 + R * RowH;
    If (I < PlN) And (I = PlSel) Then
    Begin
      Bg := CLR_DARKBLUE; Fg := CLR_WHITE;
    End
    Else
    Begin
      Bg := CLR_WHITE; Fg := CLR_BLACK;
    End;
    FBar(LX0 + 2, Y, LX1 - 2, Y + RowH - 1, Bg);
    If I < PlN Then
    Begin
      If (I = PlCur) And (Bg = CLR_WHITE) Then Fg := CLR_DARKBLUE;
      S := IStr(I + 1);
      OutTxt(LX0 + 34 - Length(S) * 8, Y, S, Fg, Bg);
      T := Pl^[I]^.Title;
      If I = PlCur Then
      Begin
        If PState = 1 Then OutTxt(LX0 + 40, Y, Chr(16), Fg, Bg)
        Else If PState = 2 Then OutTxt(LX0 + 40, Y, '=', Fg, Bg);
      End;
      If Length(T) > (LX1 - LX0 - 120) Div 8 Then T := Copy(T, 1, (LX1 - LX0 - 120) Div 8 - 1) + Chr(175);
      OutTxt(LX0 + 52, Y, T, Fg, Bg);
      If Pl^[I]^.Dur >= 0 Then
      Begin
        S := TimeStr(Pl^[I]^.Dur);
        OutTxt(LX1 - 10 - Length(S) * 8, Y, S, Fg, Bg);
      End;
    End;
  End;
  { barre de defilement }
  Bevel(SbX0, LY0, SbX1, LY1, False, CLR_PALEGRAY);
  Bevel(SbX0 + 1, LY0 + 1, SbX1 - 1, LY0 + 17, True, CLR_PALEGRAY);
  Bevel(SbX0 + 1, LY1 - 17, SbX1 - 1, LY1 - 1, True, CLR_PALEGRAY);
  For R := 0 To 4 Do
  Begin
    FBar((SbX0 + SbX1) Div 2 - R, LY0 + 6 + R, (SbX0 + SbX1) Div 2 + R, LY0 + 6 + R, CLR_BLACK);
    FBar((SbX0 + SbX1) Div 2 - R, LY1 - 6 - R, (SbX0 + SbX1) Div 2 + R, LY1 - 6 - R, CLR_BLACK);
  End;
  Tot := MaxI(PlN, NRows);
  Y := LY0 + 19 + Round((LY1 - LY0 - 38) * 1.0 * PlTop / Tot);
  R := MaxI(10, Round((LY1 - LY0 - 38) * 1.0 * NRows / Tot));
  If PlN > NRows Then Bevel(SbX0 + 1, Y, SbX1 - 1, MinI(LY1 - 19, Y + R), True, CLR_PALEGRAY);
End;

Procedure DrawListPage;
Var S : String; X1, X2, T : LongInt;
Begin
  { liste : en-tete des colonnes, lignes }
  Bevel(LX0, LY0, LX1, LY1, False, -9);
  FBar(LX0 + 1, LY0 + 1, LX1 - 1, LY0 + 18, CLR_PALEGRAY);
  Edge(LX0 + 1, LY0 + 1, LX1 - 1, LY0 + 18, CLR_WHITE, CLR_DARKGRAY);
  OutTxt(LX0 + 10, LY0 + 2, Acc('N^0'), CLR_BLACK, CLR_PALEGRAY);
  FBar(LX0 + 46, LY0 + 3, LX0 + 46, LY0 + 16, CLR_DARKGRAY);
  OutTxt(LX0 + 52, LY0 + 2, 'Titre', CLR_BLACK, CLR_PALEGRAY);
  FBar(LX1 - 64, LY0 + 3, LX1 - 64, LY0 + 16, CLR_DARKGRAY);
  OutTxt(LX1 - 58, LY0 + 2, Acc('Dur^ee'), CLR_BLACK, CLR_PALEGRAY);
  FBar(LX0 + 1, LY0 + 19, LX1 - 1, LY1 - 1, CLR_WHITE);
  DrawListRows;
  ListBtnRect(20, X1, X2); DrawSmallBtn(X1, CH - 38, X2, CH - 14, 20, 'Ajouter...', True);
  ListBtnRect(21, X1, X2); DrawSmallBtn(X1, CH - 38, X2, CH - 14, 21, 'Retirer', PlSel >= 0);
  ListBtnRect(22, X1, X2); DrawSmallBtn(X1, CH - 38, X2, CH - 14, 22, 'Effacer', PlN > 0);
  ListBtnRect(23, X1, X2); DrawSmallBtn(X1, CH - 38, X2, CH - 14, 23, 'Monter', PlSel > 0);
  ListBtnRect(24, X1, X2); DrawSmallBtn(X1, CH - 38, X2, CH - 14, 24, 'Descendre', (PlSel >= 0) And (PlSel < PlN - 1));
  T := PlTotal;
  If PlN = 1 Then S := '1 morceau' Else S := IStr(PlN) + ' morceaux';
  If T > 0 Then S := S + ', ' + TimeStr(T * 1000);
  { total dans l'en-tete, a droite de la colonne des titres (il ne
    deborde jamais sur les boutons, meme pour une tres longue liste) }
  OutTxt(LX1 - 72 - Length(S) * 8, LY0 + 2, S, CLR_DARKBLUE, CLR_PALEGRAY);
End;

{ egaliseur : 0 preamplification, 1..10 bandes }
Function EqX(K : LongInt) : LongInt;
Begin
  If K = 0 Then EqX := 58 Else EqX := 176 + (K - 1) * 40;
End;

Function EqLabel(K : LongInt) : String;
Begin
  Case K Of
    0 : EqLabel := Acc('Pr^eampli');
    1 : EqLabel := '60';
    2 : EqLabel := '170';
    3 : EqLabel := '310';
    4 : EqLabel := '600';
    5 : EqLabel := '1 k';
    6 : EqLabel := '3 k';
    7 : EqLabel := '6 k';
    8 : EqLabel := '12 k';
    9 : EqLabel := '14 k';
  Else EqLabel := '16 k';
  End;
End;

Function EqVal(K : LongInt) : LongInt;
Begin
  If K = 0 Then EqVal := EqPre Else EqVal := EqBand[K - 1];
End;

Procedure DrawEqSlider(K : LongInt);
Var X, Y, V, W : LongInt; S : String;
Begin
  X := EqX(K);
  If K = 0 Then W := 36 Else W := 19;
  FBar(X - W, SY0 - 22, X + W, SY1 + 24, CLR_PALEGRAY);
  V := EqVal(K);
  If V > 0 Then S := '+' + IStr(V) Else S := IStr(V);
  CText(X - 20, X + 20, SY0 - 22, S, CLR_DARKBLUE, CLR_PALEGRAY);
  Bevel(X - 3, SY0, X + 3, SY1, False, CLR_WHITE);
  Y := SY0 + Round((SY1 - SY0) * (12 - V) / 24.0);
  If EqOn <> 0 Then FBar(X - 1, MinI(Y, (SY0 + SY1) Div 2), X + 1, MaxI(Y, (SY0 + SY1) Div 2), CLR_DARKBLUE);
  Bevel(X - 10, Y - 5, X + 10, Y + 5, True, CLR_PALEGRAY);
  FBar(X - 7, Y, X + 7, Y, CLR_DARKGRAY);
  CText(X - W, X + W, SY1 + 7, EqLabel(K), CLR_BLACK, CLR_PALEGRAY);
End;

Procedure DrawEqPage;
Var K, Y : LongInt;
Begin
  { case a cocher }
  Bevel(LX0 + 4, LY0 + 4, LX0 + 18, LY0 + 18, False, CLR_WHITE);
  If EqOn <> 0 Then
    For K := 0 To 3 Do
    Begin
      FBar(LX0 + 7 + K, LY0 + 10 + K, LX0 + 8 + K, LY0 + 11 + K, CLR_BLACK);
      FBar(LX0 + 11 + K, LY0 + 13 - K * 2, LX0 + 12 + K, LY0 + 14 - K * 2, CLR_BLACK);
    End;
  OutTxt(LX0 + 26, LY0 + 3, Acc('^Egaliseur actif'), CLR_BLACK, CLR_PALEGRAY);
  DrawSmallBtn(DX1 - 170, LY0, DX1 - 16, LY0 + 24, 30, 'Pr^er^eglages...', True);
  { echelle }
  Y := (SY0 + SY1) Div 2;
  OutTxt(100, SY0 - 8, '+12 dB', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(116, Y - 8, '0 dB', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(100, SY1 - 8, '-12 dB', CLR_DARKGRAY, CLR_PALEGRAY);
  FBar(150, Y, EqX(10) + 14, Y, CLR_DARKGRAY);
  FBar(150, SY0, 154, SY0, CLR_DARKGRAY); FBar(150, SY1, 154, SY1, CLR_DARKGRAY);
  For K := 0 To 10 Do DrawEqSlider(K);
  OutTxt(LX0 + 4, CH - 34, Acc('De -12 ^a +12 dB, appliqu^e au son d^ecod^e (avant la synth^gse).'), CLR_DARKGRAY, CLR_PALEGRAY);
End;

Procedure DrawPage;
Begin
  FBar(PgX0 + 1, PgY0 + 1, PgX1 - 1, CH - 9, CLR_PALEGRAY);
  FBar(PgX0, PgY0, PgX0, CH - 8, CLR_WHITE);
  FBar(PgX1, PgY0, PgX1, CH - 8, CLR_DARKGRAY);
  FBar(PgX0, CH - 8, PgX1, CH - 8, CLR_DARKGRAY);
  If Tab = 0 Then FBar(DX0 + 151, PgY0, PgX1 - 1, PgY0, CLR_WHITE)
  Else
  Begin
    FBar(PgX0 + 1, PgY0, DX0 + 151, PgY0, CLR_WHITE);
    FBar(DX0 + 263, PgY0, PgX1 - 1, PgY0, CLR_WHITE);
  End;
  If Tab = 0 Then DrawListPage Else DrawEqPage;
End;

Procedure DrawAll;
Var I : LongInt;
Begin
  FBar(0, 0, CW - 1, CH - 1, CLR_PALEGRAY);
