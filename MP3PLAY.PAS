Procedure PresetMenu;
Var H0, K, M : LongInt;
Begin
  MenuLen := 0;
  H0 := MenuOpen;
  For K := 0 To NPRESET - 1 Do MItem(MIS_TEXT, 0, CM_PRESET0 + K, PresetName[K]);
  MenuClose(H0, NPRESET);
  M := WinCreateMenu(HWND_DESKTOP, LongInt(@MenuT));
  If M <> 0 Then Dummy := WinPopupMenu(Client, Client, M, DX1 - 170, CH - (LY0 + 24), 0, 0);
End;

Procedure SortList(ByName : Boolean);
Var I, J : LongInt; A, B : String; Swapped : Boolean;
Begin
  For I := 1 To PlN - 1 Do
  Begin
    J := I;
    Repeat
      Swapped := False;
      If J > 0 Then
      Begin
        If ByName Then
        Begin
          A := UpS(BaseName(Pl^[J - 1]^.Path)); B := UpS(BaseName(Pl^[J]^.Path));
        End
        Else
        Begin
          A := UpS(Pl^[J - 1]^.Title); B := UpS(Pl^[J]^.Title);
        End;
        If B < A Then
        Begin
          PlSwap(J - 1, J);
          If PlSel = J Then PlSel := J - 1 Else If PlSel = J - 1 Then PlSel := J;
          Swapped := True;
          Dec(J);
        End;
      End;
    Until Not Swapped;
  End;
End;

Procedure Command(Id : LongInt);
Var K, J : LongInt;
Begin
  Case Id Of
    CM_OPEN : FileDialog(1);
    CM_ADDFILES : FileDialog(2);
    CM_ADDDIR : FileDialog(3);
    CM_OPENLIST : FileDialog(4);
    CM_SAVELIST : FileDialog(5);
    CM_INFO : ShowInfo;
    CM_QUIT : Dummy := WinPostMsg(Client, WM_CLOSE, 0, 0);
    CM_PLAY : PlayToggle;
    CM_STOP : StopCmd;
    CM_PREV : PrevCmd;
    CM_NEXT : NextCmd;
    CM_BACK : SeekTo(CurMs - 5000);
    CM_FWD : SeekTo(CurMs + 5000);
    CM_SHUFFLE :
      Begin
        Shuffle := 1 - Shuffle;
        For K := 0 To PlN - 1 Do Pl^[K]^.Played := K = PlCur;
      End;
    CM_REPLIST : Begin RepList := 1 - RepList; If RepList <> 0 Then RepOne := 0; End;
    CM_REPONE : Begin RepOne := 1 - RepOne; If RepOne <> 0 Then RepList := 0; End;
    CM_PLAYSEL : If PlSel >= 0 Then StartTrack(PlSel, 0);
    CM_REMOVE :
      If PlSel >= 0 Then
      Begin
        If PlSel = PlCur Then StopPlayback;
        PlDelete(PlSel);
      End;
    CM_CLEAR : If PlN > 0 Then
      If Ask(Acc('Retirer tous les morceaux de la liste de lecture ?'), 'Lecteur MP3', MB_YESNO Or MB_QUERY) =
         MBID_YES Then
      Begin
        StopPlayback;
        PlClear;
      End;
    CM_UP : If PlSel > 0 Then Begin PlSwap(PlSel, PlSel - 1); Dec(PlSel); End;
    CM_DOWN : If (PlSel >= 0) And (PlSel < PlN - 1) Then Begin PlSwap(PlSel, PlSel + 1); Inc(PlSel); End;
    CM_SORTTITLE : SortList(False);
    CM_SORTNAME : SortList(True);
    CM_MIX :
      For K := PlN - 1 DownTo 1 Do
      Begin
        J := Rnd(K + 1);
        PlSwap(K, J);
      End;
    CM_EQON : Begin EqOn := 1 - EqOn; EqDirty := 1; End;
    CM_SHOWLIST : Tab := 0;
    CM_SHOWEQ : Tab := 1;
    CM_ELAPSED : ShowRemain := 0;
    CM_REMAIN : ShowRemain := 1;
    CM_SPECTRUM : ShowSpec := 1 - ShowSpec;
    CM_HELP : ShowHelp;
    CM_ABOUT :
      Begin
        LClr;
        LAdd(Acc('Lecteur MP3 pour OS/2-0') + #10#10);
        LAdd(Acc('D^ecodeur MP3 de PLAYMP3 (d^ep^ot MP3-Player-0), en Pascal, sans biblioth^gque externe ; ') +
             Acc('tables : PDMP3 (domaine public), minimp3 (CC0).') + #10#10);
        LAdd('Sylvain Maltais, 2026 - licence MIT' + #10 + 'https://www.gladir.com/os2-0');
        Dummy := LMsgBox(Acc('^A propos du Lecteur MP3'), MB_OK Or MB_INFORMATION);
      End;
  Else
    If (Id >= CM_PRESET0) And (Id < CM_PRESET0 + NPRESET) Then
    Begin
      ApplyPreset(Id - CM_PRESET0);
      EqOn := 1;
      SetStatus(Acc('^Egaliseur : ') + PresetName[Id - CM_PRESET0]);
    End;
  End;
  EnsureVisible;
  SetMarks;
  Redraw;
End;

