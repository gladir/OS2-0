{ ==================================================================== }
{ Programme principal                                                   }
{ ==================================================================== }

Var
  Flg, Sw, Sh, Fw, Fh, K, X, Y, Np, H : LongInt;
  Dt : Array[0..15] Of Byte;
  Rc : Array[0..3] Of LongInt;
  S, U : String;

BEGIN
  FillChar(Dt, SizeOf(Dt), 0);
  Dummy := DosGetDateTime(LongInt(@Dt));
  Seed := Dt[0] * 3600 + Dt[1] * 60 + Dt[2] + Dt[3] * 7919 + 1;
  FrameW := 0; Client := 0; MenuHw := 0;
  PlN := 0; PlCur := -1; PlSel := -1; PlTop := 0; PState := 0;
  Shuffle := 0; RepList := 0; RepOne := 0; ShowRemain := 0; ShowSpec := 1; Tab := 0; NoSave := 0;
  VolumeV := 80; Balance := 0; EqOn := 0; EqPre := 0; EqDirty := 1; EqRate := 0;
  For K := 0 To 9 Do EqBand[K] := 0;
  DecRun := 0; DecDone := 0; DecStop := 0; StreamOn := 0; NoCard := 0; FailCount := 0;
  D := Nil; Transform := Nil; Pow43 := Nil; FrameOfs := Nil; FrameCap := 0; FrameCnt := 0;
  Pl := Nil; PlCap := 0; DlgItem := Nil; DlgCap := 0; DlgN := 0;
  Drag := 0; BtnDown := -1; StatusT := 0; StatusMsg := ''; TrackTitle := ''; TrackOk := 0; TrackDur := -1;
  LastSecs := -1; LastState := -1; LastTrack := -2; MenuUp := 0; MenuStale := 0; WasActive := 1; DlgFrame := 0; DlgDir := ''; ListName := '';
  For K := 0 To NSNAP - 1 Do SnapPos[K] := -1;
  For K := 0 To NSPEC - 1 Do Begin ShownV[K] := 0; PeakV[K] := 0; PeakT[K] := 0; End;
  GetMem(Ring, RINGMAX);
  FillChar(Ring^, RINGMAX, 0);
  InitPresets;
  ExeDir := DirName(ParamStr(0));
  If ExeDir = '' Then ExeDir := 'C:\';
  LoadIni;
  Np := 0;
  For K := 1 To ParamCount Do
  Begin
    S := ParamStr(K); U := UpS(S);
    If U = '/NOSAVE' Then NoSave := 1
    Else If (Copy(U, 1, 1) <> '/') And (S <> '') Then Inc(Np);
  End;
  If Np > 0 Then
  Begin
    For K := 1 To ParamCount Do
    Begin
      S := ParamStr(K);
      If (Copy(S, 1, 1) <> '/') And (S <> '') Then
      Begin
        If (Pos(':', S) = 0) And (Copy(S, 1, 1) <> '\') Then S := ExeDir + S;
        AddPath(S);
        If DlgDir = '' Then DlgDir := DirName(S);
      End;
    End;
  End
  Else
  Begin
    { la liste de la derniere fois ; au premier lancement, les MP3 du
      dossier du programme (morceau d'exemple du CD-ROM) }
    H := OpenRead(ExeDir + 'MP3PLAY.M3U');
    If H <> 0 Then
    Begin
      Dummy := DosClose(H);
      LoadM3U(ExeDir + 'MP3PLAY.M3U');
    End
    Else AddDir(ExeDir);
  End;
  If PlN > 0 Then PlSel := 0;
  Hab := WinInitialize(0);
  Hmq := WinCreateMsgQueue(Hab, 64);
  LoadFont;
  Dummy := WinRegisterClass(Hab, Z('MP3PLAY'), LongInt(@MainProc), 0, 0);
  Dummy := WinRegisterClass(Hab, Z('MP3PLAYDLG'), LongInt(@DlgProc), 0, 0);
  Flg := FCF_TITLEBAR Or FCF_SYSMENU Or FCF_MINBUTTON Or FCF_DLGBORDER Or FCF_TASKLIST;
  FrameW := WinCreateStdWindow(HWND_DESKTOP, 0, LongInt(@Flg), Z('MP3PLAY'), Z2('Lecteur MP3'), 0, 0, 0,
                               LongInt(@Client));
  BuildMenu;
  CW := CWant; CH := CHWant;
  Rc[0] := 0; Rc[1] := 0; Rc[2] := CWant; Rc[3] := CHWant;
  Dummy := WinCalcFrameRect(FrameW, LongInt(@Rc), 0);
  Fw := Rc[2] - Rc[0]; Fh := Rc[3] - Rc[1];
  Sw := WinQuerySysValue(HWND_DESKTOP, 20); Sh := WinQuerySysValue(HWND_DESKTOP, 21);
  X := (Sw - Fw) Div 2; Y := (Sh - Fh) Div 2;
  If X < 0 Then X := 0;
  If Y < 0 Then Y := Sh - Fh;
  Dummy := WinSetWindowPos(FrameW, HWND_TOP, X, Y, Fw, Fh, SWP_SIZE Or SWP_MOVE Or SWP_ZORDER Or SWP_SHOW Or
                           SWP_ACTIVATE);
  SetMarks;
  If MdmAudioInfo(LongInt(@TxtBuf), 200) = 0 Then SetStatus(Acc('Aucune carte son : la lecture sera muette.'));
  Dummy := MdmVolume(VolumeV);
  Dummy := WinStartTimer(Hab, Client, 1, 100);
  If (Np > 0) And (PlN > 0) Then StartTrack(0, 0);
  Dummy := WinSetFocus(HWND_DESKTOP, Client);
  While WinGetMsg(Hab, LongInt(@Qmsg), 0, 0, 0) <> 0 Do Dummy := WinDispatchMsg(Hab, LongInt(@Qmsg));
  StopPlayback;
  SaveIni;
  Dummy := WinDestroyWindow(FrameW);
END.
