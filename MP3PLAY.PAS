Procedure SetMark(Id : LongInt; On : Boolean);
Begin
  If MenuHw = 0 Then Exit;
  If On Then Dummy := WinSendMsg(MenuHw, MM_SETITEMATTR, Id Or $10000, MIA_CHECKED Or (MIA_CHECKED Shl 16))
  Else Dummy := WinSendMsg(MenuHw, MM_SETITEMATTR, Id Or $10000, MIA_CHECKED);
End;

Procedure SetMarks;
Begin
  SetMark(CM_SHUFFLE, Shuffle <> 0); SetMark(CM_REPLIST, RepList <> 0); SetMark(CM_REPONE, RepOne <> 0);
  SetMark(CM_EQON, EqOn <> 0); SetMark(CM_SHOWLIST, Tab = 0); SetMark(CM_SHOWEQ, Tab = 1);
  SetMark(CM_ELAPSED, ShowRemain = 0); SetMark(CM_REMAIN, ShowRemain <> 0); SetMark(CM_SPECTRUM, ShowSpec <> 0);
End;

Procedure EnsureVisible;
Begin
  If PlSel < 0 Then Exit;
  If PlSel < PlTop Then PlTop := PlSel;
  If PlSel >= PlTop + NRows Then PlTop := PlSel - NRows + 1;
  If PlTop > MaxI(0, PlN - NRows) Then PlTop := MaxI(0, PlN - NRows);
  If PlTop < 0 Then PlTop := 0;
End;

Procedure RedrawList;
Begin
  If Tab <> 0 Then Exit;
  BeginDraw;
  DrawListPage;
  EndDraw;
End;

Procedure TimerTick;
Var K, Secs, Cap : LongInt;
Begin
  Inc(Ticks);
  { fin du decodage : la position vient de MDM }
  If (DecDone <> 0) And (StreamOn <> 0) And (PState <> 0) Then
  Begin
    K := MdmFeed(Fed, 1);
    If K >= 0 Then Played := K;
  End;
  { fin du morceau, ou erreur }
  If (PState <> 0) And (DecDone <> 0) And (DecRun = 0) Then
  Begin
    If DecError Then
    Begin
      SetStatus(DecErrMsg);
      Inc(FailCount);
      StopPlayback;
      If (NoCard = 0) And (FailCount < PlN) Then
      Begin
        K := NextIndex(True);
        If (K >= 0) And (K <> PlCur) Then StartTrack(K, 0);
      End;
      Redraw;
    End
    Else If (StreamOn = 0) Or (MdmState = 0) Then
    Begin
      FailCount := 0;
      K := NextIndex(True);
      StopPlayback;
      If K >= 0 Then StartTrack(K, 0) Else Redraw;
    End;
  End;
  If StatusT > 0 Then
  Begin
    Dec(StatusT);
    If StatusT = 0 Then ScrollT := 0;
  End;
  { PM ne decoupe pas le dessin par les fenetres qui recouvrent celle-ci :
    rien n'est dessine hors de WM_PAINT quand un menu est ouvert ou qu'une
    autre fenetre est active (la musique continue) ; tout est redessine au
    retour }
  Cap := WinQueryCapture(HWND_DESKTOP);
  { un menu ouvert a la capture de la souris ; WM_MENUEND peut manquer }
  If (MenuUp <> 0) And (Cap = 0) Then
  Begin
    Inc(MenuStale);
    If MenuStale > 5 Then MenuUp := 0;
  End
  Else MenuStale := 0;
  If (MenuUp <> 0) Or ((Cap <> 0) And (Cap <> Client)) Or (WinQueryActiveWindow(HWND_DESKTOP) <> FrameW) Then
  Begin
    WasActive := 0;
    Exit;
  End;
  If WasActive = 0 Then
  Begin
    WasActive := 1;
    LastSecs := -1;
    Redraw;
    Exit;
  End;
  BeginDraw;
  Secs := ShownMs Div 1000;
  If (Secs <> LastSecs) Or (PState <> LastState) Or (PlCur <> LastTrack) Then
  Begin
    DrawTime;
    If Drag <> 1 Then DrawPosition;
    DrawInfo;
    If (PState <> LastState) Or (PlCur <> LastTrack) Then
    Begin
      DrawButton(2); DrawButton(3);
      If Tab = 0 Then DrawListRows;
      UpdateTitleBar;
    End;
    LastSecs := Secs; LastState := PState; LastTrack := PlCur;
  End;
  Inc(ScrollT);
  If (ScrollT >= 3) Or (StatusT > 0) Then
  Begin
    If ScrollT >= 3 Then
    Begin
      ScrollT := 0;
      If Length(TitleText) > (DX1 - 8 - TxX) Div 8 Then Inc(ScrollX) Else ScrollX := 0;
    End;
    DrawTitle;
  End;
  DrawSpectrum(False);
  EndDraw;
End;

