Procedure ShowInfo;
Var I, Dur : LongInt; S : String;
Begin
  I := PlSel;
  If I < 0 Then I := PlCur;
  If I < 0 Then Exit;
  LClr;
  LAdd(Acc('Fichier : ') + Pl^[I]^.Path + #10);
  If MP3Info(Pl^[I]^.Path, Dur) Then
  Begin
    If InfTitle <> '' Then LAdd('Titre : ' + InfTitle + #10);
    If InfArtist <> '' Then LAdd('Artiste : ' + InfArtist + #10);
    If InfAlbum <> '' Then LAdd('Album : ' + InfAlbum + #10);
    If Dur >= 0 Then LAdd(Acc('Dur^ee : ') + TimeStr(Dur) + #10);
  End
  Else LAdd(Acc('Fichier introuvable ou sans trame MP3.') + #10);
  If (I = PlCur) And (PState <> 0) And (TrackOk <> 0) Then
  Begin
    S := 'MPEG Layer III, ' + IStr(TrackRate) + ' Hz, ';
    If TrackCh = 1 Then S := S + 'mono' Else S := S + Acc('st^er^eo');
    LAdd(S + ', ' + IStr(TrackKbps) + ' kbit/s' + #10);
    LAdd(Acc('Trames : ') + IStr(FrameCnt) + #10);
  End;
  Dummy := LMsgBox(Acc('Informations sur le morceau'), MB_OK Or MB_INFORMATION);
End;

