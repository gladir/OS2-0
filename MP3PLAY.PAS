Procedure DlgAdd(S : String);
Var NA : PDlgArr; NC, K : LongInt; P : PDlgStr;
Begin
  { elements du dialogue : tableau de pointeurs agrandi au besoin }
  If DlgN >= DlgCap Then
  Begin
    NC := DlgCap * 2;
    If NC < 256 Then NC := 256;
    GetMem(NA, NC * 4);
    For K := 0 To DlgN - 1 Do NA^[K] := DlgItem^[K];
    If DlgCap > 0 Then FreeMem(DlgItem, DlgCap * 4);
    DlgItem := NA; DlgCap := NC;
  End;
  GetMem(P, SizeOf(TDlgStr));
  P^ := S;
  DlgItem^[DlgN] := P;
  Inc(DlgN);
End;

Procedure DlgFill;
Var H, N, Rc, A, K, Dk, L : LongInt; S, E : String; Fb : Array[0..299] Of Byte;
Begin
  Dummy := WinSendMsg(DlgList, LM_DELETEALL, 0, 0);
  For K := 0 To DlgN - 1 Do FreeMem(DlgItem^[K], SizeOf(TDlgStr));
  DlgN := 0;
  Dk := 0; L := 0;
  Dummy := DosQueryCurrentDisk(LongInt(@Dk), LongInt(@L));
  For K := 2 To 25 Do
    If (L And (1 Shl K)) <> 0 Then DlgAdd('<' + Chr(65 + K) + ':>');
  For Rc := 0 To 1 Do
  Begin
    H := -1; N := 1;
    If DosFindFirst(Z(DlgDir + '*.*'), LongInt(@H), $37, LongInt(@Fb), 300, LongInt(@N), 1) = 0 Then
    Begin
      Repeat
        A := RdL(LongInt(@Fb) + 24);
        S := '';
        For K := 0 To Fb[28] - 1 Do S := S + Chr(Fb[29 + K]);
        E := ExtOf(S);
        If (S <> '.') And (Length(S) <= 78) Then
        Begin
          If (Rc = 0) And ((A And $10) <> 0) Then
            DlgAdd('[' + S + ']')
          Else If (Rc = 1) And ((A And $10) = 0) And (DlgMode <> 3) And
                  (((DlgMode >= 4) And (E = '.M3U')) Or ((DlgMode < 4) And ((E = '.MP3') Or (E = '.M3U')))) Then
            DlgAdd(S);
        End;
        N := 1;
      Until DosFindNext(H, LongInt(@Fb), 300, LongInt(@N)) <> 0;
      Dummy := DosFindClose(H);
    End;
  End;
  For K := 0 To DlgN - 1 Do Dummy := WinSendMsg(DlgList, LM_INSERTITEM, -1, Z(DlgItem^[K]^));
  Dummy := WinInvalidateRect(DlgClient, 0, 0);
End;

Procedure DlgClose;
Begin
  If DlgFrame = 0 Then Exit;
  Dummy := WinEnableWindow(FrameW, 1);
  Dummy := WinSetFocus(HWND_DESKTOP, Client);
  Dummy := WinDestroyWindow(DlgFrame);
  DlgFrame := 0;
  Redraw;
End;

Procedure DlgAccept(All : Boolean);
Var S : String;
Begin
  If All Or (DlgMode = 3) Then
  Begin
    DlgResult := DlgDir;
    Dummy := WinPostMsg(Client, WM_FILEDONE, DlgMode + 100, 0);
    DlgClose;
    Exit;
  End;
  Dummy := WinQueryWindowText(DlgEntry, 250, LongInt(@TxtBuf));
  S := TrimS(GetZ(LongInt(@TxtBuf)));
  If S = '' Then Exit;
  If (Pos(':', S) = 0) And (Copy(S, 1, 1) <> '\') Then S := DlgDir + S;
  If (DlgMode = 5) And (ExtOf(S) = '') Then S := S + '.M3U';
  DlgResult := S;
  Dummy := WinPostMsg(Client, WM_FILEDONE, DlgMode, 0);
  { Ajouter : la boite reste ouverte pour en ajouter d'autres }
  If DlgMode = 2 Then
  Begin
    Dummy := WinSetWindowText(DlgEntry, Z(''));
    Exit;
  End;
  DlgClose;
End;

Procedure DlgPick(Enter : Boolean);
Var I : LongInt; S : String;
Begin
  I := WinSendMsg(DlgList, LM_QUERYSELECTION, -1, 0);
  If (I < 0) Or (I >= DlgN) Then Exit;
  S := DlgItem^[I]^;
  If S[1] = '<' Then
  Begin
    If Enter Then
    Begin
      DlgDir := Copy(S, 2, 2) + '\';
      DlgFill;
    End;
  End
  Else If S[1] = '[' Then
  Begin
    If Enter Then
    Begin
      S := Copy(S, 2, Length(S) - 2);
      If S = '..' Then
      Begin
        Delete(DlgDir, Length(DlgDir), 1);
        While (Length(DlgDir) > 0) And (DlgDir[Length(DlgDir)] <> '\') Do Delete(DlgDir, Length(DlgDir), 1);
      End
      Else DlgDir := DlgDir + S + '\';
      DlgFill;
    End;
  End
  Else
  Begin
    Dummy := WinSetWindowText(DlgEntry, Z(S));
    If Enter Then DlgAccept(False);
  End;
End;

Function DlgProc(H, Msg0, Mp1, Mp2 : LongInt) : LongInt;
Var Rc : Array[0..3] Of LongInt; Hp, K : LongInt; S : String;
Begin
  DlgProc := 0;
  Case Msg0 Of
    WM_PAINT :
      Begin
        Hp := WinBeginPaint(H, 0, 0);
        Dummy := WinQueryWindowRect(H, LongInt(@Rc));
        Dummy := WinFillRect(Hp, LongInt(@Rc), CLR_PALEGRAY);
        If DlgMode = 3 Then S := Acc('Dossier ^a ajouter (tous ses fichiers MP3) :')
        Else S := 'Nom du fichier :';
        PutZ(LongInt(@TxtBuf), S);
        Rc[0] := 12; Rc[1] := Rc[3] - 22; Rc[2] := 12 + Length(S) * 8; Rc[3] := Rc[3] - 6;
        Dummy := WinDrawText(Hp, Length(S), LongInt(@TxtBuf), LongInt(@Rc), CLR_BLACK, CLR_PALEGRAY, 0);
        S := Acc('Dossier : ') + DlgDir;
        If Length(S) > 46 Then S := Copy(S, 1, 3) + '...' + Copy(S, Length(S) - 39, 40);
        PutZ(LongInt(@TxtBuf), S);
        Rc[1] := Rc[1] - 50; Rc[3] := Rc[1] + 16; Rc[2] := 12 + Length(S) * 8;
        Dummy := WinDrawText(Hp, Length(S), LongInt(@TxtBuf), LongInt(@Rc), CLR_DARKBLUE, CLR_PALEGRAY, 0);
        Dummy := WinEndPaint(Hp);
      End;
    WM_COMMAND :
      If Lo16(Mp1) = ID_DLGOK Then DlgAccept(False)
      Else If Lo16(Mp1) = ID_DLGALL Then DlgAccept(True)
      Else DlgClose;
    WM_CONTROL :
      If Lo16(Mp1) = ID_DLGLIST Then
      Begin
        If Hi16(Mp1) = LN_ENTER Then DlgPick(True)
        Else If Hi16(Mp1) = LN_SELECT Then DlgPick(False);
      End;
    WM_CHAR :
      If ((Lo16(Mp1) And KC_KEYUP) = 0) And ((Lo16(Mp1) And KC_VIRTUALKEY) <> 0) Then
      Begin
        K := Hi16(Mp2);
        If (K = VK_NEWLINE) Or (K = VK_ENTER) Then DlgAccept(False)
        Else If K = VK_ESC Then DlgClose
        Else DlgProc := WinDefWindowProc(H, Msg0, Mp1, Mp2);
      End
      Else DlgProc := WinDefWindowProc(H, Msg0, Mp1, Mp2);
    WM_CLOSE : DlgClose;
  Else
    DlgProc := WinDefWindowProc(H, Msg0, Mp1, Mp2);
  End;
End;

{ Mode : 1 ouvrir (remplace la liste et joue), 2 ajouter des fichiers,
  3 ajouter un dossier, 4 ouvrir une liste M3U, 5 enregistrer la liste }
Procedure FileDialog(Mode : LongInt);
Var Fl, W, Hh, Sw, Sh, Hw : LongInt; T, Ok : String; Rc : Array[0..3] Of LongInt;
Begin
  If DlgFrame <> 0 Then Exit;
  DlgMode := Mode;
  If DlgDir = '' Then DlgDir := 'C:\';
  Case Mode Of
    1 : Begin T := 'Ouvrir un fichier MP3'; Ok := 'Ouvrir'; End;
    2 : Begin T := 'Ajouter des fichiers'; Ok := 'Ajouter'; End;
    3 : Begin T := 'Ajouter un dossier'; Ok := 'Ajouter ce dossier'; End;
    4 : Begin T := 'Ouvrir une liste de lecture'; Ok := 'Ouvrir'; End;
  Else
    Begin T := 'Enregistrer la liste de lecture'; Ok := 'Enregistrer'; End;
  End;
  Fl := FCF_TITLEBAR Or FCF_DLGBORDER;
  DlgClient := 0;
  DlgFrame := WinCreateStdWindow(HWND_DESKTOP, 0, LongInt(@Fl), Z('MP3PLAYDLG'), Z2(Acc(T)), 0, 0, 0,
                                 LongInt(@DlgClient));
  If (DlgFrame = 0) Or (DlgClient = 0) Then Exit;
  W := 420; Hh := 330;
  Sw := WinQuerySysValue(HWND_DESKTOP, 20); Sh := WinQuerySysValue(HWND_DESKTOP, 21);
  Dummy := WinSetWindowPos(DlgFrame, HWND_TOP, (Sw - W) Div 2, (Sh - Hh) Div 2, W, Hh,
                           SWP_SIZE Or SWP_MOVE Or SWP_ZORDER Or SWP_SHOW Or SWP_ACTIVATE);
  Dummy := WinQueryWindowRect(DlgClient, LongInt(@Rc));
  Hh := Rc[3];
  DlgEntry := WinCreateWindow(DlgClient, WC_ENTRYFIELD, Z(''), WS_VISIBLE Or WS_TABSTOP Or ES_AUTOSCROLL Or ES_MARGIN,
                              12, Hh - 48, W - 34, 22, DlgClient, HWND_BOTTOM, ID_DLGENTRY, 0, 0);
  If (Mode = 5) And (ListName <> '') Then Dummy := WinSetWindowText(DlgEntry, Z(BaseName(ListName)));
  If Mode = 3 Then Dummy := WinEnableWindow(DlgEntry, 0);
  DlgList := WinCreateWindow(DlgClient, WC_LISTBOX, Z(''), WS_VISIBLE Or WS_TABSTOP, 12, 44, W - 34, Hh - 120,
                             DlgClient, HWND_BOTTOM, ID_DLGLIST, 0, 0);
  Hw := WinCreateWindow(DlgClient, WC_BUTTON, Z(Acc(Ok)), WS_VISIBLE Or WS_TABSTOP Or BS_DEFAULT, 12, 8,
                        Length(Ok) * 8 + 24, 26, DlgClient, HWND_BOTTOM, ID_DLGOK, 0, 0);
  If (Mode = 1) Or (Mode = 2) Then
    Hw := WinCreateWindow(DlgClient, WC_BUTTON, Z('Tout le dossier'), WS_VISIBLE Or WS_TABSTOP,
                          Length(Ok) * 8 + 44, 8, 140, 26, DlgClient, HWND_BOTTOM, ID_DLGALL, 0, 0);
  If Mode = 2 Then T := 'Fermer' Else T := 'Annuler';
  Hw := WinCreateWindow(DlgClient, WC_BUTTON, Z(T), WS_VISIBLE Or WS_TABSTOP, W - 122, 8, 100, 26, DlgClient,
                        HWND_BOTTOM, ID_DLGCANCEL, 0, 0);
  DlgFill;
  Dummy := WinEnableWindow(FrameW, 0);
  If Mode = 3 Then Dummy := WinSetFocus(HWND_DESKTOP, DlgList) Else Dummy := WinSetFocus(HWND_DESKTOP, DlgEntry);
End;

{ resultat de la boite (WM_FILEDONE) }
Procedure FileDone(Mode : LongInt);
Var N0 : LongInt;
Begin
  N0 := PlN;
  Case Mode Of
    1 :
      Begin
        StopPlayback; PlClear;
        AddPath(DlgResult);
        If PlN > 0 Then
        Begin
          PlSel := 0;
          StartTrack(0, 0);
        End;
      End;
    101 :
      Begin
        StopPlayback; PlClear;
        AddDir(DlgResult);
        If PlN > 0 Then
        Begin
          PlSel := 0;
          StartTrack(0, 0);
        End;
      End;
    2 : AddPath(DlgResult);
    102, 103 : AddDir(DlgResult);
    4 :
      Begin
        StopPlayback; PlClear;
        LoadM3U(DlgResult);
        ListName := DlgResult;
        If PlN > 0 Then PlSel := 0;
      End;
    5 :
      If SaveM3U(DlgResult) Then
      Begin
        ListName := DlgResult;
        SetStatus(Acc('Liste enregistr^ee : ') + BaseName(DlgResult));
      End
      Else SetStatus(Acc('Impossible d''enregistrer ') + DlgResult);
  End;
  If (Mode = 2) Or (Mode = 102) Or (Mode = 103) Then
  Begin
    If PlN > N0 Then SetStatus(IStr(PlN - N0) + Acc(' morceau(x) ajout^e(s)'))
    Else SetStatus(Acc('Aucun fichier MP3 ajout^e'));
  End;
  EnsureVisible;
  Redraw;
End;

