Procedure Redraw;
Begin
  If Client <> 0 Then Dummy := WinInvalidateRect(Client, 0, 0);
End;

Procedure SetStatus(S : String);
Begin
  StatusMsg := S;
  StatusT := 40;
End;

Procedure StopPlayback;
Var K : LongInt;
Begin
  If DecRun <> 0 Then
  Begin
    DecStop := 1;
    K := 0;
    While (DecRun <> 0) And (K < 300) Do
    Begin
      Dummy := DosSleep(10);
      Inc(K);
    End;
  End;
  Dummy := MdmStop;
  StreamOn := 0; PState := 0; PauseReq := 0;
End;

{ temps joue du morceau (ms) }
Function CurMs : LongInt;
Var Bps : LongInt;
Begin
  If (PState = 0) Or (TrackOk = 0) Or (TrackRate = 0) Then
  Begin
    If PState = 0 Then CurMs := 0 Else CurMs := TrackStart;
    Exit;
  End;
  Bps := TrackRate * TrackCh * 2;
  CurMs := TrackStart + Round(Played * 1000.0 / Bps);
End;

Procedure StartTrack(I, FromMs : LongInt);
Begin
  StopPlayback;
  If (I < 0) Or (I >= PlN) Then Exit;
  PlCur := I;
  Pl^[I]^.Played := True;
  DecPath := Pl^[I]^.Path;
  TrackTitle := Pl^[I]^.Title;
  SeekMs := MaxI(0, FromMs);
  TrackOk := 0; TrackStart := SeekMs; TrackRate := 0; TrackKbps := 0; TrackDur := Pl^[I]^.Dur;
  Played := 0; Fed := 0;
  DecStop := 0; DecDone := 0; DecError := False; DecErrMsg := '';
  ScrollX := 0; ScrollT := 0;
  DecRun := 1; PState := 1; PauseReq := 0;
  If DosCreateThread(LongInt(@DecTid), LongInt(@DecThread), 0, 0, 131072) <> 0 Then
  Begin
    DecRun := 0; PState := 0;
    SetStatus(Acc('Impossible de cr^eer le fil de d^ecodage.'));
  End;
  Redraw;
End;

{ morceau suivant (Auto : fin du morceau) ; -1 : fin de la liste }
Function NextIndex(Auto : Boolean) : LongInt;
Var K, N, Pick : LongInt;
Begin
  NextIndex := -1;
  If PlN = 0 Then Exit;
  If Auto And (RepOne <> 0) And (PlCur >= 0) Then
  Begin
    NextIndex := PlCur;
    Exit;
  End;
  If Shuffle <> 0 Then
  Begin
    N := 0;
    For K := 0 To PlN - 1 Do If Not Pl^[K]^.Played Then Inc(N);
    If N = 0 Then
    Begin
      If Auto And (RepList = 0) Then Exit;
      For K := 0 To PlN - 1 Do If K <> PlCur Then Pl^[K]^.Played := False;
      N := 0;
      For K := 0 To PlN - 1 Do If Not Pl^[K]^.Played Then Inc(N);
      If N = 0 Then
      Begin
        NextIndex := PlCur;
        Exit;
      End;
    End;
    Pick := Rnd(N);
    For K := 0 To PlN - 1 Do
      If Not Pl^[K]^.Played Then
      Begin
        If Pick = 0 Then
        Begin
          NextIndex := K;
          Exit;
        End;
        Dec(Pick);
      End;
    Exit;
  End;
  K := PlCur + 1;
  If K >= PlN Then
  Begin
    If Auto And (RepList = 0) Then Exit;
    K := 0;
  End;
  NextIndex := K;
End;

Procedure PlayToggle;
Begin
  If PState = 1 Then
  Begin
    If StreamOn <> 0 Then Dummy := MdmPause(1) Else PauseReq := 1;
    PState := 2;
  End
  Else If PState = 2 Then
  Begin
    If StreamOn <> 0 Then Dummy := MdmPause(0);
    PauseReq := 0;
    PState := 1;
  End
  Else
  Begin
    If PlN = 0 Then
    Begin
      SetStatus(Acc('La liste de lecture est vide : Fichier, Ajouter des fichiers.'));
      Exit;
    End;
    If PlSel >= 0 Then StartTrack(PlSel, 0)
    Else If PlCur >= 0 Then StartTrack(PlCur, 0)
    Else StartTrack(0, 0);
  End;
  Redraw;
End;

Procedure StopCmd;
Begin
  StopPlayback;
  Redraw;
End;

Procedure NextCmd;
Var K : LongInt;
Begin
  K := NextIndex(False);
  If K >= 0 Then
  Begin
    If PState = 0 Then
    Begin
      PlCur := K; PlSel := K; TrackTitle := Pl^[K]^.Title;
      Redraw;
    End
    Else StartTrack(K, 0);
  End;
End;

Procedure PrevCmd;
Var K : LongInt;
Begin
  If PlN = 0 Then Exit;
  If (PState <> 0) And (CurMs > 3000) Then
  Begin
    StartTrack(PlCur, 0);
    Exit;
  End;
  K := PlCur - 1;
  If K < 0 Then
  Begin
    If RepList <> 0 Then K := PlN - 1 Else K := 0;
  End;
  If PState = 0 Then
  Begin
    PlCur := K; PlSel := K; TrackTitle := Pl^[K]^.Title;
    Redraw;
  End
  Else StartTrack(K, 0);
End;

Procedure SeekTo(Ms : LongInt);
Var Was : LongInt;
Begin
  If (PlCur < 0) Or (PState = 0) Then Exit;
  If (TrackDur > 0) And (Ms > TrackDur - 500) Then Ms := TrackDur - 500;
  If Ms < 0 Then Ms := 0;
  Was := PState;
  StartTrack(PlCur, Ms);
  If Was = 2 Then
  Begin
    PauseReq := 1; PState := 2;
  End;
End;

