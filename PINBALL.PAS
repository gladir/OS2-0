{ recopier la partie Sx1..Sx2, Sy1..Sy2 d'une image (W x H) en (Dx, Dy) }
Procedure Blit(H, PBits, PBmi, BufH, Sx1, Sy1, Sx2, Sy2, Dx, Dy : LongInt);
Var P : Array[0..7] Of LongInt;
Begin
  P[0] := Dx; P[1] := CH - (Dy + Sy2 - Sy1) - 1; P[2] := Dx + Sx2 - Sx1 + 1; P[3] := CH - Dy;
  P[4] := Sx1; P[5] := BufH - 1 - Sy2; P[6] := Sx2 + 1; P[7] := BufH - Sy1;
  Dummy := GpiDrawBits(H, PBits, PBmi, 4, LongInt(@P), $CC, 0);
End;

{ partie visible de la table }
Procedure BlitTable(H, X1, Y1, X2, Y2 : LongInt);
Begin
  If Y1 < ScrollY Then Y1 := ScrollY;
  If Y2 > ScrollY + VH - 1 Then Y2 := ScrollY + VH - 1;
  If (Y2 < Y1) Or (X2 < X1) Then Exit;
  Blit(H, LongInt(@Fb), LongInt(@Bmi), TH, X1, Y1, X2, Y2, OX + X1, VY + Y1 - ScrollY);
End;

Procedure Button(X, Y, W, H : LongInt; S : String);
Begin
  FBar(X, Y, X + W - 1, Y + H - 1, CLR_PALEGRAY);
  Edge(X, Y, X + W - 1, Y + H - 1, CLR_WHITE, CLR_BLACK);
  Edge(X + 1, Y + 1, X + W - 2, Y + H - 2, CLR_PALEGRAY, CLR_DARKGRAY);
  OutTxt(X + (W - Length(S) * 8) Div 2, Y + (H - 16) Div 2, S, CLR_BLACK, CLR_PALEGRAY);
End;

Function TableName : String;
Begin
  If Table = 1 Then TableName := 'Glace' Else TableName := 'Rat de l''espace';
End;

Procedure DrawCounters;
Var K, Y, C : LongInt; S : String;
Begin
  FBar(PnX, 52, MapX - 6, 206, CLR_PALEGRAY);
  For K := 1 To MaxPlayer Do
  Begin
    Y := 52 + (K - 1) * 34;
    If (K = Act) And (State <> S_OVER) Then C := CLR_DARKBLUE Else C := CLR_DARKGRAY;
    S := 'Joueur ' + IStr(K);
    If Balls[K] >= MaxBalls Then S := S + ' (fini)'
    Else S := S + ' - balle ' + IStr(Balls[K]);
    OutTxt(PnX, Y, S, C, CLR_PALEGRAY);
    OutTxt(PnX + 8, Y + 16, IStr(Score[K]), CLR_BLACK, CLR_PALEGRAY);
  End;
  If Table = 1 Then K := Best1 Else K := Best2;
  If K > 0 Then OutTxt(PnX, 188, 'Record : ' + IStr(K), CLR_DARKRED, CLR_PALEGRAY);
End;

{ carte de la table : balle et partie visible }
Procedure DrawMap(H : LongInt);
Var Y0, Y1, Bx, By : LongInt;
Begin
  Blit(H, LongInt(@MapB), LongInt(@MapBmi), MapH, 0, 0, MapW - 1, MapH - 1, MapX, MapY);
  Y0 := MapY + ScrollY Div 4; Y1 := MapY + (ScrollY + VH) Div 4 - 1;
  If Y1 > MapY + MapH - 1 Then Y1 := MapY + MapH - 1;
  Edge(MapX, Y0, MapX + MapW - 1, Y1, CLR_YELLOW, CLR_YELLOW);
  If BallOn Then
  Begin
    Bx := MapX + (BallX + 8) Div 4; By := MapY + (BallY + 8) Div 4;
    FBar(Bx - 1, By - 1, Bx + 1, By + 1, CLR_WHITE);
  End;
End;

Procedure DrawPanel;
Begin
  BigText(PnX, 8, 'PINBALL', CLR_DARKBLUE, CLR_PALEGRAY);
  OutTxt(PnX, 30, 'Table : ' + TableName, CLR_BLACK, CLR_PALEGRAY);
  Edge(MapX - 2, MapY - 2, MapX + MapW + 1, MapY + MapH + 1, CLR_DARKGRAY, CLR_WHITE);
  Edge(MapX - 1, MapY - 1, MapX + MapW, MapY + MapH, CLR_BLACK, CLR_PALEGRAY);
  DrawCounters;
  Button(PnX, 214, 158, 28, 'Nouvelle partie');
  Button(PnX, 248, 158, 28, 'Pause');
  OutTxt(PnX, 288, 'Maj gauche / droite :', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(PnX + 16, 304, 'batteurs', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(PnX, 320, 'Espace : tirer, l' + Chr(131) + 'cher', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(PnX, 336, '(ou Ctrl tenu) ; K : secouer', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(PnX, 352, 'P : pause', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(PnX, 368, 'F2 : nouvelle partie', CLR_DARKGRAY, CLR_PALEGRAY);
  OutTxt(PnX, 384, 'F1 : r' + Chr(138) + 'gles', CLR_DARKGRAY, CLR_PALEGRAY);
End;

Procedure DrawStatus;
Begin
  FBar(0, CH - 22, CW - 1, CH - 1, CLR_PALEGRAY);
  Edge(2, CH - 21, CW - 3, CH - 2, CLR_DARKGRAY, CLR_WHITE);
  OutTxt(8, CH - 19, Msg, CLR_BLACK, CLR_PALEGRAY);
End;

Procedure PaintAll(H : LongInt);
Begin
  Hps := WinBeginPaint(H, 0, 0);
  FBar(0, 0, CW - 1, CH - 1, CLR_PALEGRAY);
  Edge(OX - 2, LedY - 2, OX + TW + 1, LedY + LedH + 1, CLR_DARKGRAY, CLR_WHITE);
  Edge(OX - 2, VY - 2, OX + TW + 1, VY + VH + 1, CLR_DARKGRAY, CLR_WHITE);
  RenderLed;
  Blit(Hps, LongInt(@LedB), LongInt(@LedBmi), LedH, 0, 0, TW - 1, LedH - 1, OX, LedY);
  BlitTable(Hps, 0, 0, TW - 1, TH - 1);
  NDirty := 0; PalDirty := 0; Scrolled := 0; LedDirty := 0;
  DrawPanel;
  DrawMap(Hps);
  DrawStatus;
  Dummy := WinEndPaint(Hps);
End;

Procedure Frame1;
Var K, T : LongInt;
Begin
  If Client = 0 Then Exit;
  Hps := WinGetPS(Client);
  If Hps = 0 Then Exit;
  If LedDirty <> 0 Then
  Begin
    RenderLed;
    Blit(Hps, LongInt(@LedB), LongInt(@LedBmi), LedH, 0, 0, TW - 1, LedH - 1, OX, LedY);
    LedDirty := 0;
  End;
  If (PalDirty <> 0) Or (Scrolled <> 0) Then BlitTable(Hps, 0, 0, TW - 1, TH - 1)
  Else For K := 0 To NDirty - 1 Do BlitTable(Hps, DX1[K], DY1[K], DX2[K], DY2[K]);
  T := PalDirty;
  NDirty := 0; PalDirty := 0; Scrolled := 0;
  If (Tick Mod 4 = 0) Or (T <> 0) Then DrawMap(Hps);
  If Tick Mod 8 = 0 Then
  Begin
    DrawCounters;
    DrawStatus;
  End;
  Dummy := WinReleasePS(Hps);
End;

{ la table defile pour suivre la balle }
Procedure FollowBall;
Var T, D : LongInt;
Begin
  T := BallY + 8 - VH Div 2 + 60;
  If T < 0 Then T := 0;
  If T > TH - VH Then T := TH - VH;
  D := T - ScrollY;
  If D > 24 Then D := 24;
  If D < -24 Then D := -24;
  If D <> 0 Then
  Begin
    ScrollY := ScrollY + D;
    Scrolled := 1;
  End;
End;

Procedure TimerTick;
Var K : LongInt;
Begin
  If State = S_PAUSE Then Exit;
  Inc(Tick);
  If State = S_PLAY Then
  Begin
    For K := 1 To 2 Do
    Begin
      GameStep;
      LedStep;
    End;
    If (Table = 1) And PushUp And (Tick Mod 3 = 0) Then FlameFlacker;
    FollowBall;
  End
  Else
  Begin
    LedStep;
    If (State = S_OVER) And QEmpty And (LedHold = 0) And (LedTyping = 0) And (Tick Mod 90 = 0) Then
    Begin
      If (Tick Div 90) Mod 2 = 0 Then Say('* P I N B A L L *') Else Say('F2 : NOUVELLE PARTIE');
    End;
    If (State = S_OVER) And (AutoAll <> 0) And (Tick Mod 150 = 0) Then NewGame;
  End;
  Frame1;
End;

Procedure TogglePause;
Begin
  If State = S_PLAY Then
  Begin
    State := S_PAUSE;
    Msg := 'Pause. P : reprendre.';
    Say('-- P A U S E --');
    LedTyping := 0; LedPos := 0;
    While LedPos < 20 Do Begin LedChar(LedPos * 8, LedText[LedPos + 1]); Inc(LedPos); End;
    Frame1;
    Hps := WinGetPS(Client);
    DrawStatus;
    Dummy := WinReleasePS(Hps);
  End
  Else If State = S_PAUSE Then
  Begin
    State := S_PLAY;
    Msg := 'Espace : tirer le ressort, Maj gauche et droite : batteurs.';
    Say(' ');
  End;
End;

Procedure SetMark(Id : LongInt; On : Boolean);
Var M : LongInt;
Begin
  M := WinWindowFromID(Frame, $8005);
  If M = 0 Then Exit;
  If On Then Dummy := WinSendMsg(M, MM_SETITEMATTR, Id Or $10000, MIA_CHECKED Or (MIA_CHECKED Shl 16))
  Else Dummy := WinSendMsg(M, MM_SETITEMATTR, Id Or $10000, MIA_CHECKED);
End;

Procedure SetMarks;
Begin
  SetMark(CM_TAB1, Table = 1); SetMark(CM_TAB2, Table = 2);
  SetMark(CM_PL1, MaxPlayer = 1); SetMark(CM_PL2, MaxPlayer = 2);
  SetMark(CM_PL3, MaxPlayer = 3); SetMark(CM_PL4, MaxPlayer = 4);
  SetMark(CM_SOUND, SoundOn <> 0);
End;

Procedure Command(Id : LongInt);
Begin
  Case Id Of
    CM_NEW : NewGame;
    CM_PAUSE : TogglePause;
    CM_NUDGE : Nudge;
    CM_QUIT : Dummy := WinPostMsg(Client, WM_CLOSE, 0, 0);
    CM_TAB1, CM_TAB2 :
      Begin
        UpdateBest;
        Table := Id - CM_TAB1 + 1;
        SetMarks;
        NewGame;
      End;
    CM_PL1, CM_PL2, CM_PL3, CM_PL4 :
      Begin
        MaxPlayer := Id - CM_PL1 + 1;
        SetMarks;
        NewGame;
      End;
    CM_SOUND :
      Begin
        If SoundOn <> 0 Then SoundOn := 0 Else SoundOn := 1;
        SetMarks;
      End;
    CM_RULES :
      Begin
        If State = S_PLAY Then TogglePause;
        LClr;
        LAdd('Tirez le ressort (Espace, puis Espace pour l' + Chr(131) + 'cher ; ou Ctrl tenu puis ' +
             'rel' + Chr(131) + 'ch' + Chr(130) + ') : plus il est tir' + Chr(130) + ', plus la balle part fort. ');
        LAdd('Les touches Maj gauche et Maj droite l' + Chr(138) + 'vent les batteurs. K secoue la table ; ' +
             'cinq secousses : TILT, la balle est perdue.' + Chr(10) + Chr(10));
        LAdd('Glace : P-C-S puis SPECIAL, lumi' + Chr(138) + 'res (9999), bumpers, boucles (10000 par boucle ' +
             'en fin de balle, une balle en prime ' + Chr(133) + ' 11), trou de ver, feux qui renvoient la ' +
             'balle tant que la temp' + Chr(130) + 'rature le permet. ');
        LAdd('Rat de l''espace : R-A-T (50000), P-H-A-S-E-R (10000 ' + Chr(133) + ' 50000), porte et balle ' +
             'verrouill' + Chr(130) + 'e, rampe, trous de sortie, relance (RL).' + Chr(10) + Chr(10));
        LAdd('Trois balles par joueur, de 1 ' + Chr(133) + ' 4 joueurs (menu Options). Les bonus sont compt' +
             Chr(130) + 's ' + Chr(133) + ' la fin de chaque balle.');
        Dummy := LMsgBox('Pinball - R' + Chr(138) + 'gles', MB_OK Or MB_INFORMATION);
      End;
    CM_ABOUT :
      Begin
        LClr;
        LAdd('Pinball pour OS/2-0 (Presentation Manager) : deux tables, Glace et Rat de l''espace, ' +
             'de 1 ' + Chr(133) + ' 4 joueurs.' + Chr(10) + 'Programme ' + Chr(130) + 'crit en Pascal et ' +
             'compil' + Chr(130) + ' par OS2PC.');
        Dummy := LMsgBox('A propos de Pinball', MB_OK Or MB_INFORMATION);
      End;
  End;
End;

Function KeyChar(Mp1, Mp2 : LongInt) : Boolean;
Var Fl0, Ch, Vk : LongInt;
Begin
  KeyChar := True;
  Fl0 := Lo16(Mp1); Ch := Lo16(Mp2) And 255; Vk := Hi16(Mp2);
  If (Fl0 And KC_KEYUP) <> 0 Then
  Begin
    KeyChar := False;
    Exit;
  End;
  If (Fl0 And KC_ALT) <> 0 Then
  Begin
    KeyChar := False;
    Exit;
  End;
  If (Fl0 And KC_VIRTUALKEY) <> 0 Then
  Begin
    If Vk = VK_F1 Then Begin Command(CM_RULES); Exit; End;
    If Vk = VK_F2 Then Begin Command(CM_NEW); Exit; End;
    If Vk = VK_PAUSE Then Begin TogglePause; Exit; End;
    If Vk = VK_LEFT Then Begin TapL := 10; Exit; End;
    If Vk = VK_RIGHT Then Begin TapR := 10; Exit; End;
    If (Vk = VK_SPACE) Or (Vk = VK_NEWLINE) Or (Vk = VK_ENTER) Or (Vk = VK_DOWN) Then
    Begin
      If State = S_PAUSE Then TogglePause
      Else If State = S_OVER Then NewGame
      Else StartPlunge;
      Exit;
    End;
    If (Vk = $09) Or (Vk = $0A) Or (Vk = $0B) Then Exit;   { Maj, Ctrl, Alt seules }
  End;
  If (Fl0 And KC_CHAR) <> 0 Then
  Begin
    Case UpCase(Chr(Ch)) Of
      'P' : TogglePause;
      'K' : Nudge;
      ' ' : StartPlunge;
    Else
      KeyChar := False;
    End;
    Exit;
  End;
  KeyChar := False;
End;

Procedure Click(Mx, My : LongInt);
Var X, Y : LongInt;
Begin
  X := Mx; Y := CH - 1 - My;
  If (X >= PnX) And (X < PnX + 158) Then
  Begin
    If (Y >= 214) And (Y < 242) Then NewGame
    Else If (Y >= 248) And (Y < 276) Then TogglePause;
  End;
End;

Function MainProc(H, Msg0, Mp1, Mp2 : LongInt) : LongInt;
Var Rc : Array[0..3] Of LongInt;
Begin
  MainProc := 0;
  Case Msg0 Of
    WM_SIZE :
      Begin
        Dummy := WinQueryWindowRect(H, LongInt(@Rc));
        CW := Rc[2]; CH := Rc[3];
      End;
    WM_PAINT : PaintAll(H);
    WM_TIMER : If Lo16(Mp1) = 1 Then TimerTick;
    WM_BUTTON1DOWN :
      Begin
        Dummy := WinSetFocus(HWND_DESKTOP, H);
        Click(S16(Mp1), S16(Mp1 Shr 16));
        MainProc := 1;
      End;
    WM_COMMAND : Command(Lo16(Mp1));
    WM_CHAR :
      If Not KeyChar(Mp1, Mp2) Then MainProc := WinDefWindowProc(H, Msg0, Mp1, Mp2) Else MainProc := 1;
    WM_CLOSE : Dummy := WinPostMsg(H, WM_QUIT, 0, 0);
  Else
    MainProc := WinDefWindowProc(H, Msg0, Mp1, Mp2);
  End;
End;

