End;

{ ==================================================================== }
{ Physique de la balle (Check_Ball de l'original)                       }
{ ==================================================================== }

Procedure CheckOben;
Var X, Y : LongInt; Contact : Boolean;
Begin
  Y := BallY; Contact := False;
  Repeat
    For X := BallX + 4 To BallX + 12 Do
      If TP(X, Y) > 127 Then
      Begin
        Contact := True;
        If X <= BallX + 8 Then Inc(O1) Else Inc(O2);
        Fo := TP(X, Y);
      End;
    Dec(Y);
  Until (Y <= BallY + SpY Div 2) Or Contact;
  Inc(Y); BallY := Y;
End;

Procedure CheckUnten;
Var X, Y : LongInt; Contact : Boolean;
Begin
  Y := BallY; Contact := False;
  Repeat
    For X := BallX + 4 To BallX + 12 Do
      If TP(X, Y + 14) > 127 Then
      Begin
        Contact := True;
        If X <= BallX + 8 Then Inc(U1) Else Inc(U2);
        Fu := TP(X, Y + 14);
      End;
    Inc(Y);
  Until (Y >= BallY + SpY Div 2) Or Contact;
  Dec(Y); BallY := Y;
End;

Procedure CheckLinks;
Var X, Y : LongInt; Contact : Boolean;
Begin
  X := BallX; Contact := False;
  Repeat
    For Y := BallY + 4 To BallY + 12 Do
      If TP(X, Y) > 127 Then
      Begin
        Contact := True;
        If Y <= BallY + 8 Then Inc(L1) Else Inc(L2);
        Fl := TP(X, Y);
      End;
    Dec(X);
    If X < 0 Then Begin X := 0; Contact := True; End;
  Until (X <= BallX + SpX Div 2) Or Contact;
  Inc(X); BallX := X;
End;

Procedure CheckRechts;
Var X, Y : LongInt; Contact : Boolean;
Begin
  X := BallX; Contact := False;
  Repeat
    For Y := BallY + 4 To BallY + 12 Do
      If TP(X + 14, Y) > 127 Then
      Begin
        Contact := True;
        If Y <= BallY + 8 Then Inc(R1) Else Inc(R2);
        Fr := TP(X, Y + 14);
      End;
    Inc(X);
    If X > 304 Then Begin X := 304; Contact := True; End;
  Until (X >= BallX + SpX Div 2) Or Contact;
  Dec(X); BallX := X;
End;

Procedure CheckBall;
Begin
  O1 := 0; O2 := 0; U1 := 0; U2 := 0; L1 := 0; L2 := 0; R1 := 0; R2 := 0;
  Fu := 0; Fo := 0; Fl := 0; Fr := 0;
  If SpY < 0 Then
  Begin
    CheckOben;
    If O1 + O2 > 0 Then
    Begin
      Dec(Kraft);
      If Kraft < 0 Then SpY := -(SpY Div 2);
    End;
    If (O1 > 0) And (O2 = 0) Then If SpX < 4 Then Inc(SpX);
    If (O1 = 0) And (O2 > 0) Then If SpX > -4 Then Dec(SpX);
  End;
  If SpY >= 0 Then
  Begin
    CheckUnten;
    If U1 + U2 > 0 Then
    Begin
      SpY := -(SpY Div 2);
      Kraft := Abs(SpY Div 2);
    End;
    If (U1 > 0) And (U2 = 0) Then If SpX < 4 Then Begin If Chance > 30 Then Inc(SpX) Else Inc(BallX); End;
    If (U1 = 0) And (U2 > 0) Then If SpX > -4 Then Begin If Chance > 30 Then Dec(SpX) Else Dec(BallX); End;
  End;
  If SpX <= 0 Then
  Begin
    CheckLinks;
    If L1 + L2 > 0 Then SpX := Abs((SpX + Abs(SpY) Div 3) Div 4);
    If (L1 > 0) And (L2 = 0) Then Inc(SpY);
    If (L1 = 0) And (L2 > 0) Then Dec(SpY);
  End;
  If SpX >= 0 Then
  Begin
    CheckRechts;
    If R1 + R2 > 0 Then SpX := -((SpX + Abs(SpY) Div 2) Div 4);
    If (R1 > 0) And (R2 = 0) Then Inc(SpY);
    If (R1 = 0) And (R2 > 0) Then Dec(SpY);
  End;
  If (L2 > 0) And (L1 = 0) Then
    If (U1 > 0) Or (U2 = 0) Then If SpX <= 0 Then Begin Inc(SpY); Inc(SpX); End;
  If (R2 > 0) And (R1 = 0) Then
    If (U1 = 0) And (U2 > 0) Then If SpX >= 0 Then Begin Inc(SpY); Dec(SpX); End;
  If (L1 > 0) And (L2 = 0) Then
    If (O1 > 0) Or (O2 = 0) Then If SpX >= 0 Then Dec(BallX);
  If (R1 > 0) And (R2 = 0) Then
    If (O1 = 0) And (O2 > 0) Then If SpX <= 0 Then Inc(BallX);
  { la table 2 est moins inclinee : la gravite agit deux pas sur trois }
  If Table = 2 Then
  Begin
    If Grad = 2 Then Grad := 0 Else Begin Inc(SpY); Inc(Grad); End;
  End
  Else Inc(SpY);
  If SpY > 100 Then SpY := 100;
End;

{ coup de batteur (analyse_arms) }
Procedure AnalyseArms;
Var W : LongInt;
Begin
  If (Fo > 0) And (SpY < 0) Then
  Begin
    SpY := Abs(SpY);
    Kraft := 0;
    Exit;
  End;
  If Table = 2 Then Begin If Abs(SpX) > 4 Then W := 0 Else W := 3; End Else W := 0;
  If BallX < 142 Then
  Begin
    If ArmLOld < ArmL Then
    Begin
      DrawArm(False);
      CheckBall;
      SpY := -Abs(BallX + 4 - ArmXL);
      If SpY < -50 Then SpY := -50;
      BallY := BallY + SpY;
      If Table = 1 Then Kraft := Abs(SpY) Else Kraft := Abs(SpY) - 10;
      Case ArmL Of
        1 : SpX := SpX + 7 + Rnd(4);
        2 : SpX := SpX + 5 + Rnd(4);
        4 : SpX := SpX - 5 - Rnd(4);
        5 : SpX := SpX - 7 - Rnd(4);
      End;
    End
    Else
    Begin
      Case ArmL Of
        1, 2 : SpX := SpX + (Abs(SpY) + W) Div 4;
        4, 5 : SpX := SpX - (Abs(SpY) + W) Div 4;
      End;
      If Table = 2 Then SpY := SpY + 2;
    End;
  End
  Else If ArmROld < ArmR Then
  Begin
    DrawArm(True);
    CheckBall;
    SpY := -Abs(ArmW - (BallX + 4 - ArmXR));
    If SpY < -50 Then SpY := -50;
    BallY := BallY + SpY;
    If Table = 1 Then Kraft := Abs(SpY) Else Kraft := Abs(SpY) - 10;
    Case ArmR Of
      1 : SpX := SpX - 7 - Rnd(4);
      2 : SpX := SpX - 5 - Rnd(4);
      4 : SpX := SpX + 5 + Rnd(4);
      5 : SpX := SpX + 7 + Rnd(4);
    End;
  End
  Else
  Begin
    Case ArmR Of
      1, 2 : SpX := SpX - (Abs(SpY) + W) Div 4;
      4, 5 : SpX := SpX + (Abs(SpY) + W) Div 4;
    End;
    If Table = 2 Then SpY := SpY + 2;
  End;
  Fl := 0; Fr := 0; Fu := 0; Fo := 0;
End;

