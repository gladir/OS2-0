Procedure LoadTable;
Var X, Y, B : LongInt;
Begin
  If Table = 1 Then
  Begin
    DTab := D_TAB1; DGro := D_GRO1; DArmL := D_ARML1; DArmR := D_ARMR1; DBall := D_BALL1;
    DFeder := D_FEDER1; DFont := D_FONT1;
    ArmXL := 79; ArmYL := 535; ArmXR := 159; ArmYR := 535;
  End
  Else
  Begin
    DTab := D_TAB2; DGro := D_GRO2; DArmL := D_ARML2; DArmR := D_ARMR2; DBall := D_BALL2;
    DFeder := D_FEDER2; DFont := D_FONT2;
    ArmXL := 84; ArmYL := 549; ArmXR := 155; ArmYR := 549;
  End;
  For Y := 0 To TH - 1 Do
  Begin
    B := (TH - 1 - Y) * TW;
    Move(Blob[DTab + Y * TW], Back[B], TW);
    Move(Blob[DGro + Y * TW], Gro[Y * TW], TW);
  End;
  Move(Back, Fb, SizeOf(Back));
  ArmL := 1; ArmR := 1; ArmLOld := 1; ArmROld := 1;
  DrawArm(False); DrawArm(True);
  StartPow := 0; FederY := 605; FederH := 40; Plunge := 0;
  SetFeder;
  { carte de la table (une ligne sur quatre) }
  For Y := 0 To MapH - 1 Do
    For X := 0 To MapW - 1 Do MapB[(MapH - 1 - Y) * MapW + X] := Back[(TH - 1 - Y * 4) * TW + X * 4];
End;

{ --- table 1 : temperature (thermometre "Coldness") et feux --- }
Procedure Thermo(T : LongInt);
Var Z : LongInt;
Begin
  For Z := 1 To 6 Do
    If Z <= T Then SetRGB(55 + Z, 0, 47, 47) Else SetRGB(55 + Z, 50, 0, 0);
  If (Table = 1) And (Temp = 0) And PushUp Then
  Begin
    QSay('ATTENTION :', 100);
    QSay('SURCHAUFFE !', 100);
    QSay('FEUX ETEINTS !', 100);
    PushUp := False;
    SetRGB(40, 10, 10, 60); SetRGB(41, 10, 10, 50); SetRGB(42, 10, 10, 40); SetRGB(43, 10, 10, 30);
  End;
End;

