    Begin
      QSay('MORT ' + IStr(Felder2 * 500) + ' x 5', 70);
      IncScore(Felder2 * 500 * 5);
      QScroll;
    End;
  End;
  QSay('Total ' + IStr(Score[Act]), 70);
  QScroll;
