        QSay('Boucle 10000 x ' + IStr(K), 35);
        IncScore(K * 10000);
      End;
      QScroll;
    End;
    If (PCSspe[1] = 1) And (PCSspe[2] = 1) And (PCSspe[3] = 1) And (Special = 1) Then
    Begin
      QSay('PCS SPECIAL COMPLET', 40);
      QScroll;
      IncScore(100000);
      QSay('>>> 100000 <<<', 40);
      QScroll;
    End;
  End
  Else
  Begin
    PlaySnd(9);
    QSay('>-BALLE-<>-PERDUE-<', 70);
    QScroll;
    If Locked = 1 Then
    Begin
      QSay('BALLE LIBEREE !', 70);
      QScroll;
      For K := 99 To 101 Do ResetCol(K);
      Pfeil := 0; Locked := 0;
      QAct(A_NEWBALL, 0, 1);
      Exit;
    End;
    If (RAT[24] = 1) And (RAT[25] = 1) And (RAT[26] = 1) Then
    Begin
      QSay('BONUS RAT : 50000', 40);
      QScroll;
      IncScore(50000);
    End;
    If Felder3 > 0 Then
