Procedure UpdateBest;
Var K : LongInt;
Begin
  For K := 1 To MaxPlayer Do
    If Table = 1 Then Begin If Score[K] > Best1 Then Best1 := Score[K]; End
    Else If Score[K] > Best2 Then Best2 := Score[K];
End;

Procedure GameOver;
Begin
  UpdateBest;
  State := S_OVER;
  BallOn := False;
  Msg := 'Partie termin' + Chr(130) + 'e. F2 : nouvelle partie.';
End;

{ joueur suivant, ou fin de la partie (fin de A_NEXTBALL) }
Procedure NextBall;
Var K, N : LongInt;
Begin
  Inc(Balls[Act]);
  If Balls[Act] >= MaxBalls Then QSay('* PARTIE TERMINEE *', 70);
  N := 0;
  Repeat
    Inc(Act);
    If Act > MaxPlayer Then Act := 1;
    Inc(N);
  Until (Balls[Act] < MaxBalls) Or (N > MaxPlayer);
  If Balls[Act] >= MaxBalls Then
  Begin
    QAct(A_NEWBALL, 1, 0);
    Exit;
  End;
  If MaxPlayer > 1 Then
  Begin
    QSay('Joueur suivant : ' + IStr(Act), 70);
    QScroll;
  End;
  QSay('Balle ' + IStr(Balls[Act]), 60);
  QScroll;
  Shakes := 0;
  QAct(A_NEWBALL, 0, 0);
  K := 0;
End;

Procedure NewGame;
Var K : LongInt;
Begin
  QHead := 0; QTail := 0;
  For K := 1 To 4 Do Begin Score[K] := 0; Balls[K] := 1; End;
  Act := 1; Shakes := 0;
  LoadTable;
  InitTisch;
  InitBallValues;
  State := S_PLAY;
  ScrollY := TH - VH; Scrolled := 1;
  LedClear;
  If Table = 1 Then Say('*** LA GLACE ***') Else Say('* LE RAT ESPACE *');
  Msg := 'Espace : tirer le ressort, Maj gauche et droite : batteurs.';
  If Client <> 0 Then Dummy := WinInvalidateRect(Client, 0, 0);
End;

{ action de la file (apres les messages qui la precedent) }
Procedure DoAction(A, P1, P2 : LongInt);
Begin
  Case A Of
    A_NEXTBALL : NextBall;
    A_NEWBALL :
      If P1 = 1 Then GameOver
      Else
      Begin
        { P2 = 1 : balle liberee ou verrouillee, la table garde son etat }
        If P2 = 0 Then InitTisch;
        InitBallValues;
        SenkArms;
      End;
    A_SETBALL :
      Begin
        BallX := P1; BallY := P2;
        MoveBall;
      End;
    A_SPEED :
      Begin
        SpX := P1; SpY := P2;
        If Table = 2 Then MaxFarbe := 150;
      End;
    A_FREE :
      If P2 <> 0 Then MaxFarbe := P2;
  End;
End;

{ ressort : Plunge 1 tire, 2 revient (puis la balle part) }
Procedure PlungerStep;
Begin
  If Plunge = 1 Then
  Begin
    If StartPow < 75 Then
    Begin
      StartPow := StartPow + 2;
      If StartPow >= 75 Then PlaySnd(1);
      FederY := 605 + StartPow Div 5;
      FederH := 40 - StartPow Div 5;
      SetFeder;
    End;
    Inc(PlungeT);
  End
  Else If Plunge = 2 Then
  Begin
    FederY := FederY - 2;
    If FederH < 39 Then FederH := FederH + 2 Else FederH := 40;
    If FederY <= 605 Then
    Begin
      FederY := 605; FederH := 40;
      Plunge := 0;
      If Table = 1 Then
      Begin
        SpY := -StartPow; Kraft := 200;
        Say(Chr(24) + ' VERS LA GLACE ' + Chr(24));
      End
      Else
      Begin
        { l'original (-StartPow div 4 - 49, elan 90) ne franchit pas la
          courbe du haut : le ressort bien tire (60 et plus) la franchit }
        SpY := -StartPow Div 3 - 66; Kraft := 180;
        Say('ATTRAPEZ LE RAT !');
      End;
      StartPow := 0;
    End;
    SetFeder;
  End;
End;

Procedure StartPlunge;
Begin
  If (State <> S_PLAY) Or Not QEmpty Or (Fm <> 12) Or (Balls[Act] >= MaxBalls) Then Exit;
  If Plunge = 0 Then
  Begin
    Plunge := 1; PlungeT := 0; StartPow := 0;
    Say('Lachez pour lancer !');
  End
  Else If Plunge = 1 Then Plunge := 2;
End;

Procedure Nudge;
Begin
  If (State <> S_PLAY) Or Not QEmpty Or Not BallOn Then Exit;
  SpY := SpY - 10;
  SpX := SpX - 6 + Rnd(12);
  Inc(Shakes);
  If Shakes >= 5 Then
  Begin
    QSay('T I L T !', 90);
    Shakes := 0;
    BallLost;
  End
  Else Say(IStr(Shakes) + 'e SECOUSSE !');
End;

{ demonstration : batteurs et ressort automatiques }
Procedure AutoPlay;
Begin
  If (Fm = 12) And (Plunge = 0) And QEmpty And (BallY > 500) Then StartPlunge;
  If (Plunge = 1) And (StartPow >= 62 + Rnd(14)) Then Plunge := 2;
  If (SpY > 0) And (BallY + 16 > ArmYL - 10) And (BallY < ArmYL + 34) Then
  Begin
    If BallX + 8 < 160 Then AutoL := 10 Else AutoR := 10;
  End;
End;

{ un pas de la boucle principale de l'original }
Procedure GameStep;
Var St, Lk, Rk, Fg : LongInt;
Begin
  { touches Maj (etat du clavier, comme l'int 16h de l'original) }
  St := 0;
  If WinQueryActiveWindow(HWND_DESKTOP) = Frame Then
  Begin
    WrW(LongInt(@KInfo), 10);
    If KbdGetStatus(LongInt(@KInfo), 0) = 0 Then St := RdW(LongInt(@KInfo) + 8);
  End;
  Lk := St And 2; Rk := St And 1;
  If TapL > 0 Then Begin Dec(TapL); Lk := 1; End;
  If TapR > 0 Then Begin Dec(TapR); Rk := 1; End;
  If AutoAll <> 0 Then
  Begin
    AutoPlay;
    If AutoL > 0 Then Begin Dec(AutoL); Lk := 1; End;
    If AutoR > 0 Then Begin Dec(AutoR); Rk := 1; End;
  End;
  { Ctrl tenu : ressort }
  If (St And 4) <> 0 Then
  Begin
    If (CtrlWas = 0) And (Plunge = 0) Then StartPlunge;
    CtrlWas := 1;
  End
  Else
  Begin
    If (CtrlWas <> 0) And (Plunge = 1) Then Plunge := 2;
    CtrlWas := 0;
  End;
  If Not QEmpty Then Lk := 0;
  If Not QEmpty Then Rk := 0;
  If Lk <> 0 Then Begin If ArmL < 5 Then Inc(ArmL); End Else If ArmL > 1 Then Dec(ArmL);
  If Rk <> 0 Then Begin If ArmR < 5 Then Inc(ArmR); End Else If ArmR > 1 Then Dec(ArmR);
  If ArmLOld <> ArmL Then DrawArm(False);
  If ArmROld <> ArmR Then DrawArm(True);
  PlungerStep;
  If Not QEmpty Or Not BallOn Then
  Begin
    ArmLOld := ArmL; ArmROld := ArmR;
    Exit;
  End;
  CheckBall;
  If (Fr = ArmCode) Or (Fl = ArmCode) Or (Fu = ArmCode) Or (Fo = ArmCode) Or (Fm = ArmCode) Or (Fh = ArmCode) Then
    AnalyseArms;
  ArmLOld := ArmL; ArmROld := ArmR;
  If BallY < 0 Then BallY := 0;
  If BallY > TH - 16 Then BallY := TH - 16;
  If (BallX <> BxOld) Or (BallY <> ByOld) Then
  Begin
    MoveBall;
    If (Table = 2) And (BallY > 581) Then Fu := 242;
    If (Fr > 0) Or (Fl > 0) Or (Fu > 0) Or (Fo > 0) Then
    Begin
      If Fr > 0 Then Fg := Fr;
      If Fl > 0 Then Fg := Fl;
      If Fo > 0 Then Fg := Fo;
      If Fu > 0 Then Fg := Fu;
      If Table = 1 Then Crash1(Fg) Else Crash2(Fg);
    End;
    If BallOn And QEmpty Then
    Begin
      Fh := TP(BallX + 8, BallY + 8);
      If Fh <> Fm Then
      Begin
        If (Fh > 0) And (Fh < 128) Then
        Begin
          Fm := Fh;
          If Table = 1 Then Boden1 Else Boden2;
        End
        Else If Fh = 0 Then Fm := 0;
      End;
    End;
    If BallOn Then MoveBall;
  End;
  { couleurs qui reviennent }
  If Table = 1 Then
  Begin
    If BumpCount = 1 Then
    Begin
      For Fg := 240 To 248 Do ResetCol(Fg);
      BumpCount := 0;
    End
    Else If BumpCount > 1 Then Dec(BumpCount);
  End
  Else
  Begin
    If Counter = 1 Then
    Begin
      For Fg := 96 To 98 Do ResetCol(Fg);
      For Fg := 116 To 119 Do ResetCol(Fg);
      Counter := 0;
    End
    Else If Counter > 1 Then Dec(Counter);
  End;
End;

{ l'afficheur et la file des messages }
Procedure LedStep;
Var K, X, Y : LongInt;
Begin
  If LedScroll > 0 Then
  Begin
    For K := 1 To 2 Do
    Begin
      For X := 0 To 158 Do For Y := 0 To 11 Do Dots[X, Y] := Dots[X + 1, Y];
      For Y := 0 To 11 Do Dots[159, Y] := 0;
    End;
    Dec(LedScroll);
    LedDirty := 1;
    Exit;
  End;
  If LedTyping <> 0 Then
  Begin
    For K := 1 To 2 Do
      If LedPos < 20 Then
      Begin
        LedChar(LedPos * 8, LedText[LedPos + 1]);
        Inc(LedPos);
      End;
    If LedPos >= 20 Then LedTyping := 0;
    Exit;
  End;
  If LedHold > 0 Then
  Begin
    Dec(LedHold);
    Exit;
  End;
  { element suivant de la file }
  While Not QEmpty Do
  Begin
    K := QHead;
    QHead := (QHead + 1) Mod MaxQ;
    Case QT[K] Of
      Q_MSG :
        Begin
          If QS[K] <> '' Then Say(QS[K]);
          LedHold := QN[K];
          Exit;
        End;
      Q_SCROLL :
        Begin
          LedScroll := 40;
          Exit;
        End;
      Q_ACT :
        Begin
          DoAction(QN[K], QP1[K], QP2[K]);
          If QN[K] = A_FREE Then
          Begin
            LedHold := QP1[K];
            Exit;
          End;
          If QN[K] = A_SETBALL Then
          Begin
            LedHold := 3;
            Exit;
          End;
        End;
    End;
  End;
End;

