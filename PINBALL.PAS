Procedure BmiHeader(A, W, H : LongInt);
Var I : LongInt;
Begin
  For I := 0 To 15 Do WrB(A + I, 0);
  WrL(A, 16); WrL(A + 4, W); WrL(A + 8, H);
  WrW(A + 12, 1); WrW(A + 14, 8);
End;

Procedure PalEntry(A, I, C : LongInt);
Begin
  A := A + 16 + I * 4;
  WrB(A, C And 255); WrB(A + 1, (C Shr 8) And 255); WrB(A + 2, (C Shr 16) And 255);
End;

{ couleur I de la table (la carte de la table la partage) }
Procedure SetCol(I, C : LongInt);
Begin
  CurPal[I] := C;
  PalEntry(LongInt(@Bmi), I, C);
  PalEntry(LongInt(@MapBmi), I, C);
  PalDirty := 1;
End;

{ Set_RGB_color de l'original : composantes du DAC VGA (0 a 63) }
Procedure SetRGB(I, R, G, B : LongInt);
Begin
  SetCol(I, (((R And 63) * 255 Div 63) Shl 16) Or (((G And 63) * 255 Div 63) Shl 8) Or ((B And 63) * 255 Div 63));
End;

{ couleur d'origine de la table }
Function OrgCol(I : LongInt) : LongInt;
Begin
  If Table = 1 Then OrgCol := Pal1[I] Else OrgCol := Pal2[I];
End;

Procedure ResetCol(I : LongInt);
Begin
  SetCol(I, OrgCol(I));
End;

Procedure InitPalette;
Var I : LongInt;
Begin
  For I := 0 To 255 Do SetCol(I, OrgCol(I));
  { reglages de init_colors : gris de la balle }
  If Table = 1 Then
  Begin
    SetRGB($10, 33, 33, 33); SetRGB($11, 35, 35, 35); SetRGB($12, 37, 37, 37); SetRGB($13, 39, 39, 39);
    SetRGB($14, 42, 42, 42); SetRGB($15, 52, 52, 52); SetRGB($19, 33, 33, 33);
  End
  Else
  Begin
    SetRGB(170, 33, 33, 33); SetRGB(171, 35, 35, 35); SetRGB(172, 37, 37, 37); SetRGB(173, 39, 39, 39);
    SetRGB(174, 42, 42, 42); SetRGB(175, 52, 52, 52); SetRGB(176, 33, 33, 33);
  End;
End;

Procedure InitLedBmi;
Begin
  BmiHeader(LongInt(@LedBmi), TW, LedH);
  PalEntry(LongInt(@LedBmi), 0, $100404);
  PalEntry(LongInt(@LedBmi), 1, $3C0E08);
  PalEntry(LongInt(@LedBmi), 2, $FF6A1C);
  PalEntry(LongInt(@LedBmi), 3, $FFC878);
End;

Procedure AddDirty(X1, Y1, X2, Y2 : LongInt);
Begin
  If X1 < 0 Then X1 := 0;
  If Y1 < 0 Then Y1 := 0;
  If X2 > TW - 1 Then X2 := TW - 1;
  If Y2 > TH - 1 Then Y2 := TH - 1;
  If (X2 < X1) Or (Y2 < Y1) Then Exit;
  If NDirty >= MaxDirty Then
  Begin
    PalDirty := 1;
    Exit;
  End;
  DX1[NDirty] := X1; DY1[NDirty] := Y1; DX2[NDirty] := X2; DY2[NDirty] := Y2;
  Inc(NDirty);
End;

{ recopier le fond (Back) dans l'image (Fb) }
Procedure Restore(X1, Y1, X2, Y2 : LongInt);
Var Y, B : LongInt;
Begin
  If X1 < 0 Then X1 := 0;
  If Y1 < 0 Then Y1 := 0;
  If X2 > TW - 1 Then X2 := TW - 1;
  If Y2 > TH - 1 Then Y2 := TH - 1;
  If (X2 < X1) Or (Y2 < Y1) Then Exit;
  For Y := Y1 To Y2 Do
  Begin
    B := (TH - 1 - Y) * TW + X1;
    Move(Back[B], Fb[B], X2 - X1 + 1);
  End;
  AddDirty(X1, Y1, X2, Y2);
End;

Function BackAt(X, Y : LongInt) : LongInt;
Begin
  BackAt := Back[(TH - 1 - Y) * TW + X];
End;

Procedure SetBack(X, Y, C : LongInt);
Begin
  If (X >= 0) And (X < TW) And (Y >= 0) And (Y < TH) Then Back[(TH - 1 - Y) * TW + X] := C;
End;

{ pixel du masque (gettablepixel) ; hors de la table : le cadre }
Function TP(X, Y : LongInt) : LongInt;
Begin
  If (X < 0) Or (X >= TW) Or (Y < 0) Or (Y >= TH) Then TP := 255
  Else TP := Gro[Y * TW + X];
End;

{ balle : melee au fond, sauf sur les couleurs de premier plan (au-dela
  de MaxFarbe : la balle passe dessous) }
Procedure DrawBall;
Var X, Y, V, B, Bk : LongInt;
Begin
  If Not BallOn Then Exit;
  For Y := 0 To 15 Do
    If (BallY + Y >= 0) And (BallY + Y < TH) Then
      For X := 0 To 15 Do
        If (BallX + X >= 0) And (BallX + X < TW) Then
        Begin
          V := Blob[DBall + Y * 16 + X];
          B := (TH - 1 - (BallY + Y)) * TW + BallX + X;
          Bk := Back[B];
          If (V <> 0) And (Bk <= MaxFarbe) Then Fb[B] := V Else Fb[B] := Bk;
        End;
  AddDirty(BallX, BallY, BallX + 15, BallY + 15);
End;

Procedure MoveBall;
Begin
  Restore(BxOld, ByOld, BxOld + 15, ByOld + 15);
  DrawBall;
  BxOld := BallX; ByOld := BallY;
End;

{ bras : image et masque de la position S (1 baisse a 5 leve) }
Procedure DrawArm(Right : Boolean);
Var X, Y, X0, Y0, S, D, V : LongInt;
Begin
  If Right Then Begin X0 := ArmXR; Y0 := ArmYR + 1; S := ArmR; D := DArmR; End
  Else Begin X0 := ArmXL; Y0 := ArmYL + 1; S := ArmL; D := DArmL; End;
  For Y := 0 To ArmHt - 1 Do
    For X := 0 To ArmW - 1 Do
    Begin
      V := Blob[D + (S - 1) * ArmW * ArmHt + Y * ArmW + X];
      SetBack(X0 + X, Y0 + Y, V);
      If Right Then V := Blob[D_MSKR + (S - 1) * ArmW * ArmHt + Y * ArmW + X]
      Else V := Blob[D_MSKL + (S - 1) * ArmW * ArmHt + Y * ArmW + X];
      If (X0 + X < TW) And (Y0 + Y < TH) Then Gro[(Y0 + Y) * TW + X0 + X] := V;
    End;
  Restore(X0, Y0, X0 + ArmW - 1, Y0 + ArmHt - 1);
  If (BallX + 16 > X0) And (BallX < X0 + ArmW) And (BallY + 16 > Y0) And (BallY < Y0 + ArmHt) Then DrawBall;
End;

{ ressort (Set_Feder) : FederY est en lignes d'ecran de l'original (+48) }
Procedure SetFeder;
Var X, Y, Z : LongInt;
Begin
  For Y := 605 To 605 + StartPow Div 5 Do
    For X := FederX To FederX + FederW - 1 Do SetBack(X, Y - 48, 0);
  Z := 0;
  For Y := FederY To FederY + FederH Do
    For X := FederX To FederX + FederW - 1 Do
    Begin
      If Z < 480 Then SetBack(X, Y - 48, Blob[DFeder + Z]);
      Inc(Z);
    End;
  Restore(FederX, 557, FederX + FederW - 1, TH - 1);
  If BallX + 16 > FederX - 2 Then DrawBall;
End;

