Procedure LedClear;
Begin
  FillChar(Dots, SizeOf(Dots), 0);
  LedDirty := 1;
End;

{ caractere C de la police de la table, colonne Col de l'afficheur }
Procedure LedChar(Col : LongInt; C : Char);
Var I, J, B : LongInt;
Begin
  For J := 0 To 7 Do
    For I := 0 To 7 Do
      If Col + J < 160 Then
      Begin
        B := Blob[DFont + Ord(C) * 16 + I];
        If (B And ($80 Shr J)) <> 0 Then Dots[Col + J, I + 2] := 1 Else Dots[Col + J, I + 2] := 0;
      End;
  LedDirty := 1;
End;

{ display de l'original : texte centre sur 20 caracteres }
Function Center(T : String) : String;
Var Z : String;
Begin
  Z := '                    ';
  If Length(T) > 20 Then T := Copy(T, 1, 20);
  Z := Copy(Z, 1, 10 - Length(T) Div 2) + T;
  While Length(Z) < 20 Do Z := Z + ' ';
  Center := Copy(Z, 1, 20);
End;

{ message immediat (sans arreter la balle) }
Procedure Say(T : String);
Var C : String;
Begin
  C := Center(T);
  If (C = LedText) And (LedScroll = 0) Then Exit;
  LedText := C; LedPos := 0; LedTyping := 1; LedScroll := 0;
End;

Function QEmpty : Boolean;
Begin
  QEmpty := QHead = QTail;
End;

Procedure QAdd(T, N, P1, P2 : LongInt; S : String);
Var K : LongInt;
Begin
  K := (QTail + 1) Mod MaxQ;
  If K = QHead Then Exit;
  QT[QTail] := T; QN[QTail] := N; QP1[QTail] := P1; QP2[QTail] := P2; QS[QTail] := S;
  QTail := K;
End;

{ message bloquant : la balle attend, le message reste Hold pas }
Procedure QSay(T : String; Hold : LongInt);
Begin
  QAdd(Q_MSG, Hold, 0, 0, T);
End;

Procedure QScroll;
Begin
  QAdd(Q_SCROLL, 0, 0, 0, '');
End;

Procedure QAct(A, P1, P2 : LongInt);
Begin
  QAdd(Q_ACT, A, P1, P2, '');
End;

Procedure RenderLed;
Var X, Y, C, Px, Py : LongInt;
Begin
  For Y := 0 To 11 Do
    For X := 0 To 159 Do
    Begin
      Px := X * 2; Py := Y * 2;
      If Dots[X, Y] <> 0 Then C := 2 Else C := 1;
      LedB[(LedH - 1 - Py) * TW + Px] := C;
      LedB[(LedH - 1 - Py) * TW + Px + 1] := 0;
      LedB[(LedH - 2 - Py) * TW + Px] := 0;
      LedB[(LedH - 2 - Py) * TW + Px + 1] := 0;
      If C = 2 Then
      Begin
        LedB[(LedH - 1 - Py) * TW + Px] := 3;
        LedB[(LedH - 1 - Py) * TW + Px + 1] := 2;
        LedB[(LedH - 2 - Py) * TW + Px] := 2;
      End;
    End;
End;

